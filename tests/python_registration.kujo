# Operator-installed owner extension validation. No parser, verifier or replay policy.
export func python_registration(ids, transaction) {
    return {"namespace":"kujolang.python-process","participant_schema":"kujolang.python-process-correlation/v1alpha1","effect_schema":"workcell.git-correlation/v1alpha1","validate":func(doc,result) {
        p := doc["participant_extension"]["values"]
        e := doc["effect_extension"]["values"]
        c := result["participant_correlation"]
        if len(keys(p)) != 2||len(keys(e)) != 2 {return false}
        for key in ["call_id","process_instance_id"] {
            if has_key(p,key) == false||p[key] != ids[key]||c[key] != ids[key] {return false}
        }
        if c["invocation_id"] != ids["invocation_id"]||c["completion_knowledge"] != doc["completion_knowledge"] {return false}
        if e["workcell_effect_id"] != "workcell-logical-git-1"||e["transaction_sha256"] != transaction {return false}
        return true
    }}
}
