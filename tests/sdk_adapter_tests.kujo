test_setup {
	from sdk_adapter import parse_json_from_output, build_bridge_parse_error_details, build_bridge_exec_error_message, build_bridge_spawn_command, resolve_bridge_timeout_ms, build_bridge_payload, call_agent_model, custom_provider_api_key_env_allowed
}

test "custom providers cannot select arbitrary process secret variables" {
	assert_true(custom_provider_api_key_env_allowed("CUSTOM_API_KEY"))
	assert_false(custom_provider_api_key_env_allowed("PATH"))
	agent := {"model": {"provider": "custom", "model": "example", "base_url": "https://example.invalid/v1", "api_key_env": "PATH"}}
	result := call_agent_model(agent, "test", {"offline_fixture": false, "timeout_ms": 1})
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "credential_env_not_allowed")
}

test "parse json from output supports trailing json line" {
	parsed := parse_json_from_output("log line\n{\"ok\":true,\"value\":42}")
	assert_true(parsed["ok"])
	assert_equal(parsed["data"]["ok"], true)
	assert_equal(parsed["data"]["value"], 42)
}

test "parse error details are redacted by default" {
	details := build_bridge_parse_error_details({
		"stdout": "token=secret-output",
		"stderr": "apikey=secret-error"
	}, {})
	assert_equal(details["stdout_redacted"], true)
	assert_equal(details["stderr_redacted"], true)
	assert_true(details["stdout_bytes"] > 0)
	assert_true(details["stderr_bytes"] > 0)
	assert_equal(has_key(details, "stdout"), 0)
	assert_equal(has_key(details, "stderr"), 0)
}

test "parse error details include raw output when debug enabled" {
	details := build_bridge_parse_error_details({
		"stdout": "hello",
		"stderr": "world"
	}, {
		"debug_bridge_output": true
	})
	assert_equal(details["debug_bridge_output"], true)
	assert_equal(details["stdout"], "hello")
	assert_equal(details["stderr"], "world")
}

test "execution error message redacts stderr by default" {
	message := build_bridge_exec_error_message({
		"stderr": "token=secret-error"
	}, {})
	assert_equal(contains(message, "secret-error"), 0)
	assert_equal(contains(message, "redacted by default"), 1)
	assert_equal(contains(message, "bytes"), 1)
}

test "execution error message includes stderr when debug enabled" {
	message := build_bridge_exec_error_message({
		"stderr": "bridge failed"
	}, {
		"debug_bridge_output": true
	})
	assert_equal(contains(message, "bridge failed"), 1)
}

test "bridge spawn command is direct argv without shell wrapper" {
	cmd := build_bridge_spawn_command({
		"ai_sdk_path": "/tmp/ai-sdk",
		"kujo_bin": "/usr/local/bin/kujo",
		"bridge_script": "/tmp/bridge_chat.kujo"
	})
	assert_equal(cmd[0], "/usr/bin/env")
	assert_equal(cmd[1], "-C")
	assert_equal(cmd[2], "/tmp/ai-sdk")
	assert_equal(cmd[3], "/usr/local/bin/kujo")
	assert_equal(cmd[4], "run")
	assert_equal(cmd[5], "/tmp/bridge_chat.kujo")
	assert_equal(cmd[6], "--interpreter")
}

test "bridge timeout is configurable with a safe default" {
	assert_equal(resolve_bridge_timeout_ms({"timeout_ms": 1000}), 1000)
	assert_equal(resolve_bridge_timeout_ms({"timeout_ms": "abc"}), 240000)
	assert_equal(resolve_bridge_timeout_ms({"timeout_ms": 0}), 240000)
	assert_equal(resolve_bridge_timeout_ms({}), 240000)
}

test "bridge payload carries route provenance and structured output policy" {
	payload := build_bridge_payload({
		"instructions": "Return JSON.",
		"model": {"provider": "fixture", "model": "frontier"},
		"output_schema": {"type": "dict", "required": ["summary"]},
		"__route_decision": {
			"decision_id": "route-123",
			"policy_version": "1.0.0",
			"catalog_id": "catalog",
			"catalog_version": "7",
			"catalog_hash": "abc",
			"constraints": {"requires_structured_output": true}
		}
	}, "topic", {"offline_fixture": true})
	assert_equal(payload["route"]["decision_id"], "route-123")
	assert_equal(payload["route"]["catalog_version"], "7")
	assert_equal(payload["response_format"]["type"], "json_object")
	assert_equal(payload["structured_output_schema"]["required"][0], "summary")
	assert_false(payload["structured_output_retryable"])
	overridden := build_bridge_payload({"instructions": "", "model": {}}, "topic", {
		"offline_fixture": true,
		"response_format": {"type": "json_object"},
		"structured_output_schema": {"type": "dict"},
		"structured_output_retryable": true
	})
	assert_true(overridden["structured_output_retryable"])
}

test "offline fixture model calls return in process without bridge execution" {
	result := call_agent_model({
		"model": {
			"provider": "openai",
			"model": "gpt-4.1-mini"
		}
	}, "Summarize fixture mode", {
		"offline_fixture": true
	})
	assert_true(result["ok"])
	assert_equal(result["provider"], "openai")
	assert_equal(result["model"], "gpt-4.1-mini")
	assert_equal(result["status_code"], 200)
	assert_equal(result["raw"]["fixture"], true)
	assert_true(contains(result["output_text"], "Summarize fixture mode") == 1)
}
