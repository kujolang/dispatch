# Stress test — runs 1000 simple tests to verify scalability.

test_setup {
	from src.eval_core import run_suite
	from src.common import dict_get_or
}

test "stress: 1000 file_exists checks under 15 seconds" {
	many_tests := "["
	ti := 0
	while ti < 1000 {
		if ti > 0 { many_tests = many_tests + "," }
		many_tests = many_tests + "{\"name\":\"t" + to_string(ti) + "\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}"
		ti := ti + 1
	}
	many_tests = many_tests + "]"
	config := "{\"name\":\"stress-suite\",\"tests\":" + many_tests + "}"

	try { write_file(".eval_stress_test.json", config) } except err {}

	start := time()
	results := run_suite(".eval_stress_test.json", {"quiet": true})
	elapsed := time() - start

	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 1000)
	assert_equal(dict_get_or(data, "passed", 0), 1000)
	assert_true(elapsed < 15000)

	print("Stress test: 1000 tests in " + to_string(elapsed) + "ms")

	try { remove_file(".eval_stress_test.json") } except err {}
}

test "stress: parallel file fastpath preserves results and improves timing" {
	payload := ""
	pi := 0
	while pi < 20000 {
		payload = payload + "alpha beta gamma needle-marker delta\n"
		pi := pi + 1
	}
	try { write_file(".eval_parallel_payload.txt", payload) } except err {}

	many_tests := "["
	ti := 0
	while ti < 900 {
		if ti > 0 { many_tests = many_tests + "," }
		many_tests = many_tests + "{\"name\":\"p" + to_string(ti) + "\",\"check\":\"file_contains\",\"params\":{\"path\":\".eval_parallel_payload.txt\",\"expected\":\"needle-marker\"}}"
		ti := ti + 1
	}
	many_tests = many_tests + "]"
	config := "{\"name\":\"parallel-file-stress\",\"tests\":" + many_tests + "}"
	try { write_file(".eval_parallel_stress_test.json", config) } except err {}

	serial_start := time()
	serial_results := run_suite(".eval_parallel_stress_test.json", {"quiet": true, "parallel_workers": 1})
	serial_elapsed := time() - serial_start

	parallel_start := time()
	parallel_results := run_suite(".eval_parallel_stress_test.json", {"quiet": true, "parallel_workers": 8})
	parallel_elapsed := time() - parallel_start

	assert_true(serial_results["ok"])
	assert_true(parallel_results["ok"])

	serial_data := dict_get_or(serial_results, "data", {})
	parallel_data := dict_get_or(parallel_results, "data", {})

	assert_equal(dict_get_or(serial_data, "total", 0), 900)
	assert_equal(dict_get_or(parallel_data, "total", 0), 900)
	assert_equal(dict_get_or(serial_data, "passed", 0), dict_get_or(parallel_data, "passed", 0))
	assert_equal(dict_get_or(serial_data, "failed", 0), dict_get_or(parallel_data, "failed", 0))

	assert_equal(dict_get_or(parallel_data, "parallel_requested", false), true)
	assert_equal(dict_get_or(parallel_data, "parallel_used", false), true)
	assert_equal(dict_get_or(parallel_data, "parallel_mode", ""), "file-fastpath")
	assert_equal(dict_get_or(parallel_data, "parallel_workers", 0), 8)

	serial_entries := dict_get_or(serial_data, "test_results", [])
	parallel_entries := dict_get_or(parallel_data, "test_results", [])
	assert_equal(len(serial_entries), len(parallel_entries))

	ei := 0
	while ei < len(serial_entries) {
		assert_equal(dict_get_or(serial_entries[ei], "name", ""), dict_get_or(parallel_entries[ei], "name", ""))
		assert_equal(dict_get_or(serial_entries[ei], "passed", false), dict_get_or(parallel_entries[ei], "passed", true))
		ei := ei + 1
	}

	assert_true(parallel_elapsed < serial_elapsed)
	print("Parallel fastpath timing: serial=" + to_string(serial_elapsed) + "ms parallel=" + to_string(parallel_elapsed) + "ms")

	try { remove_file(".eval_parallel_stress_test.json") } except err {}
	try { remove_file(".eval_parallel_payload.txt") } except err {}
}

test "stress: parallel file fastpath supports line-count glob and regex checks" {
	payload := ""
	pi := 0
	while pi < 4000 {
		payload = payload + "alpha beta gamma needle-marker delta\n"
		pi := pi + 1
	}
	try { write_file(".eval_parallel_extended_payload.txt", payload) } except err {}

	many_tests := "["
	ti := 0
	while ti < 150 {
		if ti > 0 { many_tests = many_tests + "," }
		many_tests = many_tests + "{\"name\":\"lc" + to_string(ti) + "\",\"check\":\"file_line_count\",\"params\":{\"path\":\".eval_parallel_extended_payload.txt\",\"expected\":3000,\"comparison\":\"gt\"}}"
		ti := ti + 1
	}
	ti = 0
	while ti < 150 {
		many_tests = many_tests + ","
		many_tests = many_tests + "{\"name\":\"gl" + to_string(ti) + "\",\"check\":\"file_matches_glob\",\"params\":{\"path\":\".eval_parallel_extended_payload.txt\",\"pattern\":\"*needle-marker*\"}}"
		ti := ti + 1
	}
	ti = 0
	while ti < 150 {
		many_tests = many_tests + ","
		many_tests = many_tests + "{\"name\":\"rg" + to_string(ti) + "\",\"check\":\"file_matches_regex\",\"params\":{\"path\":\".eval_parallel_extended_payload.txt\",\"pattern\":\"needle-marker\"}}"
		ti := ti + 1
	}
	many_tests = many_tests + "]"

	config := "{\"name\":\"parallel-file-fastpath-extended\",\"tests\":" + many_tests + "}"
	try { write_file(".eval_parallel_extended_stress_test.json", config) } except err {}

	serial_results := run_suite(".eval_parallel_extended_stress_test.json", {"quiet": true, "parallel_workers": 1})
	parallel_results := run_suite(".eval_parallel_extended_stress_test.json", {"quiet": true, "parallel_workers": 8})

	assert_true(serial_results["ok"])
	assert_true(parallel_results["ok"])

	serial_data := dict_get_or(serial_results, "data", {})
	parallel_data := dict_get_or(parallel_results, "data", {})

	assert_equal(dict_get_or(serial_data, "total", 0), 450)
	assert_equal(dict_get_or(parallel_data, "total", 0), 450)
	assert_equal(dict_get_or(serial_data, "failed", 0), dict_get_or(parallel_data, "failed", 0))
	assert_equal(dict_get_or(serial_data, "passed", 0), dict_get_or(parallel_data, "passed", 0))

	assert_true(dict_get_or(parallel_data, "parallel_requested", false))
	assert_true(dict_get_or(parallel_data, "parallel_used", false))
	assert_equal(dict_get_or(parallel_data, "parallel_mode", ""), "file-fastpath")
	assert_true(dict_get_or(parallel_data, "cache_metric_hits", 0) > 0)

	try { remove_file(".eval_parallel_extended_stress_test.json") } except err {}
	try { remove_file(".eval_parallel_extended_payload.txt") } except err {}
}

test "stress: large mixed fixture has stable accounting" {
	results := run_suite("examples/large_suite_fixture.json", {"quiet": true})
	data := dict_get_or(results, "data", {})

	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 8)
	assert_equal(dict_get_or(data, "passed", 0), 5)
	assert_equal(dict_get_or(data, "failed", 0), 1)
	assert_equal(dict_get_or(data, "skipped", 0), 2)
}

test "stress: mixed fixture parallel heuristic keeps outcomes stable" {
	serial_results := run_suite("examples/large_suite_fixture.json", {"quiet": true, "parallel_workers": 1})
	parallel_results := run_suite("examples/large_suite_fixture.json", {"quiet": true, "parallel_workers": 8})

	assert_true(serial_results["ok"])
	assert_true(parallel_results["ok"])

	serial_data := dict_get_or(serial_results, "data", {})
	parallel_data := dict_get_or(parallel_results, "data", {})

	assert_equal(dict_get_or(serial_data, "passed", 0), dict_get_or(parallel_data, "passed", 0))
	assert_equal(dict_get_or(serial_data, "failed", 0), dict_get_or(parallel_data, "failed", 0))
	assert_equal(dict_get_or(serial_data, "skipped", 0), dict_get_or(parallel_data, "skipped", 0))
	assert_true(dict_get_or(parallel_data, "parallel_requested", false))
	assert_true(dict_get_or(parallel_data, "parallel_used", false))

	parallel_mode := dict_get_or(parallel_data, "parallel_mode", "")
	assert_true(parallel_mode == "mixed-heuristic" || parallel_mode == "mixed-priority-heuristic")
}

test "stress: enterprise quickstart bundles execute successfully" {
	bundles := [
		"examples/enterprise_cli_quality_gate.json",
		"examples/enterprise_api_contract_gate.json",
		"examples/enterprise_agent_output_gate.json",
		"examples/strict_enterprise_policy_gate.json",
		"examples/sandbox_adjacent_policy_gate.json"
	]

	i := 0
	while i < len(bundles) {
		bundle_path := bundles[i]
		bundle_results := run_suite(bundle_path, {"quiet": true, "parallel_workers": 8})
		bundle_data := dict_get_or(bundle_results, "data", {})

		assert_true(bundle_results["ok"])
		assert_equal(dict_get_or(bundle_data, "failed", 0), 0)
		assert_true(dict_get_or(bundle_data, "total", 0) > 0)

		i := i + 1
	}
}
