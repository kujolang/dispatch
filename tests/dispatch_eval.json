{
  "name": "dispatch-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "Dispatch version command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run dispatch.kujo version"
      }
    },
    {
      "name": "Dispatch templates JSON succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run dispatch.kujo templates --json"
      }
    },
    {
      "name": "Dispatch offline fixture demo succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "DISPATCH_OFFLINE_FIXTURE=true kujo run dispatch.kujo demo \"Dispatch fixture smoke\" --yes --non-interactive --decision approve --output-root tests/tmp/dispatch-fixture-smoke"
      }
    },
    {
      "name": "Dispatch manifest metadata exists",
      "check": "file_exists",
      "params": {
        "path": "kennel.toml"
      }
    }
  ]
}
