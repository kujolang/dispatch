# Quality test suite — fuzz, property-based, and pipeline integration tests.

test_setup {
	from src.common import dict_get_or, normalize_string, normalize_int, normalize_bool, normalize_array, normalize_dict
	from src.config import validate_config
	from src.eval_core import run_suite
}

# ===========================================================================
# P4.1: Fuzz tests for config parser
# ===========================================================================

test "fuzz: validate_config handles empty dict" {
	result := validate_config({})
	assert_false(result["ok"])
}

test "fuzz: validate_config handles null-like values" {
	result := validate_config({"name": "", "tests": []})
	assert_false(result["ok"])
}

test "fuzz: validate_config handles deeply nested but valid config" {
	cfg := {
		"name": "deep",
		"tests": [
			{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}},
			{"name": "t2", "check": "command_succeeds", "params": {"command": "echo hi"}},
			{"name": "t3", "check": "output_contains", "params": {"command": "echo hello", "expected": "hello"}},
			{"name": "t4", "check": "file_contains", "params": {"path": "kennel.toml", "expected": "package"}},
			{"name": "t5", "check": "json_matches_shape", "params": {"path": "kennel.toml", "required_keys": ["package"]}}
		]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "fuzz: validate_config handles config with extra unknown fields" {
	cfg := {
		"name": "unknown-fields",
		"random_field": 42,
		"another": [1, 2, 3],
		"tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}}]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "fuzz: validate_config handles test with extra unknown fields" {
	cfg := {
		"name": "extra-test-fields",
		"tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}, "custom_field": "ignored", "another_field": 99}]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

# ===========================================================================
# P4.4: Property-based tests for normalize_* utilities
# ===========================================================================

test "property: normalize_string always returns string" {
	assert_equal(type(normalize_string("hello", "fb")), "string")
	assert_equal(type(normalize_string(42, "fb")), "string")
	assert_equal(type(normalize_string(true, "fb")), "string")
	assert_equal(type(normalize_string([], "fb")), "string")
	assert_equal(type(normalize_string({}, "fb")), "string")
	assert_equal(type(normalize_string("", "fb")), "string")
}

test "property: normalize_int always returns int" {
	assert_equal(type(normalize_int(42, 0)), "int")
	assert_equal(type(normalize_int(0, 10)), "int")
	assert_equal(type(normalize_int(-5, 0)), "int")
	assert_equal(type(normalize_int("hello", 0)), "int")
	assert_equal(type(normalize_int(true, 0)), "int")
	assert_equal(type(normalize_int([], 0)), "int")
}

test "property: normalize_bool always returns bool" {
	assert_equal(type(normalize_bool(true, false)), "bool")
	assert_equal(type(normalize_bool(false, true)), "bool")
	assert_equal(type(normalize_bool("true", false)), "bool")
	assert_equal(type(normalize_bool(1, false)), "bool")
	assert_equal(type(normalize_bool([], false)), "bool")
}

test "property: normalize_array always returns array" {
	assert_equal(type(normalize_array([1, 2])), "array")
	assert_equal(type(normalize_array("not array")), "array")
	assert_equal(type(normalize_array(42)), "array")
	assert_equal(type(normalize_array(true)), "array")
	assert_equal(type(normalize_array({})), "array")
}

test "property: normalize_dict always returns dict" {
	assert_equal(type(normalize_dict({"a": 1})), "dict")
	assert_equal(type(normalize_dict("not dict")), "dict")
	assert_equal(type(normalize_dict(42)), "dict")
	assert_equal(type(normalize_dict(true)), "dict")
	assert_equal(type(normalize_dict([1, 2])), "dict")
}

test "property: dict_get_or handles all input types" {
	assert_equal(dict_get_or("not dict", "key", 42), 42)
	assert_equal(dict_get_or(123, "key", 42), 42)
	assert_equal(dict_get_or(true, "key", 42), 42)
	assert_equal(dict_get_or([], "key", 42), 42)
	assert_equal(dict_get_or({"a": 1}, "b", 99), 99)
	assert_equal(dict_get_or({"a": 1}, "a", 99), 1)
}

# ===========================================================================
# P4.2: Cross-module pipeline integration test
# ===========================================================================

test "integration: full init→run→report pipeline does not crash" {
	try { write_file(".eval_integ_test.json", "{\"name\":\"integ\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}") } except err {}

	results := run_suite(".eval_integ_test.json", {"quiet": true})
	assert_true(results["ok"])
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "total", 0), 1)

	from src.report import generate_markdown_report, generate_html_report, generate_junit_report, generate_tap_report
	rd := dict_get_or(results, "data", results)
	md := generate_markdown_report(rd)
	html := generate_html_report(rd)
	junit := generate_junit_report(rd)
	tap := generate_tap_report(rd)

	assert_true(len(md) > 0)
	assert_true(len(html) > 0)
	assert_true(len(junit) > 0)
	assert_true(len(tap) > 0)

	try { remove_file(".eval_integ_test.json") } except err {}
}
