# CLI integration tests for Kujo Eval.
#
# Tests each CLI subcommand end-to-end.

test_setup {
	from src.eval_core import run_suite, compare_runs, contract_version
	from src.config import init_config, load_config, validate_config, KNOWN_CHECKS
	from src.checks import run_shell
	from src.report import save_report, save_report_with_options
	from main import describe_module
}

func resolve_kujo_bin() {
	override := trim(env("KUJO_BIN"))
	if override != "" {
		return override
	}
	return "./kujo"
}

KUJO_BIN := resolve_kujo_bin()

# ===========================================================================
# init command
# ===========================================================================

test "init_config creates eval.json with correct structure" {
	result := init_config("cli-test-suite", "./eval_results", "./snapshots", "basic")
	assert_true(result["ok"])
	assert_true(path_exists("eval.json") == true)

	raw := read_file("eval.json")
	cfg := parse_json(raw)
	assert_equal(cfg["name"], "cli-test-suite")
	assert_true(type(cfg["tests"]) == "array")
	assert_true(len(cfg["tests"]) >= 1)

	try { remove_file("eval.json") } except err {}
}

test "CLI init supports --from-scout import alias" {
	try {
		write_file(".eval_scout_import.json", "[{\"name\":\"scout-t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo init --name scout-import-suite --from-scout .eval_scout_import.json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)
	assert_true(path_exists("eval.json") == true)

	raw := read_file("eval.json")
	cfg := parse_json(raw)
	assert_equal(cfg["name"], "scout-import-suite")
	assert_true(type(cfg["tests"]) == "array")
	assert_equal(len(cfg["tests"]), 1)

	try { remove_file(".eval_scout_import.json") } except err {}
	try { remove_file("eval.json") } except err {}
}

# ===========================================================================
# run command (via run_suite)
# ===========================================================================

test "run_suite executes all tests in valid config" {
	try {
		write_file(".eval_test_cli.json", "{\"name\":\"cli-suite\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}},{\"name\":\"t2\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo hi\"}}]}")
	} except err {}

	results := run_suite(".eval_test_cli.json", {})
	assert_true(results["ok"])
	results_data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(results_data, "total", 0), 2)
	assert_equal(dict_get_or(results_data, "passed", 0), 2)
	assert_equal(dict_get_or(results_data, "failed", 0), 0)

	try { remove_file(".eval_test_cli.json") } except err {}
}

test "run_suite returns error for missing config" {
	results := run_suite("./nonexistent_cli_config.json", {})
	assert_false(results["ok"])
	assert_true(len(results["error"]) > 0)
}

test "save_report defaults to incremental mode with section-aware cache" {
	output_dir := ".eval_incremental_report_out"
	results_base := {
		"data": {
			"suite_name": "incremental-suite",
			"suite_version": "1.0.0",
			"suite_description": "incremental coverage",
			"passed": 1,
			"failed": 0,
			"skipped": 0,
			"duration_ms": 10,
			"test_results": [
				{"name": "ok", "check": "file_exists", "passed": true, "message": "File exists", "details": {"path": "kennel.toml", "exists": true}}
			]
		}
	}

	first := save_report(results_base, output_dir, "eval-report", "md")
	assert_true(first["ok"])
	first_data := dict_get_or(first, "data", {})
	assert_true(dict_get_or(first_data, "incremental_mode", false))
	assert_true(dict_get_or(first_data, "written", false))

	second := save_report(results_base, output_dir, "eval-report", "md")
	assert_true(second["ok"])
	second_data := dict_get_or(second, "data", {})
	assert_true(dict_get_or(second_data, "cached", false))
	assert_true(dict_get_or(second_data, "incremental_cache_hit", false))

	results_changed := {
		"data": {
			"suite_name": "incremental-suite",
			"suite_version": "1.0.0",
			"suite_description": "incremental coverage",
			"passed": 1,
			"failed": 0,
			"skipped": 0,
			"duration_ms": 42,
			"test_results": [
				{"name": "ok", "check": "file_exists", "passed": true, "message": "File exists", "details": {"path": "kennel.toml", "exists": true}}
			]
		}
	}

	third := save_report_with_options(results_changed, output_dir, "eval-report", "md", {"incremental_mode": true})
	assert_true(third["ok"])
	third_data := dict_get_or(third, "data", {})
	assert_false(dict_get_or(third_data, "cached", false))

	changed_sections := dict_get_or(third_data, "changed_sections", [])
	unchanged_sections := dict_get_or(third_data, "unchanged_sections", [])

	found_summary_changed := false
	i := 0
	while i < len(changed_sections) {
		if changed_sections[i] == "summary" {
			found_summary_changed = true
		}
		i := i + 1
	}
	assert_true(found_summary_changed)

	found_test_results_unchanged := false
	ui := 0
	while ui < len(unchanged_sections) {
		if unchanged_sections[ui] == "test_results" {
			found_test_results_unchanged = true
		}
		ui := ui + 1
	}
	assert_true(found_test_results_unchanged)

	try {
		remove_file(output_dir + "/eval-report.md")
		remove_file(output_dir + "/eval-report.md.cache.json")
		remove_file(output_dir + "/eval-report.md.bak")
		remove_file(output_dir)
	} except err {}
}

# ===========================================================================
# compare command
# ===========================================================================

test "compare_runs detects no change between identical runs" {
	run_a := {"suite_name": "A", "passed": 10, "failed": 0, "total": 10}
	run_b := {"suite_name": "B", "passed": 10, "failed": 0, "total": 10}

	result := compare_runs(run_a, run_b)
	cmp_data := dict_get_or(result, "data", {})
	assert_false(dict_get_or(cmp_data, "regression", true))
	assert_false(dict_get_or(cmp_data, "improvement", true))
}

test "compare_runs detects regression" {
	run_a := {"suite_name": "A", "passed": 8, "failed": 2, "total": 10}
	run_b := {"suite_name": "B", "passed": 6, "failed": 4, "total": 10}

	result := compare_runs(run_a, run_b)
	cmp_data := dict_get_or(result, "data", {})
	assert_true(dict_get_or(cmp_data, "regression", false))
}

