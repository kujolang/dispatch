}

test "CLI lint returns structured diagnostics with actionable hints" {
	try {
		write_file(".eval_lint_bad_suite.json", "{\"name\":\"lint-bad-suite\",\"tests\":[{\"name\":\"bad-check\",\"check\":\"not_a_check\",\"params\":{}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo lint .eval_lint_bad_suite.json --json")
	assert_true(result["ok"])
	assert_true(result["exit_code"] != 0)

	payload := parse_json(result["stdout"])
	assert_false(dict_get_or(payload, "ok", true))
	data := dict_get_or(payload, "data", {})
	diagnostics := dict_get_or(data, "diagnostics", [])
	assert_true(type(diagnostics) == "array")
	assert_true(len(diagnostics) > 0)

	first_diag := diagnostics[0]
	assert_true(type(first_diag) == "dict")
	assert_true(len(dict_get_or(first_diag, "code", "")) > 0)
	assert_true(len(dict_get_or(first_diag, "suggested_fix", "")) > 0)

	try {
		remove_file(".eval_lint_bad_suite.json")
	} except err {}
}

test "CLI run --json returns stable envelope on failure" {
	result := run_shell(KUJO_BIN + " run main.kujo run ./.missing_json_shape_suite.json --json")
	assert_true(result["ok"])
	assert_true(result["exit_code"] != 0)

	payload := parse_json(result["stdout"])
	assert_equal(has_key(payload, "ok"), 1)
	assert_equal(has_key(payload, "error"), 1)
	assert_equal(has_key(payload, "data"), 1)
	assert_false(payload["ok"])
}

test "CLI watch exits non-zero when config file is missing" {
	result := run_shell(KUJO_BIN + " run main.kujo watch --config ./.missing_watch_config.json --poll-ms 0 --max-loops 1")
	assert_true(result["ok"])
	assert_true(result["exit_code"] != 0)
}

