	try { remove_file(".eval_watch_suite.json") } except err {}
}

test "Interpreter entrypoint matrix covers all public subcommands" {
	try {
		write_file(".eval_entrypoint_suite.json", "{\"name\":\"entrypoint-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
		write_file(".eval_compare_a.json", "{\"passed\":1,\"failed\":0,\"total\":1}")
		write_file(".eval_compare_b.json", "{\"passed\":1,\"failed\":0,\"total\":1}")
		write_file(".eval_diff_a.txt", "same")
		write_file(".eval_diff_b.txt", "same")
		create_dir(".eval_snapshots_dir")
	} except err {}

	commands := [
		{"name": "init", "cmd": KUJO_BIN + " run main.kujo init --name entrypoint-suite", "exit": 0},
		{"name": "run", "cmd": KUJO_BIN + " run main.kujo run .eval_entrypoint_suite.json --output-dir .eval_entrypoint_out --artifact-checksums --json", "exit": 0},
		{"name": "report", "cmd": KUJO_BIN + " run main.kujo report .eval_entrypoint_suite.json --rerun --json", "exit": 0},
		{"name": "compare", "cmd": KUJO_BIN + " run main.kujo compare .eval_compare_a.json .eval_compare_b.json", "exit": 0},
		{"name": "list-checks", "cmd": KUJO_BIN + " run main.kujo list-checks", "exit": 0},
		{"name": "snapshots", "cmd": KUJO_BIN + " run main.kujo snapshots --snapshot-dir .eval_snapshots_dir", "exit": 0},
		{"name": "version", "cmd": KUJO_BIN + " run main.kujo version", "exit": 0},
		{"name": "watch", "cmd": KUJO_BIN + " run main.kujo watch --config .eval_entrypoint_suite.json --poll-ms 0 --max-loops 1", "exit": 0},
		{"name": "lint", "cmd": KUJO_BIN + " run main.kujo lint .eval_entrypoint_suite.json", "exit": 0},
		{"name": "policy-explain", "cmd": KUJO_BIN + " run main.kujo policy-explain .eval_entrypoint_suite.json --json", "exit": 0},
		{"name": "diff", "cmd": KUJO_BIN + " run main.kujo diff .eval_diff_a.txt .eval_diff_b.txt", "exit": 0},
		{"name": "export", "cmd": KUJO_BIN + " run main.kujo export .eval_entrypoint_suite.json --output .eval_exported_suite.sh", "exit": 0},
		{"name": "verify-manifest", "cmd": KUJO_BIN + " run main.kujo verify-manifest --output-dir .eval_entrypoint_out", "exit": 0},
		{"name": "completion", "cmd": KUJO_BIN + " run main.kujo completion --shell bash", "exit": 0}
	]

	i := 0
	while i < len(commands) {
		entry := commands[i]
		cmd_name := dict_get_or(entry, "name", "unknown")
		cmd := dict_get_or(entry, "cmd", "")
		expected_exit := dict_get_or(entry, "exit", 0)
		res := run_shell(cmd)
		assert_true(res["ok"])
		assert_equal(res["exit_code"], expected_exit)
		print("entrypoint-ok: " + cmd_name)
		i := i + 1
	}

	try {
		remove_file("eval.json")
		remove_file(".eval_entrypoint_suite.json")
		remove_file(".eval_compare_a.json")
		remove_file(".eval_compare_b.json")
		remove_file(".eval_diff_a.txt")
		remove_file(".eval_diff_b.txt")
		remove_file(".eval_exported_suite.sh")
		remove_file(".eval_entrypoint_out/eval-report.md")
		remove_file(".eval_entrypoint_out/last_run.json")
		remove_file(".eval_entrypoint_out/history.json")
		remove_file(".eval_entrypoint_out/badge.json")
		remove_file(".eval_entrypoint_out/last_failures.json")
		remove_file(".eval_entrypoint_out/summary.json")
		remove_file(".eval_entrypoint_out/cli-summary.json")
		remove_file(".eval_entrypoint_out/artifact-manifest.json")
		remove_file(".eval_entrypoint_out")
		remove_file(".eval_snapshots_dir")
	} except err {}
}
