test "CLI run can overwrite existing run artifacts in same output directory" {
	try {
		write_file(".eval_overwrite_suite.json", "{\"name\":\"overwrite-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	first := run_shell(KUJO_BIN + " run main.kujo run .eval_overwrite_suite.json --output-dir .eval_overwrite_out --json")
	second := run_shell(KUJO_BIN + " run main.kujo run .eval_overwrite_suite.json --output-dir .eval_overwrite_out --json")
	assert_true(first["ok"])
	assert_true(second["ok"])
	assert_equal(first["exit_code"], 0)
	assert_equal(second["exit_code"], 0)
	assert_true(path_exists(".eval_overwrite_out/last_run.json"))

	try {
		remove_file(".eval_overwrite_suite.json")
		remove_file(".eval_overwrite_out/eval-report.md")
		remove_file(".eval_overwrite_out/last_run.json")
		remove_file(".eval_overwrite_out/history.json")
		remove_file(".eval_overwrite_out/badge.json")
		remove_file(".eval_overwrite_out/last_failures.json")
		remove_file(".eval_overwrite_out/summary.json")
		remove_file(".eval_overwrite_out/cli-summary.json")
		remove_file(".eval_overwrite_out/artifact-manifest.json")
		remove_file(".eval_overwrite_out")
	} except err {}
}

test "CLI run writes summary and artifact manifest files" {
	try {
		write_file(".eval_manifest_suite.json", "{\"name\":\"manifest-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo run .eval_manifest_suite.json --output-dir .eval_manifest_out --artifact-checksums --json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)
	assert_true(path_exists(".eval_manifest_out/summary.json"))
	assert_true(path_exists(".eval_manifest_out/artifact-manifest.json"))
	assert_true(path_exists(".eval_manifest_out/cli-summary.json"))

	summary_raw := read_file(".eval_manifest_out/summary.json")
	summary := parse_json(summary_raw)
	assert_equal(dict_get_or(summary, "suite_name", ""), "manifest-suite")
	assert_equal(dict_get_or(summary, "status", ""), "PASS")

	manifest_raw := read_file(".eval_manifest_out/artifact-manifest.json")
	manifest := parse_json(manifest_raw)
	artifacts := dict_get_or(manifest, "artifacts", [])
	assert_true(type(artifacts) == "array")
	assert_true(len(artifacts) >= 5)
	checksums := dict_get_or(manifest, "checksums", {})
	assert_equal(dict_get_or(checksums, "algorithm", ""), "sha256")
	checksum_entries := dict_get_or(checksums, "entries", [])
	assert_true(type(checksum_entries) == "array")
	assert_true(len(checksum_entries) >= len(artifacts))
	ci := 0
	while ci < len(checksum_entries) {
		centry := checksum_entries[ci]
		if type(centry) == "dict" {
			assert_true(path_exists(dict_get_or(centry, "path", "")))
			assert_true(len(dict_get_or(centry, "sha256", "")) > 0)
		}
		ci := ci + 1
	}

	channel_raw := read_file(".eval_manifest_out/cli-summary.json")
	channel := parse_json(channel_raw)
	assert_equal(dict_get_or(channel, "command", ""), "run")
	assert_equal(dict_get_or(channel, "status", ""), "PASS")
	assert_true(path_exists(dict_get_or(channel, "summary_path", "")))
	assert_true(path_exists(dict_get_or(channel, "manifest_path", "")))

	ai := 0
	while ai < len(artifacts) {
		entry := artifacts[ai]
		if type(entry) == "dict" {
			apath := dict_get_or(entry, "path", "")
			if type(apath) == "string" && apath != "" {
				assert_true(path_exists(apath))
			}
		}
		ai := ai + 1
	}

	try {
		remove_file(".eval_manifest_suite.json")
		remove_file(".eval_manifest_out/eval-report.md")
		remove_file(".eval_manifest_out/last_run.json")
		remove_file(".eval_manifest_out/history.json")
		remove_file(".eval_manifest_out/badge.json")
		remove_file(".eval_manifest_out/last_failures.json")
		remove_file(".eval_manifest_out/summary.json")
		remove_file(".eval_manifest_out/cli-summary.json")
		remove_file(".eval_manifest_out/artifact-manifest.json")
		remove_file(".eval_manifest_out")
	} except err {}
}

test "CLI run persists redacted nested secret payloads in artifacts" {
	try {
		write_file(".eval_nested_redaction_suite.json", "{\"name\":\"nested-redaction-suite\",\"redaction_audit_mode\":true,\"tests\":[{\"name\":\"nested-secret\",\"check\":\"output_contains\",\"params\":{\"command\":\"echo '{\\\"auth\\\":{\\\"token\\\":\\\"artifactSecretToken\\\",\\\"api_key\\\":\\\"artifactNestedApiKey\\\"}}'\",\"expected\":\"REDACTED\"}}]}")
	} except err {}

	run_result := run_shell(KUJO_BIN + " run main.kujo run .eval_nested_redaction_suite.json --output-dir .eval_nested_redaction_out --json")
	assert_true(run_result["ok"])
	assert_equal(run_result["exit_code"], 0)

	last_run_raw := read_file(".eval_nested_redaction_out/last_run.json")
	assert_true(contains(last_run_raw, "artifactSecretToken") == 0)
	assert_true(contains(last_run_raw, "artifactNestedApiKey") == 0)
	assert_true(contains(last_run_raw, "REDACTED") == 1)

	try {
		remove_file(".eval_nested_redaction_suite.json")
		remove_file(".eval_nested_redaction_out/eval-report.md")
		remove_file(".eval_nested_redaction_out/last_run.json")
		remove_file(".eval_nested_redaction_out/history.json")
		remove_file(".eval_nested_redaction_out/badge.json")
		remove_file(".eval_nested_redaction_out/last_failures.json")
		remove_file(".eval_nested_redaction_out/summary.json")
		remove_file(".eval_nested_redaction_out/cli-summary.json")
		remove_file(".eval_nested_redaction_out/artifact-manifest.json")
		remove_file(".eval_nested_redaction_out")
	} except err {}
}

test "CLI verify-manifest fails after artifact tampering" {
	try {
		write_file(".eval_manifest_tamper_suite.json", "{\"name\":\"manifest-tamper-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	run_result := run_shell(KUJO_BIN + " run main.kujo run .eval_manifest_tamper_suite.json --output-dir .eval_manifest_tamper_out --artifact-checksums --json")
	assert_true(run_result["ok"])
	assert_equal(run_result["exit_code"], 0)

	verify_pass := run_shell(KUJO_BIN + " run main.kujo verify-manifest --output-dir .eval_manifest_tamper_out --json")
	assert_true(verify_pass["ok"])
	assert_equal(verify_pass["exit_code"], 0)

	try {
		write_file(".eval_manifest_tamper_out/summary.json", "{\"tampered\":true}")
	} except err {}

	verify_fail := run_shell(KUJO_BIN + " run main.kujo verify-manifest --output-dir .eval_manifest_tamper_out --json")
	assert_true(verify_fail["ok"])
	assert_true(verify_fail["exit_code"] != 0)

	failure_payload := parse_json(verify_fail["stdout"])
	assert_false(dict_get_or(failure_payload, "ok", true))
	assert_true(contains(dict_get_or(failure_payload, "error", ""), "verification failed") == 1)

	try {
		remove_file(".eval_manifest_tamper_suite.json")
		remove_file(".eval_manifest_tamper_out/eval-report.md")
		remove_file(".eval_manifest_tamper_out/last_run.json")
		remove_file(".eval_manifest_tamper_out/history.json")
		remove_file(".eval_manifest_tamper_out/badge.json")
		remove_file(".eval_manifest_tamper_out/last_failures.json")
		remove_file(".eval_manifest_tamper_out/summary.json")
		remove_file(".eval_manifest_tamper_out/cli-summary.json")
		remove_file(".eval_manifest_tamper_out/artifact-manifest.json")
		remove_file(".eval_manifest_tamper_out")
	} except err {}
}

test "CLI run respects history_retention_runs" {
	try {
		write_file(".eval_history_retention_suite.json", "{\"name\":\"history-retention-suite\",\"history_retention_runs\":2,\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	r1 := run_shell(KUJO_BIN + " run main.kujo run .eval_history_retention_suite.json --output-dir .eval_history_retention_out --json")
	r2 := run_shell(KUJO_BIN + " run main.kujo run .eval_history_retention_suite.json --output-dir .eval_history_retention_out --json")
	r3 := run_shell(KUJO_BIN + " run main.kujo run .eval_history_retention_suite.json --output-dir .eval_history_retention_out --json")
	assert_equal(r1["exit_code"], 0)
	assert_equal(r2["exit_code"], 0)
	assert_equal(r3["exit_code"], 0)

	history_raw := read_file(".eval_history_retention_out/history.json")
	history := parse_json(history_raw)
	assert_true(type(history) == "array")
	assert_equal(len(history), 2)

	try {
		remove_file(".eval_history_retention_suite.json")
		remove_file(".eval_history_retention_out/eval-report.md")
		remove_file(".eval_history_retention_out/eval-report.md.bak")
		remove_file(".eval_history_retention_out/last_run.json")
		remove_file(".eval_history_retention_out/last_run.json.bak")
		remove_file(".eval_history_retention_out/history.json")
		remove_file(".eval_history_retention_out/history.json.bak")
		remove_file(".eval_history_retention_out/badge.json")
		remove_file(".eval_history_retention_out/badge.json.bak")
		remove_file(".eval_history_retention_out/last_failures.json")
		remove_file(".eval_history_retention_out/last_failures.json.bak")
		remove_file(".eval_history_retention_out/summary.json")
		remove_file(".eval_history_retention_out/summary.json.bak")
		remove_file(".eval_history_retention_out/cli-summary.json")
		remove_file(".eval_history_retention_out/cli-summary.json.bak")
		remove_file(".eval_history_retention_out/artifact-manifest.json")
		remove_file(".eval_history_retention_out/artifact-manifest.json.bak")
		remove_file(".eval_history_retention_out")
	} except err {}
}

test "CLI run respects aux_artifact_retention_files" {
	try {
		write_file(".eval_aux_retention_suite.json", "{\"name\":\"aux-retention-suite\",\"aux_artifact_retention_files\":0,\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	r1 := run_shell(KUJO_BIN + " run main.kujo run .eval_aux_retention_suite.json --output-dir .eval_aux_retention_out --json")
	r2 := run_shell(KUJO_BIN + " run main.kujo run .eval_aux_retention_suite.json --output-dir .eval_aux_retention_out --json")
	assert_equal(r1["exit_code"], 0)
	assert_equal(r2["exit_code"], 0)

	entries := list_dir(".eval_aux_retention_out")
	bi := 0
	while bi < len(entries) {
		assert_false(contains(entries[bi], ".bak") == 1)
		bi := bi + 1
	}

	try {
		remove_file(".eval_aux_retention_suite.json")
		remove_file(".eval_aux_retention_out/eval-report.md")
		remove_file(".eval_aux_retention_out/last_run.json")
		remove_file(".eval_aux_retention_out/history.json")
		remove_file(".eval_aux_retention_out/badge.json")
		remove_file(".eval_aux_retention_out/last_failures.json")
		remove_file(".eval_aux_retention_out/summary.json")
		remove_file(".eval_aux_retention_out/cli-summary.json")
		remove_file(".eval_aux_retention_out/artifact-manifest.json")
		remove_file(".eval_aux_retention_out")
	} except err {}
}

test "CLI report writes machine summary channel" {
	try {
		write_file(".eval_report_channel_suite.json", "{\"name\":\"report-channel-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo report .eval_report_channel_suite.json --rerun --output-dir .eval_report_channel_out --json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)
	assert_true(path_exists(".eval_report_channel_out/cli-summary.json"))

	payload := parse_json(result["stdout"])
	data := dict_get_or(payload, "data", {})
	channel_path := dict_get_or(data, "summary_channel_path", "")
	assert_true(path_exists(channel_path))

	channel_raw := read_file(channel_path)
	channel := parse_json(channel_raw)
	assert_equal(dict_get_or(channel, "command", ""), "report")
	assert_equal(dict_get_or(channel, "from_cache", true), false)
	assert_true(path_exists(dict_get_or(channel, "report_path", "")))
	assert_true(path_exists(dict_get_or(channel, "manifest_path", "")))

	try {
		remove_file(".eval_report_channel_suite.json")
		remove_file(".eval_report_channel_out/eval-report.md")
		remove_file(".eval_report_channel_out/summary.json")
		remove_file(".eval_report_channel_out/cli-summary.json")
		remove_file(".eval_report_channel_out/artifact-manifest.json")
		remove_file(".eval_report_channel_out")
	} except err {}
}

test "CLI report --rerun can overwrite existing report artifact" {
	try {
		write_file(".eval_overwrite_report_suite.json", "{\"name\":\"overwrite-report-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	first := run_shell(KUJO_BIN + " run main.kujo report .eval_overwrite_report_suite.json --rerun --output-dir .eval_overwrite_report_out --format md")
	second := run_shell(KUJO_BIN + " run main.kujo report .eval_overwrite_report_suite.json --rerun --output-dir .eval_overwrite_report_out --format md")
	assert_true(first["ok"])
	assert_true(second["ok"])
	assert_equal(first["exit_code"], 0)
	assert_equal(second["exit_code"], 0)
	assert_true(path_exists(".eval_overwrite_report_out/eval-report.md"))

	try {
		remove_file(".eval_overwrite_report_suite.json")
		remove_file(".eval_overwrite_report_out/eval-report.md")
		remove_file(".eval_overwrite_report_out")
	} except err {}
}

test "CLI report --json returns stable envelope" {
	try {
		write_file(".eval_json_shape_suite.json", "{\"name\":\"json-shape-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo report .eval_json_shape_suite.json --rerun --json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)

	payload := parse_json(result["stdout"])
	assert_equal(has_key(payload, "ok"), 1)
	assert_equal(has_key(payload, "error"), 1)
	assert_equal(has_key(payload, "data"), 1)

	data := dict_get_or(payload, "data", {})
	assert_equal(has_key(data, "report_path"), 1)
	assert_equal(has_key(data, "results"), 1)
	assert_equal(has_key(data, "from_cache"), 1)

	try { remove_file(".eval_json_shape_suite.json") } except err {}
}

test "CLI report reuses unchanged artifact content" {
	try {
		write_file(".eval_report_cache_suite.json", "{\"name\":\"report-cache-suite\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	seed_run := run_shell(KUJO_BIN + " run main.kujo run .eval_report_cache_suite.json --output-dir .eval_report_cache_out --json")
	assert_true(seed_run["ok"])
	assert_equal(seed_run["exit_code"], 0)

	first := run_shell(KUJO_BIN + " run main.kujo report .eval_report_cache_suite.json --output-dir .eval_report_cache_out --incremental --json")
	second := run_shell(KUJO_BIN + " run main.kujo report .eval_report_cache_suite.json --output-dir .eval_report_cache_out --incremental --json")
	assert_true(first["ok"])
	assert_true(second["ok"])
	assert_equal(first["exit_code"], 0)
	assert_equal(second["exit_code"], 0)

	first_payload := parse_json(first["stdout"])
	first_data := dict_get_or(first_payload, "data", {})
	assert_false(dict_get_or(first_data, "report_cached", true))
	assert_true(dict_get_or(first_data, "report_incremental_mode", false))

	second_payload := parse_json(second["stdout"])
	second_data := dict_get_or(second_payload, "data", {})
	assert_true(dict_get_or(second_data, "report_cached", false))
	assert_true(dict_get_or(second_data, "report_incremental_mode", false))
	assert_true(dict_get_or(second_data, "report_incremental_cache_hit", false))
	assert_false(path_exists(".eval_report_cache_out/eval-report.md.bak"))
	assert_true(path_exists(".eval_report_cache_out/eval-report.md.cache.json"))

	try {
		remove_file(".eval_report_cache_suite.json")
		remove_file(".eval_report_cache_out/eval-report.md")
		remove_file(".eval_report_cache_out/eval-report.md.cache.json")
		remove_file(".eval_report_cache_out/last_run.json")
		remove_file(".eval_report_cache_out/history.json")
		remove_file(".eval_report_cache_out/badge.json")
		remove_file(".eval_report_cache_out/last_failures.json")
		remove_file(".eval_report_cache_out/summary.json")
		remove_file(".eval_report_cache_out/cli-summary.json")
		remove_file(".eval_report_cache_out/artifact-manifest.json")
		remove_file(".eval_report_cache_out")
	} except err {}
}

test "CLI policy-explain emits deterministic stage overlay payload" {
	try {
		write_file(".eval_policy_explain_suite.json", "{\"name\":\"policy-explain-suite\",\"policy_profile\":\"local-dev\",\"policy_stage_overlays\":{\"ci\":{\"require_command_policy\":true,\"path_policy_mode\":\"allowlist-required\",\"allowed_commands\":[\"echo\"],\"allowed_paths\":[\"./tests\"]}},\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo policy-explain .eval_policy_explain_suite.json --policy-stage ci --json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)

	payload := parse_json(result["stdout"])
	assert_true(dict_get_or(payload, "ok", false))
	data := dict_get_or(payload, "data", {})
	assert_equal(dict_get_or(data, "active_policy_stage", ""), "ci")
	assert_true(dict_get_or(data, "stage_overlay_applied", false))
	assert_true(dict_get_or(data, "strict_command_policy_enforced", false))
	assert_true(dict_get_or(data, "path_allowlist_enforced", false))
	assert_equal(dict_get_or(data, "risk_tier", ""), "low")

	effective := dict_get_or(data, "effective_policy", {})
	assert_equal(dict_get_or(effective, "path_policy_mode", ""), "allowlist-required")
	allowed_commands := dict_get_or(effective, "allowed_commands", [])
	assert_true(type(allowed_commands) == "array")
	assert_equal(len(allowed_commands), 1)
	assert_equal(allowed_commands[0], "echo")
	risk_hints := dict_get_or(data, "risk_hints", [])
	assert_true(type(risk_hints) == "array")
	assert_true(len(risk_hints) >= 1)

	try {
		remove_file(".eval_policy_explain_suite.json")
	} except err {}
}

test "CLI policy-explain warns on open release posture" {
	try {
		write_file(".eval_policy_explain_open_suite.json", "{\"name\":\"policy-explain-open\",\"policy_profile\":\"local-dev\",\"tests\":[{\"name\":\"ok\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}}]}")
	} except err {}

	result := run_shell(KUJO_BIN + " run main.kujo policy-explain .eval_policy_explain_open_suite.json --policy-stage release --json")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)

	payload := parse_json(result["stdout"])
	assert_true(dict_get_or(payload, "ok", false))
	data := dict_get_or(payload, "data", {})
	assert_equal(dict_get_or(data, "risk_tier", ""), "high")
	risk_hints := dict_get_or(data, "risk_hints", [])

	found_open_command := false
	found_open_path := false
	hi := 0
	while hi < len(risk_hints) {
		hint := risk_hints[hi]
		code := dict_get_or(hint, "code", "")
		if code == "POLICY_OPEN_COMMAND_POSTURE" { found_open_command = true }
		if code == "POLICY_OPEN_PATH_POSTURE" { found_open_path = true }
		hi := hi + 1
	}
	assert_true(found_open_command)
	assert_true(found_open_path)

	try { remove_file(".eval_policy_explain_open_suite.json") } except err {}
}

test "CLI artifact contract fixtures remain stable" {
	result := run_shell("KUJO_BIN=" + KUJO_BIN + " bash scripts/verify_artifact_contract.sh")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)
