test "load_config returns error for invalid JSON" {
	try {
		write_file(".eval_test_bad.json", "not valid json {{{")
	} except err {}
	result := load_config(".eval_test_bad.json")
	assert_false(result["ok"])
	try { remove_file(".eval_test_bad.json") } except err {}
}

test "validate_config accepts config with all fields" {
	cfg := {
		"name": "full-suite",
		"description": "desc",
		"version": "2.0.0",
		"output_dir": "./out",
		"snapshot_dir": "./snaps",
		"timeout_seconds": 120,
		"parallel_workers": 6,
		"artifact_checksums": true,
		"stop_on_failure": true,
		"setup": "echo setup",
		"teardown": "echo teardown",
		"tests": [{"name": "t1", "check": "command_succeeds", "params": {"command": "echo ok"}}]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
	val_data := dict_get_or(result, "data", {})
	validated := dict_get_or(val_data, "config", {})
	assert_equal(validated["name"], "full-suite")
	assert_equal(validated["stop_on_failure"], true)
	assert_equal(dict_get_or(validated, "parallel_workers", 1), 6)
	assert_equal(dict_get_or(validated, "artifact_checksums", false), true)
}

test "describe_module commands metadata matches CLI dispatch surface" {
	meta := describe_module()
	commands := dict_get_or(meta, "commands", [])
	expected := ["init", "run", "report", "compare", "list-checks", "snapshots", "version", "watch", "lint", "policy-explain", "diff", "export", "verify-manifest", "completion"]
	assert_equal(len(commands), len(expected))

	ei := 0
	while ei < len(expected) {
		found := false
		ci := 0
		while ci < len(commands) {
			if commands[ci] == expected[ei] {
				found = true
			}
			ci := ci + 1
		}
		assert_true(found)
		ei := ei + 1
	}
}

test "describe_module report_formats metadata matches report implementation" {
	meta := describe_module()
	formats := dict_get_or(meta, "report_formats", [])
	expected := ["md", "html", "ndjson", "junit", "tap"]
	assert_equal(len(formats), len(expected))

	ei := 0
	while ei < len(expected) {
		found := false
		fi := 0
		while fi < len(formats) {
			if formats[fi] == expected[ei] {
				found = true
			}
			fi := fi + 1
		}
		assert_true(found)
		ei := ei + 1
	}
}

