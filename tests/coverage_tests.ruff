# Section 17: Error Path Coverage
# ===========================================================================

test "run_shell rejects empty command string" {
	result := run_shell("")
	assert_false(result["ok"])
	assert_true(len(result["error"]) > 0)
}

test "run_shell rejects whitespace-only command" {
	result := run_shell("   ")
	assert_false(result["ok"])
}

test "run_shell rejects excessively long command" {
	too_long := ""
	i := 0
	while i < 33000 {
		too_long = too_long + "a"
		i := i + 1
	}
	result := run_shell(too_long)
	assert_false(result["ok"])
	assert_true(contains(dict_get_or(result, "error", ""), "maximum length") == true)
}

test "check_json_value_equals rejects invalid JSON" {
	try { write_file(".eval_badjson.txt", "not valid json {{{") } except err {}
	result := check_json_value_equals({"path": ".eval_badjson.txt", "json_path": "key", "expected": "val"})
	assert_false(result["ok"])
	try { remove_file(".eval_badjson.txt") } except err {}
}

test "json_value_equals resolves nested array path with type assertion" {
	try { write_file(".eval_json_array_path.json", "{\"users\":[{\"name\":\"alpha\",\"active\":true},{\"name\":\"beta\",\"active\":false}]}") } except err {}
	result := check_json_value_equals({
		"path": ".eval_json_array_path.json",
		"json_path": "users[1].name",
		"expected": "beta",
		"expected_type": "string"
	})
	assert_true(result["ok"])
	try { remove_file(".eval_json_array_path.json") } except err {}
}

test "json_value_equals accepts cached_file_content" {
	try { write_file(".eval_json_cache_path.json", "{\"payload\":{\"count\":1}}") } except err {}
	result := check_json_value_equals({
		"path": ".eval_json_cache_path.json",
		"json_path": "payload.count",
		"expected": 2,
		"cached_file_content": "{\"payload\":{\"count\":2}}"
	})
	assert_true(result["ok"])
	try { remove_file(".eval_json_cache_path.json") } except err {}
}

test "json_value_equals fails when expected_type does not match" {
	result := check_json_value_equals({
		"json": "{\"payload\":{\"count\":3}}",
		"json_path": "payload.count",
		"expected": 3,
		"expected_type": "string"
	})
	assert_false(result["ok"])
	data := dict_get_or(result, "data", {})
	assert_true(contains(dict_get_or(data, "message", ""), "Type assertion failed") == true)
}

test "command_stdout_json_path_equals supports array indices and expected_type" {
	result := check_command_stdout_json_path_equals({
		"command": "echo '{\"services\":[{\"name\":\"api\",\"latency\":42},{\"name\":\"worker\",\"latency\":84}]}'",
		"json_path": "services[1].latency",
		"expected": 84,
		"expected_type": "number"
	})
	assert_true(result["ok"])
}

test "policy_explain_config merges stage overlay fields" {
	cfg := {
		"name": "policy-view-suite",
		"policy_profile": "local-dev",
		"allowed_commands": ["echo"],
		"path_policy_mode": "open",
		"policy_stage_overlays": {
			"ci": {
				"require_command_policy": true,
				"path_policy_mode": "allowlist-required",
				"allowed_paths": ["./tests"]
			}
		}
	}
	view := policy_explain_config(cfg, "ci")
	assert_equal(dict_get_or(view, "active_policy_stage", ""), "ci")
	assert_true(dict_get_or(view, "stage_overlay_applied", false))
	assert_true(dict_get_or(view, "strict_command_policy_enforced", false))
	assert_true(dict_get_or(view, "path_allowlist_enforced", false))
	effective := dict_get_or(view, "effective_policy", {})
	assert_equal(dict_get_or(effective, "path_policy_mode", ""), "allowlist-required")
	assert_equal(len(dict_get_or(effective, "allowed_paths", [])), 1)
}

test "policy_explain_config emits high risk warnings for open release posture" {
	cfg := {
		"name": "policy-risk-open",
		"policy_profile": "local-dev",
		"tests": [{"name": "ok", "check": "command_succeeds", "params": {"command": "echo ok"}}]
	}
	view := policy_explain_config(cfg, "release")
	assert_equal(dict_get_or(view, "risk_tier", ""), "high")
	assert_true(dict_get_or(view, "risk_score", 0) >= 4)

	hints := dict_get_or(view, "risk_hints", [])
	assert_true(type(hints) == "array")
	assert_true(len(hints) >= 2)

	open_command_warning := false
	open_path_warning := false
	hi := 0
	while hi < len(hints) {
		hint := hints[hi]
		code := normalize_string(dict_get_or(hint, "code", ""), "")
		if code == "POLICY_OPEN_COMMAND_POSTURE" {
			open_command_warning = true
		}
		if code == "POLICY_OPEN_PATH_POSTURE" {
			open_path_warning = true
		}
		hi = hi + 1
	}

	assert_true(open_command_warning)
	assert_true(open_path_warning)
}

test "policy_explain_config emits low risk for strict guarded posture" {
	cfg := {
		"name": "policy-risk-strict",
		"require_command_policy": true,
		"path_policy_mode": "allowlist-required",
		"redaction_audit_mode": true,
		"allowed_command_patterns": ["echo"],
		"blocked_arg_patterns": ["rm -rf"],
		"allowed_paths": ["./tests"],
		"tests": [{"name": "ok", "check": "command_succeeds", "params": {"command": "echo ok"}}]
	}
	view := policy_explain_config(cfg, "release")
	assert_equal(dict_get_or(view, "risk_tier", ""), "low")
	assert_true(dict_get_or(view, "risk_score", 0) <= 1)
}

test "run_suite emits non-empty messages for normalized legacy checks" {
	try {
		create_dir(".eval_cov_dir_a")
		create_dir(".eval_cov_dir_b")
		write_file(".eval_cov_dir_a/f.txt", "alpha")
		write_file(".eval_cov_dir_b/f.txt", "alpha")
		write_file(".eval_cov_shape.json", "{\"name\":\"cov\",\"version\":\"1\"}")
		write_file(".eval_cov_legacy_suite.json", "{\"name\":\"legacy-envelope-suite\",\"tests\":[{\"name\":\"shape\",\"check\":\"json_matches_shape\",\"params\":{\"path\":\".eval_cov_shape.json\",\"required_keys\":[\"name\",\"version\"]}},{\"name\":\"dir\",\"check\":\"directory_diff\",\"params\":{\"dir_a\":\".eval_cov_dir_a\",\"dir_b\":\".eval_cov_dir_b\"}}]}")
	} except err {}

	result := run_suite(".eval_cov_legacy_suite.json", {"quiet": true})
	assert_true(result["ok"])
	data := dict_get_or(result, "data", {})
	entries := dict_get_or(data, "test_results", [])
	assert_equal(len(entries), 2)

	ei := 0
	while ei < len(entries) {
		entry := entries[ei]
		assert_true(len(dict_get_or(entry, "message", "")) > 0)
		details := dict_get_or(entry, "details", {})
		assert_true(type(details) == "dict")
		ei := ei + 1
	}

	try {
		remove_file(".eval_cov_legacy_suite.json")
		remove_file(".eval_cov_shape.json")
		remove_file(".eval_cov_dir_a/f.txt")
		remove_file(".eval_cov_dir_b/f.txt")
		remove_file(".eval_cov_dir_a")
		remove_file(".eval_cov_dir_b")
	} except err {}
}

test "lint_config_file emits code and suggested fix for invalid check" {
	try { write_file(".eval_lint_invalid_check.json", "{\"name\":\"lint-invalid\",\"tests\":[{\"name\":\"bad\",\"check\":\"nope\",\"params\":{}}]}") } except err {}
	result := lint_config_file(".eval_lint_invalid_check.json")
	assert_false(result["ok"])
	data := dict_get_or(result, "data", {})
	diagnostics := dict_get_or(data, "diagnostics", [])
	assert_true(type(diagnostics) == "array")
	assert_true(len(diagnostics) > 0)
	first_diag := diagnostics[0]
	assert_true(type(first_diag) == "dict")
	assert_true(len(dict_get_or(first_diag, "code", "")) > 0)
	assert_true(len(dict_get_or(first_diag, "suggested_fix", "")) > 0)
	try { remove_file(".eval_lint_invalid_check.json") } except err {}
}

test "file_size_greater_than rejects missing file" {
	result := check_file_size_greater_than({"path": "./nonexistent_xyz_file.txt", "bytes": 100})
	assert_false(result["ok"])
}

test "run_check returns error for completely unknown check type" {
	result := run_check("this_check_does_not_exist_xyz", {})
	assert_false(result["ok"])
	data := dict_get_or(result, "data", {})
	assert_true(contains(dict_get_or(data, "message", ""), "Unknown") == true)
}

# ===========================================================================
# Section 18: Utility Function Coverage
# ===========================================================================

test "dict_get_or returns default for non-dict input" {
	result := dict_get_or("not a dict", "key", 42)
	assert_equal(result, 42)
}

test "dict_get_or returns default for missing key" {
	result := dict_get_or({"a": 1}, "b", "default_val")
	assert_equal(result, "default_val")
}

test "dict_get_or returns value for existing key" {
	result := dict_get_or({"a": 1, "b": 2}, "b", 99)
	assert_equal(result, 2)
}

test "normalize_string returns fallback for non-string" {
	result := normalize_string(42, "fallback")
	assert_equal(result, "fallback")
}

test "normalize_string returns fallback for empty string" {
	result := normalize_string("", "empty-fb")
	assert_equal(result, "empty-fb")
}

test "normalize_string trims whitespace" {
	result := normalize_string("  hello  ", "fb")
	assert_equal(result, "hello")
}

test "normalize_int returns fallback for non-int" {
	result := normalize_int("not int", 10)
	assert_equal(result, 10)
}

test "normalize_int returns value for int" {
	result := normalize_int(42, 0)
	assert_equal(result, 42)
}

test "normalize_bool returns fallback for non-bool" {
	result := normalize_bool("yes", false)
	assert_equal(result, false)
}

test "normalize_bool returns value for bool" {
	result := normalize_bool(true, false)
	assert_equal(result, true)
}

test "normalize_array returns empty for non-array" {
	result := normalize_array("not array")
	assert_equal(len(result), 0)
}

test "normalize_array returns value for array" {
	result := normalize_array([1, 2, 3])
	assert_equal(len(result), 3)
}

test "normalize_dict returns empty for non-dict" {
	result := normalize_dict("not dict")
	assert_equal(type(result), "dict")
}

test "normalize_dict returns value for dict" {
	result := normalize_dict({"key": "val"})
	assert_equal(dict_get_or(result, "key", ""), "val")
}
