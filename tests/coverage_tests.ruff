# Comprehensive coverage tests for Kujo Eval.
#
# Fills gaps not covered by contract_tests, security_tests, or cli_integration_tests.
# Organized by module/feature for clarity.

test_setup {
	from src.checks import run_shell, check_command_succeeds, check_command_fails
	from src.checks import check_file_exists, check_file_does_not_exist
	from src.checks import check_file_contains, check_file_does_not_contain
	from src.checks import check_output_contains, check_output_does_not_contain
	from src.checks import check_output_matches_glob, check_file_matches_glob
	from src.checks import check_json_matches_shape, check_exit_code_equals
	from src.checks import check_directory_diff, check_snapshot_matches, run_check
	from src.checks import check_json_value_equals, check_file_size_greater_than, check_file_size_less_than
	from src.checks import check_env_var_equals, check_stdout_json_matches_shape, check_http_status
	from src.checks import check_http_body_contains, check_command_stdout_json_path_equals
	from src.checks import check_file_matches_regex, check_command_timing_less_than
	from src.checks import check_file_line_count, check_directory_contains, check_two_files_equal
	from src.snapshot import save_snapshot, compare_snapshot, list_snapshots, delete_snapshot
	from src.report import generate_markdown_report, generate_html_report, generate_junit_report, generate_tap_report, save_report, print_report
	from src.eval_core import run_suite, compare_runs, contract_version
	from src.config import init_config, load_config, validate_config, lint_config_file, policy_explain_config, KNOWN_CHECKS
	from src.common import dict_get_or, normalize_string, normalize_int, make_result, make_success_result, make_error_result
	from src.cli import parse_cli_flags, print_help
}

# ===========================================================================
# Section 1: Untested Check Types
# ===========================================================================

# --- check_env_var_equals ---

test "env_var_equals rejects empty name" {
	result := check_env_var_equals({"name": "", "expected": "val"})
	assert_false(result["ok"])
}

test "env_var_equals rejects empty expected" {
	result := check_env_var_equals({"name": "PATH", "expected": ""})
	assert_false(result["ok"])
}

test "env_var_equals matches existing env var" {
	result := check_env_var_equals({"name": "PATH", "expected": "/"})
	# PATH may or may not contain "/" — just verify it doesn't crash
	assert_true(type(result["ok"]) == "bool")
}

# --- check_http_status ---

test "http_status rejects empty URL" {
	result := check_http_status({"url": "", "expected_status": 200})
	assert_false(result["ok"])
}

test "http_status is dispatched by run_check" {
	result := run_check("http_status", {"url": ""})
	data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(data, "check", ""), "http_status")
}

# --- check_stdout_json_matches_shape ---

test "stdout_json_matches_shape rejects empty command" {
	result := check_stdout_json_matches_shape({"command": "", "required_keys": ["key"]})
	assert_false(result["ok"])
}

test "stdout_json_matches_shape validates stdout JSON keys" {
	result := check_stdout_json_matches_shape({"command": "echo '{\"name\":\"kujo\",\"version\":1}'", "required_keys": ["name"]})
	assert_true(result["ok"])
}

test "stdout_json_matches_shape fails for missing key in stdout JSON" {
	result := check_stdout_json_matches_shape({"command": "echo '{\"name\":\"kujo\"}'", "required_keys": ["name", "missing_key"]})
	assert_false(result["ok"])
}

test "stdout_json_matches_shape is dispatched by run_check" {
	result := run_check("stdout_json_matches_shape", {"command": "", "required_keys": []})
	data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(data, "check", ""), "stdout_json_matches_shape")
}

# --- check_file_size_less_than ---

test "file_size_less_than rejects empty path" {
	result := check_file_size_less_than({"path": "", "bytes": 100})
	assert_false(result["ok"])
}

test "file_size_less_than passes for small file" {
	try { write_file(".eval_small.txt", "hi") } except err {}
	result := check_file_size_less_than({"path": ".eval_small.txt", "bytes": 1000})
	assert_true(result["ok"])
	try { remove_file(".eval_small.txt") } except err {}
}

test "file_size_less_than fails for too-large file" {
	try { write_file(".eval_big.txt", "hello world this is a test file with content") } except err {}
	result := check_file_size_less_than({"path": ".eval_big.txt", "bytes": 2})
	assert_false(result["ok"])
	try { remove_file(".eval_big.txt") } except err {}
}

# ===========================================================================
# Section 2: Report Format Tests (JUnit XML, TAP)
# ===========================================================================

test "generate_junit_report produces valid XML structure" {
	mock := {
		"suite_name": "junit-test",
		"passed": 2,
		"failed": 1,
		"skipped": 0,
		"total": 3,
		"duration_ms": 100,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t2", "check": "command_succeeds", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t3", "check": "command_fails", "passed": false, "skipped": false, "message": "fail", "details": {}}
		]
	}
	xml := generate_junit_report(mock)
	assert_true(contains(xml, "<?xml") == true)
	assert_true(contains(xml, "<testsuite") == true)
	assert_true(contains(xml, "junit-test") == true)
	assert_true(contains(xml, "tests=\"3\"") == true)
	assert_true(contains(xml, "failures=\"1\"") == true)
	assert_true(contains(xml, "<testcase") == true)
	assert_true(contains(xml, "</testsuite>") == true)
}

test "generate_junit_report includes failure messages" {
	mock := {
		"suite_name": "fail-test",
		"passed": 0,
		"failed": 1,
		"skipped": 0,
		"total": 1,
		"duration_ms": 50,
		"test_results": [
			{"name": "broken", "check": "command_fails", "passed": false, "skipped": false, "message": "expected failure occurred", "details": {}}
		]
	}
	xml := generate_junit_report(mock)
	assert_true(contains(xml, "<failure") == true)
	assert_true(contains(xml, "expected failure occurred") == true)
}

test "generate_tap_report produces valid TAP format" {
	mock := {
		"suite_name": "tap-test",
		"passed": 2,
		"failed": 0,
		"skipped": 0,
		"total": 2,
		"duration_ms": 30,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t2", "check": "command_succeeds", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	}
	tap := generate_tap_report(mock)
	assert_true(contains(tap, "1..2") == true)
	assert_true(contains(tap, "ok 1") == true)
	assert_true(contains(tap, "ok 2") == true)
}

test "generate_tap_report marks failures as not ok" {
	mock := {
		"suite_name": "tap-fail",
		"passed": 0,
		"failed": 1,
		"skipped": 0,
		"total": 1,
		"duration_ms": 10,
		"test_results": [
			{"name": "bad", "check": "file_exists", "passed": false, "skipped": false, "message": "file missing", "details": {}}
		]
	}
	tap := generate_tap_report(mock)
	assert_true(contains(tap, "1..1") == true)
	assert_true(contains(tap, "not ok 1") == true)
	assert_true(contains(tap, "file missing") == true)
}

test "save_report with html format writes .html file" {
	mock_results := make_success_result({
		"suite_name": "save-html-test",
		"passed": 1,
		"failed": 0,
		"skipped": 0,
		"total": 1,
		"duration_ms": 5,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	})
	result := save_report(mock_results, ".eval_cov_output", "html-report", "html")
	assert_true(result["ok"])
	path_val := dict_get_or(dict_get_or(result, "data", {}), "path", "")
	assert_true(contains(path_val, ".html") == true)
	try { remove_file(path_val); remove_file(".eval_cov_output") } except err {}
}

# ===========================================================================
# Section 3: Snapshot Edge Cases
# ===========================================================================

test "snapshot diff includes actual vs expected content" {
	save_snapshot("./snapshots", "diff-test", "line1\nline2\nline3")
	result := compare_snapshot("./snapshots", "diff-test", "line1\nCHANGED\nline3")
	data := dict_get_or(result, "data", {})
	assert_false(result["ok"])
	assert_true(len(dict_get_or(data, "diff", "")) > 0)
	try { remove_file("./snapshots/diff-test.snap") } except err {}
}

test "snapshot with special characters in name is sanitized" {
	save_snapshot("./snapshots", "test/with../bad.chars!", "content")
	result := compare_snapshot("./snapshots", "test/with../bad.chars!", "content")
	assert_true(result["ok"])
	try { remove_file("./snapshots/test_with___bad.chars!.snap") } except err {}
}

test "snapshot handles multi-line content with trailing newline" {
	content := "line A\nline B\nline C\n"
	save_snapshot("./snapshots", "multiline-trail", content)
	result := compare_snapshot("./snapshots", "multiline-trail", content)
	assert_true(result["ok"])
	try { remove_file("./snapshots/multiline-trail.snap") } except err {}
}

test "snapshot handles empty content" {
	save_snapshot("./snapshots", "empty-snap", "")
	result := compare_snapshot("./snapshots", "empty-snap", "")
	assert_true(result["ok"])
	try { remove_file("./snapshots/empty-snap.snap") } except err {}
}

test "check_snapshot_matches with command param runs command for content" {
	try { save_snapshot("./snapshots", "cmd-snap", "hello") } except err {}
	result := check_snapshot_matches({"name": "cmd-snap", "command": "echo hello", "snapshot_dir": "./snapshots"})
	assert_true(result["ok"])
	try { remove_file("./snapshots/cmd-snap.snap") } except err {}
}

# ===========================================================================
# Section 4: Hook Execution
# ===========================================================================

test "run_suite executes before_each hook before each test" {
	try {
		write_file(".eval_hook_test.json", "{\"name\":\"hook-suite\",\"before_each\":\"echo hook-ran\",\"tests\":[{\"name\":\"h1\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo test1\"}},{\"name\":\"h2\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo test2\"}}]}")
	} except err {}
	results := run_suite(".eval_hook_test.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 2)
	try { remove_file(".eval_hook_test.json") } except err {}
}

test "run_suite executes teardown hook after all tests" {
	try {
		write_file(".eval_teardown_test.json", "{\"name\":\"teardown-suite\",\"teardown\":\"echo cleanup\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}
	results := run_suite(".eval_teardown_test.json", {"quiet": true})
	assert_true(results["ok"])
	try { remove_file(".eval_teardown_test.json") } except err {}
}

test "run_suite executes setup hook before any tests" {
	try {
		write_file(".eval_setup_test.json", "{\"name\":\"setup-suite\",\"setup\":\"echo init\",\"tests\":[{\"name\":\"s1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}
	results := run_suite(".eval_setup_test.json", {"quiet": true})
	assert_true(results["ok"])
	try { remove_file(".eval_setup_test.json") } except err {}
}

# ===========================================================================
# Section 5: Filter & Tag Edge Cases
# ===========================================================================

test "filter with pattern that matches no tests returns zero results" {
	try {
		write_file(".eval_filter_none.json", "{\"name\":\"f-none\",\"tests\":[{\"name\":\"apple\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}
	results := run_suite(".eval_filter_none.json", {"filter": "zzz_nonexistent", "quiet": true})
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "skipped", 0), 1)
	try { remove_file(".eval_filter_none.json") } except err {}
}

test "tag filtering with multiple tags runs matching tests" {
	try {
		write_file(".eval_tags_test.json", "{\"name\":\"tag-suite\",\"tests\":[{\"name\":\"smoke1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"},\"tags\":[\"smoke\"]},{\"name\":\"unit1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"},\"tags\":[\"unit\"]}]}")
	} except err {}
	results := run_suite(".eval_tags_test.json", {"tags": "smoke", "quiet": true})
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "skipped", 0), 1)
	try { remove_file(".eval_tags_test.json") } except err {}
}

test "skip-tags excludes matching tests" {
	try {
		write_file(".eval_skiptags_test.json", "{\"name\":\"skip-suite\",\"tests\":[{\"name\":\"keep\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"},\"tags\":[\"keep\"]},{\"name\":\"drop\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"},\"tags\":[\"slow\"]}]}")
	} except err {}
	results := run_suite(".eval_skiptags_test.json", {"skip_tags": "slow", "quiet": true})
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "skipped", 0), 1)
	try { remove_file(".eval_skiptags_test.json") } except err {}
}

test "exclude pattern skips matching tests" {
	try {
		write_file(".eval_exclude_test.json", "{\"name\":\"excl-suite\",\"tests\":[{\"name\":\"run-me\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}},{\"name\":\"skip-me\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}
	results := run_suite(".eval_exclude_test.json", {"exclude": "skip-me", "quiet": true})
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "passed", 0), 1)
	try { remove_file(".eval_exclude_test.json") } except err {}
}

# ===========================================================================
# Section 6: Compare Edge Cases
# ===========================================================================

test "compare_runs detects mixed improvement and regression" {
	run_a := make_success_result({"suite_name": "A", "passed": 8, "failed": 2, "total": 10})
	run_b := make_success_result({"suite_name": "B", "passed": 9, "failed": 3, "total": 12})
	result := compare_runs(run_a, run_b)
	data := dict_get_or(result, "data", {})
	assert_true(dict_get_or(data, "regression", false))
	assert_true(dict_get_or(data, "improvement", false))
	assert_true(contains(dict_get_or(data, "summary", ""), "Mixed") == true)
}

test "compare_runs handles completely different suites" {
	run_a := make_success_result({"suite_name": "A", "passed": 10, "failed": 0, "total": 10})
	run_b := make_success_result({"suite_name": "B", "passed": 0, "failed": 10, "total": 10})
	result := compare_runs(run_a, run_b)
	data := dict_get_or(result, "data", {})
	assert_true(dict_get_or(data, "regression", false))
	assert_false(dict_get_or(data, "improvement", false))
}

# ===========================================================================
# Section 7: Config Edge Cases
# ===========================================================================

test "validate_config handles version field" {
	cfg := {"name": "v-suite", "version": "2.0.0", "tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}}]}
	result := validate_config(cfg)
	data := dict_get_or(result, "data", {})
	validated := dict_get_or(data, "config", {})
	assert_true(result["ok"])
	assert_equal(dict_get_or(validated, "version", ""), "2.0.0")
}

test "validate_config handles description field" {
	cfg := {"name": "desc-suite", "description": "A test suite", "tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}}]}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "validate_config handles output_dir and snapshot_dir fields" {
	cfg := {"name": "dir-suite", "output_dir": "./custom_out", "snapshot_dir": "./custom_snaps", "tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}}]}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "validate_config with test that has description" {
	cfg := {"name": "td-suite", "tests": [{"name": "t1", "description": "does a thing", "check": "file_exists", "params": {"path": "kennel.toml"}}]}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "load_config with valid config returns parsed config in data" {
	try { write_file(".eval_valid_test.json", "{\"name\":\"valid\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}") } except err {}
	result := load_config(".eval_valid_test.json")
	assert_true(result["ok"])
	data := dict_get_or(result, "data", {})
	assert_true(type(dict_get_or(data, "config", {})) == "dict")
	try { remove_file(".eval_valid_test.json") } except err {}
}

# ===========================================================================
# Section 8: Result Envelope Consistency
# ===========================================================================

test "all check functions return {ok, error, data} envelope" {
	checks := KNOWN_CHECKS()
	i := 0
	while i < len(checks) {
		kind := checks[i]
		result := run_check(kind, {})
		assert_true(has_key(result, "ok") == true)
		assert_true(has_key(result, "error") == true)
		assert_true(has_key(result, "data") == true)
		i := i + 1
	}
}

test "make_result produces consistent shape" {
	r := make_result(true, "", {"key": "val"})
	assert_true(r["ok"])
	assert_equal(r["error"], "")
	assert_equal(dict_get_or(r, "data", {}), {"key": "val"})
}

test "make_error_result produces ok=false with error message" {
	r := make_error_result("something broke", {"detail": 42})
	assert_false(r["ok"])
	assert_equal(r["error"], "something broke")
	assert_equal(dict_get_or(r, "data", {}), {"detail": 42})
}

test "make_success_result produces ok=true with empty error" {
	r := make_success_result({"result": "done"})
	assert_true(r["ok"])
	assert_equal(r["error"], "")
	assert_equal(dict_get_or(r, "data", {}), {"result": "done"})
}

# ===========================================================================
# Section 9: CLI Flag Parsing Edge Cases
# ===========================================================================

test "parse_cli_flags handles --format=html" {
	parsed := parse_cli_flags(["--format=html"])
	flags := parsed["flags"]
	assert_equal(dict_get_or(flags, "format", ""), "html")
}

test "parse_cli_flags handles --repeat=5" {
	parsed := parse_cli_flags(["--repeat=5"])
	flags := parsed["flags"]
	assert_equal(dict_get_or(flags, "repeat", ""), "5")
}

test "parse_cli_flags handles --seed=abc123" {
	parsed := parse_cli_flags(["--seed=abc123"])
	flags := parsed["flags"]
	assert_equal(dict_get_or(flags, "seed", ""), "abc123")
}

test "parse_cli_flags handles combined flags" {
	parsed := parse_cli_flags(["--json", "--quiet", "--format=html", "run", "myconfig.json"])
	flags := parsed["flags"]
	positionals := parsed["positionals"]
	assert_true(dict_get_or(flags, "json_output", false))
	assert_true(dict_get_or(flags, "quiet", false))
	assert_equal(dict_get_or(flags, "format", ""), "html")
	assert_equal(positionals[0], "run")
	assert_equal(positionals[1], "myconfig.json")
}

test "parse_cli_flags handles --config with value" {
	parsed := parse_cli_flags(["--config", "custom.json"])
	flags := parsed["flags"]
	assert_equal(dict_get_or(flags, "config", ""), "custom.json")
}

test "parse_cli_flags handles --output-dir with value" {
	parsed := parse_cli_flags(["--output-dir", "./reports"])
	flags := parsed["flags"]
	assert_equal(dict_get_or(flags, "output-dir", ""), "./reports")
}

test "normalize_int parses numeric CLI string values" {
	assert_equal(normalize_int("0", 99), 0)
	assert_equal(normalize_int("8", 99), 8)
	assert_equal(normalize_int("-2", 99), -2)
	assert_equal(normalize_int("not-a-number", 99), 99)
}

test "watch numeric flags normalize from parse_cli_flags output" {
	parsed := parse_cli_flags(["watch", "--poll-ms", "0", "--max-loops", "1"])
	flags := parsed["flags"]
	assert_equal(normalize_int(dict_get_or(flags, "poll-ms", 2000), 2000), 0)
	assert_equal(normalize_int(dict_get_or(flags, "max-loops", 500), 500), 1)
}

# ===========================================================================
# Section 10: Check Output Edge Cases
# ===========================================================================

test "output_contains handles empty expected" {
	result := check_output_contains({"command": "echo hi", "expected": ""})
	assert_false(result["ok"])
}

test "output_does_not_contain handles empty unexpected" {
	result := check_output_does_not_contain({"command": "echo hi", "expected": ""})
	assert_false(result["ok"])
}

test "output_matches_glob handles empty expected" {
	result := check_output_matches_glob({"command": "echo hi", "expected": ""})
	assert_false(result["ok"])
}

test "file_contains with Unicode emoji" {
	try { write_file(".eval_emoji_test.txt", "hello 🌍 world 🚀 test") } except err {}
	result := check_file_contains({"path": ".eval_emoji_test.txt", "expected": "🌍"})
	assert_true(result["ok"])
	try { remove_file(".eval_emoji_test.txt") } except err {}
}

test "file_does_not_contain with Unicode content" {
	try { write_file(".eval_unicode_test.txt", "café résumé naïve") } except err {}
	result := check_file_does_not_contain({"path": ".eval_unicode_test.txt", "expected": "pizza"})
	assert_true(result["ok"])
	try { remove_file(".eval_unicode_test.txt") } except err {}
}

test "file_does_not_contain fails when text is present" {
	try { write_file(".eval_has_text.txt", "secret token here") } except err {}
	result := check_file_does_not_contain({"path": ".eval_has_text.txt", "expected": "token"})
	assert_false(result["ok"])
	try { remove_file(".eval_has_text.txt") } except err {}
}

# ===========================================================================
# Section 11: Stop-On-Failure Behavior
# ===========================================================================

test "run_suite with stop_on_failure halts after first failure" {
	try {
		write_file(".eval_stop_test.json", "{\"name\":\"stop-suite\",\"stop_on_failure\":true,\"tests\":[{\"name\":\"will-fail\",\"check\":\"command_fails\",\"params\":{\"command\":\"echo hi\"}},{\"name\":\"should-skip\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}
	results := run_suite(".eval_stop_test.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "failed", 0), 1)
	assert_equal(dict_get_or(data, "total", 0), 1)
	try { remove_file(".eval_stop_test.json") } except err {}
}

test "run_suite applies per-test timeout_seconds override" {
	try {
		write_file(".eval_test_timeout_override.json", "{\"name\":\"timeout-override-suite\",\"timeout_seconds\":5,\"tests\":[{\"name\":\"timeout-override\",\"check\":\"command_succeeds\",\"timeout_seconds\":1,\"params\":{\"command\":\"bash -c 'sleep 2'\"}}]}")
	} except err {}
	results := run_suite(".eval_test_timeout_override.json", {"quiet": true})
	assert_true(results["ok"])
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "failed", 0), 1)
	trs := dict_get_or(data, "test_results", [])
	if len(trs) > 0 {
		first := trs[0]
		assert_true(contains(normalize_string(dict_get_or(first, "message", ""), ""), "timed out") == true)
	}
	try { remove_file(".eval_test_timeout_override.json") } except err {}
}

