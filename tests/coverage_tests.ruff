# Section 13: New Check Edge Cases
# ===========================================================================

test "check_file_matches_regex handles multi-line content" {
	try { write_file(".eval_regex_ml.txt", "line1\nline2\n123\nline4") } except err {}
	result := check_file_matches_regex({"path": ".eval_regex_ml.txt", "pattern": "[0-9]+"})
	assert_true(result["ok"])
	try { remove_file(".eval_regex_ml.txt") } except err {}
}

test "check_file_matches_regex accepts cached_file_content" {
	try { write_file(".eval_regex_cache.txt", "abc") } except err {}
	result := check_file_matches_regex({"path": ".eval_regex_cache.txt", "pattern": "XYZ", "cached_file_content": "XYZ"})
	assert_true(result["ok"])
	try { remove_file(".eval_regex_cache.txt") } except err {}
}

test "check_command_timing_less_than records timing data" {
	result := check_command_timing_less_than({"command": "echo fast", "max_ms": 10000})
	data := dict_get_or(result, "data", {})
	assert_true(dict_get_or(data, "elapsed_ms", -1) >= 0)
}

test "check_directory_contains handles no pattern (counts all files)" {
	result := check_directory_contains({"dir": "src", "min_files": 3})
	assert_true(result["ok"])
}

test "check_two_files_equal rejects missing path_b" {
	result := check_two_files_equal({"path_a": "kennel.toml", "path_b": ""})
	assert_false(result["ok"])
}

test "check_two_files_equal passes with same file compared to itself" {
	result := check_two_files_equal({"path_a": "kennel.toml", "path_b": "kennel.toml"})
	assert_true(result["ok"])
}

test "check_file_line_count supports less_than comparison" {
	try { write_file(".eval_lt_test.txt", "a\nb\n") } except err {}
	result := check_file_line_count({"path": ".eval_lt_test.txt", "expected": 10, "comparison": "less_than"})
	assert_true(result["ok"])
	try { remove_file(".eval_lt_test.txt") } except err {}
}

test "check_file_line_count accepts cached_file_content" {
	try { write_file(".eval_line_cache.txt", "a") } except err {}
	result := check_file_line_count({"path": ".eval_line_cache.txt", "expected": 3, "comparison": "equals", "cached_file_content": "a\nb\nc"})
	assert_true(result["ok"])
	try { remove_file(".eval_line_cache.txt") } except err {}
}

test "check_file_line_count rejects unknown comparison" {
	try { write_file(".eval_badcmp.txt", "a\n") } except err {}
	result := check_file_line_count({"path": ".eval_badcmp.txt", "expected": 1, "comparison": "invalid_op"})
	assert_false(result["ok"])
	try { remove_file(".eval_badcmp.txt") } except err {}
}

# ===========================================================================
# Section 14: Markdown Report Edge Cases
# ===========================================================================

test "generate_markdown_report handles skipped tests in output" {
	mock := {
		"suite_name": "skip-report",
		"passed": 1,
		"failed": 0,
		"skipped": 2,
		"total": 3,
		"duration_ms": 10,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t2", "check": "command_succeeds", "passed": true, "skipped": true, "message": "Skipped", "details": {}},
			{"name": "t3", "check": "command_succeeds", "passed": true, "skipped": true, "message": "Skipped", "details": {}}
		]
	}
	report := generate_markdown_report(mock)
	assert_true(contains(report, "Skipped") == true)
	assert_true(contains(report, "2") == true)
}

test "generate_markdown_report handles empty test results" {
	mock := {
		"suite_name": "empty-report",
		"passed": 0,
		"failed": 0,
		"skipped": 0,
		"total": 0,
		"duration_ms": 0,
		"test_results": []
	}
	report := generate_markdown_report(mock)
	assert_true(contains(report, "empty-report") == true)
	assert_true(contains(report, "No test results") == true)
}

