test "request changes pause can be resumed to completion" {
	workflow := create_research_report_workflow("Approval lifecycle topic", false)
	run_state := create_run_state(workflow, {"topic": "Approval lifecycle topic"}, "tests/tmp/outputs", {
		"auto_approve": false,
		"interactive": false
	})
	tool_registry := register_default_tools("examples/research-report/sources")
	first := run_workflow(workflow, run_state, tool_registry, {
		"auto_approve": false,
		"interactive": false,
		"simulated_decision": "changes",
		"simulated_note": "Need stronger evidence"
	})
	assert_true(first["ok"])
	assert_true(first["paused"])
	paused_state := first["run_state"]
	assert_equal(paused_state["status"], "needs_changes")
	assert_equal(paused_state["human_intervention"]["event_type"], "human_intervention_required")
	assert_equal(paused_state["human_intervention"]["run"]["run_id"], paused_state["run_id"])
	assert_equal(paused_state["human_intervention"]["run"]["step_id"], "approval_gate")
	assert_equal(paused_state["human_intervention"]["security"]["decision_id"], paused_state["approvals"][0]["id"])

	second := run_workflow(workflow, paused_state, tool_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_true(second["ok"])
	assert_false(second["paused"])
	assert_equal(second["run_state"]["status"], "completed")
}

test "rejected approval ends workflow with failure" {
	workflow := create_research_report_workflow("Approval rejection topic", false)
	run_state := create_run_state(workflow, {"topic": "Approval rejection topic"}, "tests/tmp/outputs", {
		"auto_approve": false,
		"interactive": false
	})
	tool_registry := register_default_tools("examples/research-report/sources")
	result := run_workflow(workflow, run_state, tool_registry, {
		"auto_approve": false,
		"interactive": false,
		"simulated_decision": "rejected",
		"simulated_note": "Risk not acceptable"
	})
	assert_false(result["ok"])
	assert_false(result["paused"])
	assert_equal(result["run_state"]["status"], "failed")
	assert_equal(result["error"]["code"], "approval_rejected")
}

test "persisted artifacts redact sensitive values" {
	workflow := create_research_report_workflow("Redaction topic", true)
	run_state := create_run_state(workflow, {
		"topic": "Redaction topic",
		"api_key": "STATE_SECRET_123"
	}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	run_state["trace"] := append_trace(run_state["trace"], "custom_event", "custom_step", "custom", {
		"authorization": "Bearer TRACE_SECRET_456"
	})
	run_data := run_state["data"]
	run_data["token"] := "DATA_SECRET_789"
	run_state["data"] := run_data
	run_state := persist_run_state(run_state)

	state_raw := read_file(run_state["run_dir"] + "/state.json")
	trace_raw := read_file(run_state["run_dir"] + "/trace.json")
	trace_md_raw := read_file(run_state["run_dir"] + "/trace.md")

	assert_equal(contains(state_raw, "STATE_SECRET_123"), 0)
	assert_equal(contains(state_raw, "DATA_SECRET_789"), 0)
	assert_equal(contains(trace_raw, "TRACE_SECRET_456"), 0)
	assert_equal(contains(trace_md_raw, "TRACE_SECRET_456"), 0)
	assert_equal(contains(state_raw, "[REDACTED]"), 1)
	assert_equal(contains(trace_raw, "[REDACTED]"), 1)
}

