test "agent registry dispatch executes mapped and custom handlers" {
	workflow := create_research_report_workflow("Agent registry topic", true)
	workflow_agents := workflow["agents"]
	workflow_agents["custom_agent"] := {
		"id": "custom_agent",
		"name": "Custom Agent",
		"purpose": "Custom test agent",
		"instructions": "Return fixture payload",
		"model": {},
		"tools": [],
		"handoff_targets": [],
		"output_schema": {"type": "dict"},
		"guardrails": []
	}
	workflow_agents["__agent_handlers"] := {
		"custom_agent": func(agent, step_input, run_state, tool_registry, context) {
			return {
				"ok": true,
				"data": {
					"custom": true,
					"run_id": context["run_id"]
				}
			}
		}
	}
	run_state := {
		"run_id": "agent-registry-run",
		"input": {"topic": "Agent registry topic"}
	}
	registry := register_default_tools("examples/research-report/sources")

	planner_result := run_agent("planner", workflow_agents, {
		"input": {"topic": "Agent registry topic"}
	}, run_state, registry)
	assert_true(planner_result["ok"])
	assert_true(len(planner_result["data"]["questions"]) > 0)

	custom_result := run_agent("custom_agent", workflow_agents, {}, run_state, registry)
	assert_true(custom_result["ok"])
	assert_true(custom_result["data"]["custom"])
}

