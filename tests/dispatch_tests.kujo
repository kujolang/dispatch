test "load run state backfills missing contract schema metadata" {
	output_root := "tests/tmp/contract-backfill-outputs"
	workflow := create_research_report_workflow("Contract backfill topic", true)
	run_state := create_run_state(workflow, {"topic": "Contract backfill topic"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	state_path := run_state["run_dir"] + "/state.json"
	legacy_state := parse_json(read_file(state_path))
	legacy_without_contract := {}
	for key in keys(legacy_state) {
		if key == "artifact_contract_version" || key == "schema_name" || key == "schema_version" || key == "trace" {
			continue
		}
		legacy_without_contract[key] := legacy_state[key]
	}
	legacy_trace := dict_get_or(legacy_state, "trace", {})
	legacy_trace_without_contract := {}
	for trace_key in keys(legacy_trace) {
		if trace_key == "artifact_contract_version" || trace_key == "schema_name" || trace_key == "schema_version" {
			continue
		}
		legacy_trace_without_contract[trace_key] := legacy_trace[trace_key]
	}
	legacy_without_contract["trace"] := legacy_trace_without_contract
	write_file(state_path, to_json(legacy_without_contract), true)

	loaded := load_run_state(output_root, run_state["run_id"])
	assert_true(loaded["ok"])
	backfilled := loaded["run_state"]
	assert_equal(dict_get_or(backfilled, "artifact_contract_version", 0), 1)
	assert_equal(dict_get_or(backfilled, "schema_name", ""), "dispatch-run-state")
	assert_equal(dict_get_or(backfilled, "schema_version", 0), 1)
	backfilled_trace := dict_get_or(backfilled, "trace", {})
	assert_equal(dict_get_or(backfilled_trace, "artifact_contract_version", 0), 1)
	assert_equal(dict_get_or(backfilled_trace, "schema_name", ""), "dispatch-trace")
	assert_equal(dict_get_or(backfilled_trace, "schema_version", 0), 1)
}

