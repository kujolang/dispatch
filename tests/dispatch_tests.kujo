test "mutation audit rotation keeps active log bounded and rolls over" {
	output_root := "tests/tmp/audit-rotation-outputs"
	large_blob := "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"

	first_path := append_mutation_audit_record(output_root, "rotation_test_1", [{
		"run_id": "run-1",
		"action": "first"
	}], {
		"blob": large_blob
	}, {
		"max_bytes": 300,
		"max_backups": 3,
		"rotate_daily": false
	})
	assert_equal(first_path, mutation_audit_path(output_root))

	second_path := append_mutation_audit_record(output_root, "rotation_test_2", [{
		"run_id": "run-2",
		"action": "second"
	}], {
		"blob": large_blob
	}, {
		"max_bytes": 300,
		"max_backups": 3,
		"rotate_daily": false
	})
	assert_equal(second_path, mutation_audit_path(output_root))

	audit_raw := read_file(mutation_audit_path(output_root))
	assert_equal(contains(audit_raw, "\"operation\":\"rotation_test_2\""), 1)
	assert_equal(contains(audit_raw, "\"operation\":\"rotation_test_1\""), 0)

	entries := list_dir(output_root)
	rotation_files := []
	for entry in entries {
		entry_name := replace(entry, "/", "")
		if starts_with(entry_name, "dispatch-mutations.") && ends_with(entry_name, ".jsonl") {
			rotation_files := push(rotation_files, entry_name)
		}
	}
	assert_true(len(rotation_files) >= 1)
	rotated_has_first := false
	for rotation_file in rotation_files {
		rotated_raw := read_file(output_root + "/" + rotation_file)
		if contains(rotated_raw, "\"operation\":\"rotation_test_1\"") == 1 {
			rotated_has_first = true
		}
	}
	assert_true(rotated_has_first)
}

test "doctor incremental mode supports recent count and explicit run IDs" {
	output_root := "tests/tmp/doctor-incremental-outputs"
	workflow := create_research_report_workflow("Doctor Incremental Topic", true)

	run_one := create_run_state(workflow, {"topic": "Doctor Incremental 1"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_one["status"] := "completed"
	run_one["updated_at"] := "2026-01-01 00:00:01"
	run_one := persist_run_state(run_one)

	run_two := create_run_state(workflow, {"topic": "Doctor Incremental 2"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_two["status"] := "completed"
	run_two["updated_at"] := "2026-01-01 00:00:02"
	run_two := persist_run_state(run_two)

	run_three := create_run_state(workflow, {"topic": "Doctor Incremental 3"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_three["status"] := "completed"
	run_three["updated_at"] := "2026-01-01 00:00:03"
	run_three := persist_run_state(run_three)

	recent_diag := doctor_runs(output_root, false, {
		"recent_count": 1
	})
	assert_equal(len(recent_diag), 1)
	recent_run_id := dict_get_or(recent_diag[0], "run_id", "")
	recent_is_known := recent_run_id == run_one["run_id"] || recent_run_id == run_two["run_id"] || recent_run_id == run_three["run_id"]
	assert_true(recent_is_known)

	selected_diag := doctor_runs(output_root, false, {
		"run_ids": run_one["run_id"] + "," + run_three["run_id"]
	})
	assert_equal(len(selected_diag), 2)

	selected_has_run_one := false
	selected_has_run_three := false
	for item in selected_diag {
		if dict_get_or(item, "run_id", "") == run_one["run_id"] {
			selected_has_run_one = true
		}
		if dict_get_or(item, "run_id", "") == run_three["run_id"] {
			selected_has_run_three = true
		}
	}
	assert_true(selected_has_run_one)
	assert_true(selected_has_run_three)
}

