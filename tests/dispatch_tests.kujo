}

test "trace markdown includes event counts and timeline" {
	trace := create_trace("run-trace-md", "Trace Markdown Workflow")
	trace := append_trace(trace, "step_started", "s1", "Started", {"a": 1})
	trace := append_trace(trace, "step_completed", "s1", "Completed", {"b": 2})
	trace := append_trace(trace, "step_started", "s2", "Started", {"a": 2})
	trace := finalize_trace(trace, "completed")
	counts := collect_event_type_counts(trace)
	assert_equal(counts["step_started"], 2)
	assert_equal(counts["step_completed"], 1)
	markdown := render_trace_markdown(trace)
	assert_equal(contains(markdown, "## Event Type Counts"), 1)
	assert_equal(contains(markdown, "step_started: 2"), 1)
	assert_equal(contains(markdown, "## Events"), 1)
}

