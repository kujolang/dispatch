test "tool payload adapters support custom mapping" {
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool(
		"custom_payload_tool",
		"Maps step_input into a focused payload.",
		{"type": "dict"},
		{"type": "dict"},
		func(input_payload, context) {
			return {
				"ok": true,
				"data": input_payload
			}
		},
		func(step_input) {
			return {
				"mapped_topic": dict_get_or(dict_get_or(step_input, "input", {}), "topic", "")
			}
		}
	))
	step_input := {
		"input": {"topic": "Adapter topic"},
		"extra": "ignored"
	}
	payload := build_tool_payload(registry, "custom_payload_tool", step_input)
	assert_equal(payload["mapped_topic"], "Adapter topic")

	result := call_tool(registry, "custom_payload_tool", payload, {
		"run_id": "adapter-tool-run",
		"input": {"topic": "Adapter topic"},
		"sources_dir": "examples/research-report/sources"
	})
	assert_true(result["ok"])
	assert_equal(result["data"]["mapped_topic"], "Adapter topic")
}

test "local source lookup blocks unsafe source ids" {
	registry := register_default_tools("examples/research-report/sources")
	context := {
		"run_id": "test-run-sec-001",
		"input": {"topic": "security"},
		"sources_dir": "examples/research-report/sources"
	}

	allowed := call_tool(registry, "local_source_lookup", {"source_id": "source-1"}, context)
	assert_true(allowed["ok"])

	blocked_values := ["../secret", "..%2fsecret", "a/b", "/etc/passwd", "..\\secret"]
	for blocked in blocked_values {
		result := call_tool(registry, "local_source_lookup", {"source_id": blocked}, context)
		assert_false(result["ok"])
		assert_equal(result["error"]["code"], "invalid_source_id")
	}
}

test "tool registry rejects invalid sources directories" {
	invalid_registry := register_default_tools("../examples/research-report/sources")
	invalid_search := call_tool(invalid_registry, "mock_web_search", {"query": "workflow approvals"}, {
		"run_id": "test-run-sec-002",
		"input": {"topic": "workflow approvals"},
		"sources_dir": "../examples/research-report/sources"
	})
	assert_false(invalid_search["ok"])
	assert_equal(invalid_search["error"]["code"], "invalid_sources_dir")

	valid_registry := register_default_tools("examples/research-report/sources")
	valid_search := call_tool(valid_registry, "mock_web_search", {"query": "workflow approvals"}, {
		"run_id": "test-run-sec-002-valid",
		"input": {"topic": "workflow approvals"},
		"sources_dir": "examples/research-report/sources"
	})
	assert_true(valid_search["ok"])
}

test "retry behavior succeeds after transient failures" {
	counter := {"value": 0}
	policy := {
		"max_attempts": 4,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "linear",
		"retry_on_codes": ["flaky_failure"]
	}
	result := run_with_retry("test-flaky", policy, func(attempt_number) {
		counter["value"] := counter["value"] + 1
		if counter["value"] < 3 {
			return {
				"ok": false,
				"error": {
					"code": "flaky_failure",
					"message": "not yet",
					"retryable": true
				}
			}
		}
		return {
			"ok": true,
			"data": {"done": true}
		}
	})
	assert_true(result["ok"])
	assert_equal(result["attempts"], 3)
}

test "retry delay supports deterministic jitter" {
	policy := {
		"base_delay_ms": 10,
		"max_delay_ms": 100,
		"strategy": "linear",
		"jitter": "deterministic",
		"jitter_ms": 5,
		"jitter_seed": 7
	}
	delay0 := compute_delay(0, policy)
	delay1 := compute_delay(1, policy)
	delay2 := compute_delay(2, policy)
	assert_equal(delay0, 11)
	assert_equal(delay1, 22)
	assert_equal(delay2, 33)
}

test "approval decision handling supports approve reject and pause" {
	request := create_approval_request("approval_gate", "Need review", "Review verification output", {"claims": 3})
	approved := resolve_approval(request, {
		"auto_approve": true,
		"interactive": false
	})
	assert_true(approved["ok"])
	assert_false(approved["paused"])
	assert_equal(approved["approval"]["decision"], "approved")

	request2 := create_approval_request("approval_gate", "Need review", "Review verification output", {"claims": 3})
	rejected := resolve_approval(request2, {
		"interactive": false,
		"simulated_decision": "rejected",
		"simulated_note": "Needs changes"
	})
	assert_true(rejected["ok"])
	assert_equal(rejected["approval"]["decision"], "rejected")

	request3 := create_approval_request("approval_gate", "Need review", "Review verification output", {"claims": 3})
	paused := resolve_approval(request3, {
		"interactive": false
	})
	assert_true(paused["ok"])
	assert_true(paused["paused"])
}

test "approval rejects invalid simulated decision values" {
	request := create_approval_request("approval_gate", "Need review", "Review verification output", {"claims": 3})
	invalid := resolve_approval(request, {
		"interactive": false,
		"simulated_decision": "maybe"
	})
	assert_false(invalid["ok"])
	assert_equal(invalid["error"]["code"], "invalid_approval_decision")
}

test "decision normalization matrix supports shared CLI and approval logic" {
	approved_inputs := ["approve", "approved", "a", " APPROVE "]
	for value in approved_inputs {
		assert_equal(normalize_decision(value, "pending"), "approved")
		assert_equal(normalize_decision(value, ""), "approved")
	}

	rejected_inputs := ["reject", "rejected", "r"]
	for value in rejected_inputs {
		assert_equal(normalize_decision(value, "pending"), "rejected")
		assert_equal(normalize_decision(value, ""), "rejected")
	}

	change_inputs := ["changes", "request_changes", "c"]
	for value in change_inputs {
		assert_equal(normalize_decision(value, "pending"), "request_changes")
		assert_equal(normalize_decision(value, ""), "request_changes")
	}

	assert_equal(normalize_decision("", "pending"), "pending")
	assert_equal(normalize_decision("pending", "pending"), "pending")
	assert_equal(normalize_decision("", ""), "")
	assert_equal(normalize_decision("maybe", "pending"), "invalid")
}

test "cli args parser handles flags and positionals with schema" {
	parsed := parse_cli_args([
		"demo", "topic", "--yes", "--output-root", "tmp", "--decision", "approved"
	], {
		"flags": {
			"--yes": {"takes_value": false, "default": false},
			"--output-root": {"takes_value": true, "default": "outputs"},
			"--decision": {"takes_value": true, "default": ""}
		}
	})
	assert_true(parsed["ok"])
	assert_true(parsed_has_flag(parsed, "--yes"))
	assert_equal(parsed_flag_value(parsed, "--output-root", "outputs"), "tmp")
	assert_equal(parsed_flag_value(parsed, "--decision", ""), "approved")
	assert_equal(parsed["positionals"][0], "demo")
	assert_equal(parsed["positionals"][1], "topic")
}

test "cli args parser returns missing value and unknown flag errors" {
	missing_value := parse_cli_args(["--output-root"], {
		"flags": {
			"--output-root": {"takes_value": true, "default": "outputs"}
		}
	})
	assert_false(missing_value["ok"])
	assert_equal(missing_value["error"]["code"], "missing_flag_value")

	unknown_flag := parse_cli_args(["--bogus"], {
		"flags": {
			"--output-root": {"takes_value": true, "default": "outputs"}
		}
	})
	assert_false(unknown_flag["ok"])
	assert_equal(unknown_flag["error"]["code"], "unknown_flag")
}

test "cli args parser enforces required flags" {
	parsed := parse_cli_args([], {
		"flags": {
			"--output-root": {"takes_value": true, "required": true}
		}
	})
	assert_false(parsed["ok"])
	assert_equal(parsed["error"]["code"], "missing_required_flag")
}

test "step schema validation enforces input and output contracts" {
	default_retry := {
		"max_attempts": 1,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "none",
		"retry_on_codes": []
	}

	pass_step := create_step("schema_pass", "Schema Pass", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "schema_output",
		"input_schema": {
			"type": "dict",
			"required": ["input"]
		},
		"output_schema": {
			"type": "dict",
			"required": ["timestamp"],
			"properties": {
				"timestamp": {"type": "string"}
			}
		}
	})
	pass_workflow := create_workflow({
		"id": "schema_pass_workflow",
		"name": "Schema Pass Workflow",
		"description": "Schema validation pass path",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": [pass_step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	pass_state := create_run_state(pass_workflow, {"topic": "Schema pass"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	pass_registry := register_default_tools("examples/research-report/sources")
	pass_result := run_workflow(pass_workflow, pass_state, pass_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_true(pass_result["ok"])

	input_fail_step := create_step("schema_input_fail", "Schema Input Fail", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["plan"],
		"output_key": "schema_output",
		"input_schema": {
			"type": "dict",
			"required": ["input"]
		}
	})
	input_fail_workflow := create_workflow({
		"id": "schema_input_fail_workflow",
		"name": "Schema Input Fail Workflow",
		"description": "Schema input validation failure",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": [input_fail_step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	input_fail_state := create_run_state(input_fail_workflow, {"topic": "Schema input fail"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	input_fail_registry := register_default_tools("examples/research-report/sources")
	input_fail_result := run_workflow(input_fail_workflow, input_fail_state, input_fail_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_false(input_fail_result["ok"])
	assert_equal(input_fail_result["error"]["code"], "step_input_schema_validation_failed")

	output_fail_step := create_step("schema_output_fail", "Schema Output Fail", "tool", {
		"tool_name": "bad_output_tool",
		"input_from": ["input"],
		"output_key": "bad_output",
		"output_schema": {
			"type": "dict",
			"required": ["generated_at"]
		}
	})
	output_fail_workflow := create_workflow({
		"id": "schema_output_fail_workflow",
		"name": "Schema Output Fail Workflow",
		"description": "Schema output validation failure",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["bad_output_tool"],
		"steps": [output_fail_step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	output_fail_state := create_run_state(output_fail_workflow, {"topic": "Schema output fail"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	output_fail_registry := create_tool_registry()
	output_fail_registry := register_tool(output_fail_registry, create_tool(
		"bad_output_tool",
		"Returns output that violates the required schema.",
		{"type": "dict"},
		{"type": "dict"},
		func(input_payload, context) {
			return {
				"ok": true,
				"data": {
					"value": "missing generated_at"
				}
			}
		},
		func(step_input) {
			return step_input
		}
	))
	output_fail_result := run_workflow(output_fail_workflow, output_fail_state, output_fail_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_false(output_fail_result["ok"])
	assert_equal(output_fail_result["error"]["code"], "step_output_schema_validation_failed")
}

test "step timeout and cancellation handling update run lifecycle" {
	default_retry := {
		"max_attempts": 1,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "none",
		"retry_on_codes": []
	}

	timeout_step := create_step("timeout_step", "Timeout Step", "tool", {
		"tool_name": "slow_tool",
		"input_from": ["input"],
		"output_key": "timeout_result",
		"timeout_ms": 5
	})
	timeout_workflow := create_workflow({
		"id": "timeout_workflow",
		"name": "Timeout Workflow",
		"description": "Timeout behavior",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["slow_tool"],
		"steps": [timeout_step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	timeout_state := create_run_state(timeout_workflow, {"topic": "Timeout"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	timeout_registry := create_tool_registry()
	timeout_registry := register_tool(timeout_registry, create_tool(
		"slow_tool",
		"Sleeps long enough to exceed timeout",
		{"type": "dict"},
		{"type": "dict"},
		func(input_payload, context) {
			sleep(20)
			return {
				"ok": true,
				"data": {"done": true}
			}
		},
		func(step_input) {
			return step_input
		}
	))
	timeout_result := run_workflow(timeout_workflow, timeout_state, timeout_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_false(timeout_result["ok"])
	assert_equal(timeout_result["error"]["code"], "step_timeout_exceeded")

	cancel_step_one := create_step("cancel_first", "Cancel First", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "first"
	})
	cancel_step_two := create_step("cancel_second", "Cancel Second", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "second"
	})
	cancel_workflow := create_workflow({
		"id": "cancel_workflow",
		"name": "Cancel Workflow",
		"description": "Cancellation behavior",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": [cancel_step_one, cancel_step_two],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	cancel_state := create_run_state(cancel_workflow, {"topic": "Cancel"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	cancel_registry := register_default_tools("examples/research-report/sources")
	cancel_result := run_workflow(cancel_workflow, cancel_state, cancel_registry, {
		"auto_approve": true,
		"interactive": false,
		"cancel_after_step_id": "cancel_first"
	})
	assert_false(cancel_result["ok"])
	assert_true(cancel_result["cancelled"])
	assert_equal(cancel_result["error"]["code"], "workflow_cancelled")
	assert_equal(cancel_result["run_state"]["status"], "cancelled")
}

test "lifecycle hooks emit callback and webhook sink events" {
	default_retry := {
		"max_attempts": 1,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "none",
		"retry_on_codes": []
	}
	hook_step := create_step("hook_step", "Hook Step", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "hook_output"
	})
	hook_workflow := create_workflow({
		"id": "hook_workflow",
		"name": "Hook Workflow",
		"description": "Lifecycle hook emission",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": [hook_step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	hook_state := create_run_state(hook_workflow, {"topic": "Hook topic"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	hook_registry := register_default_tools("examples/research-report/sources")
	hook_callback_path := hook_state["run_dir"] + "/hook-callback-events.jsonl"
	hook_sink_path := hook_state["run_dir"] + "/hook-events.jsonl"
	hook_result := run_workflow(hook_workflow, hook_state, hook_registry, {
		"auto_approve": true,
		"interactive": false,
		"webhook_sink": hook_sink_path,
		"event_hook": func(event_payload) {
			existing := ""
			if file_exists(hook_callback_path) {
				existing = read_file(hook_callback_path)
			}
			line := to_json(event_payload)
			if existing != "" {
				line = existing + "\n" + line
			}
			write_file(hook_callback_path, line, true)
			return {
				"ok": true
			}
		}
	})
	assert_true(hook_result["ok"])

	hook_callback_raw := read_file(hook_callback_path)
	callback_lines := split(hook_callback_raw, "\n")
	assert_true(len(callback_lines) >= 3)
	assert_equal(contains(hook_callback_raw, "\"event_type\":\"step_started\""), 1)
	assert_equal(contains(hook_callback_raw, "\"event_type\":\"run_completed\""), 1)

	hook_sink_raw := read_file(hook_sink_path)
	hook_sink_lines := split(hook_sink_raw, "\n")
	assert_true(len(hook_sink_lines) >= 3)
	assert_equal(contains(hook_sink_raw, "\"event_type\":\"step_started\""), 1)
	assert_equal(contains(hook_sink_raw, "\"event_type\":\"run_completed\""), 1)
}

test "doctor write persists repaired state changes" {
	output_root := "tests/tmp/doctor-outputs"
	workflow := create_research_report_workflow("Doctor topic", true)
	run_state := create_run_state(workflow, {"topic": "Doctor topic"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_state["status"] := "running"
	run_state["current_step_index"] := len(run_state["steps"]) + 4
	run_state := persist_run_state(run_state)

	dry_diag := doctor_runs(output_root, false, {})
	assert_true(len(dry_diag) >= 1)
	assert_true(dry_diag[0]["repaired"])

	loaded_before := load_run_state(output_root, run_state["run_id"])
	assert_true(loaded_before["ok"])
	assert_equal(loaded_before["run_state"]["status"], "running")

	write_diag := doctor_runs(output_root, true, {})
	assert_true(len(write_diag) >= 1)
	assert_true(write_diag[0]["repaired"])

	loaded_after := load_run_state(output_root, run_state["run_id"])
	assert_true(loaded_after["ok"])
	assert_equal(loaded_after["run_state"]["status"], "completed")
}

