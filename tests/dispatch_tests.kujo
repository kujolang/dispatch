test "dispatch runs rejects invalid numeric flags" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}
	process_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"runs",
		"--output-root",
		"tests/tmp/outputs",
		"--limit",
		"abc"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(process_result.success)
	combined := to_string(process_result.stdout) + "\n" + to_string(process_result.stderr)
	assert_equal(contains(combined, "Invalid value for --limit"), 1)
}

test "state persistence saves and reloads run" {
