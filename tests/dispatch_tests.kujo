test_setup {
	from src.workflows.workflow import create_research_report_workflow, create_workflow_by_template, create_workflow, list_workflow_templates
	from src.tools.tool import register_default_tools, call_tool, create_tool_registry, create_tool, register_tool, build_tool_payload
	from src.core.retry import run_with_retry, compute_delay
	from src.core.approval import create_approval_request, resolve_approval
	from src.core.decision import normalize_decision
	from src.cli.cli_args import parse_cli_args, parsed_has_flag, parsed_flag_value
	from src.core.handoff import create_handoff
	from src.core.state import create_run_state, load_run_state, list_runs, list_runs_with_diagnostics, summarize_run, detect_run_issues, repair_run_state, persist_run_state, filter_runs, paginate_runs, build_run_catalog, prune_runs, doctor_runs, normalize_output_root, mutation_audit_path, append_mutation_audit_record, export_run_bundle, import_run_bundle
	from src.core.trace import create_trace, append_trace, finalize_trace, collect_event_type_counts, render_trace_markdown, apply_trace_limits
	from src.core.report import build_report_payload, render_markdown_report, write_report_artifacts
	from src.core.runner import run_workflow
	from src.agents.agent import run_agent
	from src.core.plugins import create_plugin, create_plugin_registry, register_plugin, apply_plugins_to_runtime
	from src.plugins.builtin_plugins import resolve_builtin_plugins, collect_plugin_event_hooks, reset_plugin_event_state, get_plugin_event_state
	from src.workflows.loader import load_workflow_from_spec
	from src.core.step import create_step
	from src.core.tool_policy import parse_tool_name_list, build_tool_authorization_policy, build_tool_authorization_policy_with_profile
	from src.tools.source_lookup import mock_web_search_handler, canonicalize_path, path_is_within_root
	from src.core.utils import dict_get_or, ensure_dir
}

test "workflow creation includes required sections" {
	workflow := create_research_report_workflow("Agent reliability", true)
	assert_equal(workflow["name"], "Research Report Workflow")
	assert_equal(has_key(workflow, "input_schema"), 1)
	assert_equal(has_key(workflow, "agents"), 1)
	assert_true(len(workflow["steps"]) >= 8)
	assert_equal(has_key(workflow, "default_retry_policy"), 1)
	assert_equal(has_key(workflow, "output_schema"), 1)
}

test "workflow template selection supports known and unknown IDs" {
	selected := create_workflow_by_template("research-report", "Template topic", true)
	assert_true(selected["ok"])
	assert_equal(selected["workflow"]["name"], "Research Report Workflow")

	crud_selected := create_workflow_by_template("crud-reliability", "Template topic", true)
	assert_true(crud_selected["ok"])
	assert_equal(crud_selected["workflow"]["name"], "CRUD Reliability Workflow")

	missing := create_workflow_by_template("unknown-template", "Template topic", true)
	assert_false(missing["ok"])
	assert_equal(missing["error"]["code"], "missing_workflow")
}

test "workflow template introspection exposes summary metadata" {
	templates := list_workflow_templates()
	assert_true(len(templates) >= 2)
	research_found := false
	crud_found := false
	for template in templates {
		template_id := dict_get_or(template, "template_id", "")
		if template_id == "research-report" {
			research_found = true
		}
		if template_id == "crud-reliability" {
			crud_found = true
		}
		assert_true(dict_get_or(template, "step_count", 0) > 0)
		assert_true(dict_get_or(template, "tool_count", 0) > 0)
		assert_true(has_key(template, "tools") == 1)
	}
	assert_true(research_found)
	assert_true(crud_found)
}

test "templates command supports text and json output" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}
	text_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"templates"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(text_result.success)
	text_output := to_string(text_result.stdout)
	assert_equal(contains(text_output, "research-report"), 1)
	assert_equal(contains(text_output, "crud-reliability"), 1)

	json_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"templates",
		"--json"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(json_result.success)
	parsed := parse_json(to_string(json_result.stdout))
	assert_true(has_key(parsed, "templates") == 1)
	assert_true(len(dict_get_or(parsed, "templates", [])) >= 2)
}

test "crud reliability workflow template runs with fixture tools" {
	selected := create_workflow_by_template("crud-reliability", "Orders API reliability", true)
	assert_true(selected["ok"])
	workflow := selected["workflow"]
	run_state := create_run_state(workflow, {"topic": "Orders API reliability"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	tool_registry := register_default_tools("examples/research-report/sources")
	result := run_workflow(workflow, run_state, tool_registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_true(result["ok"])
	assert_equal(result["run_state"]["status"], "completed")
	assert_equal(result["run_state"]["workflow_name"], "CRUD Reliability Workflow")
}

