}

test "signed bundle verification supports deterministic pass and fail paths" {
	output_root := "tests/tmp/export-import-signed-source"
	workflow := create_research_report_workflow("Signed Export Topic", true)
	run_state := create_run_state(workflow, {"topic": "Signed Export Topic"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_state["status"] := "completed"
	run_state := persist_run_state(run_state)

	bundle_path := "tests/tmp/run-bundles/signed-export-bundle.json"
	signing_key := "dispatch-test-signing-key"
	exported := export_run_bundle(output_root, run_state["run_id"], bundle_path, {
		"include_signature": true,
		"signing_key": signing_key
	})
	assert_true(exported["ok"])

	verified := import_run_bundle("tests/tmp/export-import-signed-target", bundle_path, {
		"verify_signature": true,
		"signing_key": signing_key
	})
	assert_true(verified["ok"])

	tampered_path := "tests/tmp/run-bundles/signed-export-bundle-tampered.json"
	bundle_payload := parse_json(read_file(bundle_path))
	artifacts := dict_get_or(bundle_payload, "artifacts", {})
	artifacts["state_json"] := to_string(dict_get_or(artifacts, "state_json", "")) + "\nTampered"
	bundle_payload["artifacts"] := artifacts
	write_file(tampered_path, to_json(bundle_payload), true)

	tampered := import_run_bundle("tests/tmp/export-import-signed-target", tampered_path, {
		"verify_signature": true,
		"signing_key": signing_key
	})
	assert_false(tampered["ok"])
	assert_equal(tampered["error"]["code"], "invalid_bundle_signature")
	assert_equal(contains(to_string(tampered["error"]["message"]), "verification failed"), 1)

	unsigned := export_run_bundle(output_root, run_state["run_id"], "tests/tmp/run-bundles/unsigned-export-bundle.json", {})
	assert_true(unsigned["ok"])
	unsigned_verified := import_run_bundle("tests/tmp/export-import-signed-target", "tests/tmp/run-bundles/unsigned-export-bundle.json", {
		"verify_signature": true,
		"signing_key": signing_key
	})
	assert_false(unsigned_verified["ok"])
	assert_equal(unsigned_verified["error"]["code"], "invalid_bundle_signature")
	assert_equal(contains(to_string(unsigned_verified["error"]["message"]), "metadata is missing"), 1)
}

test "cli negative path matrix returns deterministic errors" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	cases := [
		{
			"args": ["runs", "--status", "bogus"],
			"expected": "Invalid value for --status"
		},
		{
			"args": ["cleanup", "--status", "bogus"],
			"expected": "Invalid value for --status"
		},
		{
			"args": ["cleanup", "--max-count"],
			"expected": "Missing value for flag: --max-count"
		}
	]

	for case_item in cases {
		process_args := [kujo_bin, "run", "dispatch.kujo"]
		for extra in dict_get_or(case_item, "args", []) {
			process_args := push(process_args, extra)
		}
		result := spawn_process(process_args, {
			"inherit_env": true,
			"timeout_ms": 120000,
			"max_output_bytes": 1024 * 1024
		})
		assert_false(result.success)
		combined := to_string(result.stdout) + "\n" + to_string(result.stderr)
		assert_equal(contains(combined, dict_get_or(case_item, "expected", "")), 1)
	}
}

test "dispatch help usage snapshot remains compatible" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	invocations := [
		["help"],
		["--", "--help"],
		["--", "-h"]
	]
	usage_snapshot := [
		"kujo run dispatch.kujo demo \"Research topic\" [--workflow research-report] [--policy-profile staging] [--tags prod,project-a] [--yes] [--non-interactive] [--output-root outputs]",
		"kujo run dispatch.kujo show <run-id> [--output-root outputs] [--json]",
		"kujo run dispatch.kujo inspect <run-id> [--output-root outputs] [--json]",
		"kujo run dispatch.kujo resume <run-id> [--workflow research-report] [--policy-profile staging] [--yes] [--non-interactive] [--output-root outputs]",
		"kujo run dispatch.kujo resume-decision <decision.json> [--output-root outputs] [--non-interactive]",
		"kujo run dispatch.kujo templates [--json]",
		"kujo run dispatch.kujo runs [--output-root outputs] [--status completed] [--workflow research] [--topic ai] [--tags prod] [--issues-only] [--limit 50] [--offset 0] [--json] [--diagnostics]",
		"kujo run dispatch.kujo doctor [--output-root outputs] [--write] [--run-ids run-1,run-2] [--recent-count 20] [--json] [--strict-mutations] [--confirm-mutation]",
		"kujo run dispatch.kujo cleanup [--output-root outputs] [--status completed] [--older-than-hours 24] [--max-count 50] [--apply] [--json] [--strict-mutations] [--confirm-mutation]",
		"kujo run dispatch.kujo export-run <run-id> --bundle-path bundles/run.json [--output-root outputs] [--sign-bundle] [--signing-key key]",
		"kujo run dispatch.kujo import-run --bundle-path bundles/run.json [--output-root outputs] [--verify-bundle-signature] [--signing-key key] [--strict-mutations] [--confirm-mutation]",
		"kujo run dispatch.kujo version"
	]

	invocation_index := 0
	while invocation_index < len(invocations) {
		process_args := [kujo_bin, "run", "dispatch.kujo"]
		command_tokens := invocations[invocation_index]
		token_index := 0
		while token_index < len(command_tokens) {
			process_args = push(process_args, command_tokens[token_index])
			token_index = token_index + 1
		}

		result := spawn_process(process_args, {
			"inherit_env": true,
			"timeout_ms": 120000,
			"max_output_bytes": 1024 * 1024
		})
		assert_true(result.success)
		combined := to_string(result.stdout) + "\n" + to_string(result.stderr)
		assert_true(index_of(combined, "Dispatch") >= 0)
		assert_true(index_of(combined, "Usage:") >= 0)

		lines := split(combined, "\n")
		usage_lines := []
		line_index := 0
		while line_index < len(lines) {
			line_text := trim(to_string(lines[line_index]))
			if starts_with(line_text, "kujo run dispatch.kujo ") {
				usage_lines = push(usage_lines, line_text)
			}
			line_index = line_index + 1
		}

		assert_equal(len(usage_lines), len(usage_snapshot))
		usage_index := 0
		while usage_index < len(usage_snapshot) {
			assert_equal(usage_lines[usage_index], usage_snapshot[usage_index])
			usage_index = usage_index + 1
		}

		invocation_index = invocation_index + 1
	}
}

test "dispatch unknown command prints usage snapshot" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	unknown := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"unknown-command"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(unknown.success)
	combined := to_string(unknown.stdout) + "\n" + to_string(unknown.stderr)
	assert_true(index_of(combined, "Unknown command: unknown-command") >= 0)

	expected_tokens := [
		"dispatch.kujo demo",
		"dispatch.kujo show",
		"dispatch.kujo inspect",
		"dispatch.kujo resume",
		"dispatch.kujo templates",
		"dispatch.kujo runs",
		"dispatch.kujo doctor",
		"dispatch.kujo cleanup",
		"dispatch.kujo export-run",
		"dispatch.kujo import-run"
	]
	token_index := 0
	while token_index < len(expected_tokens) {
		assert_true(index_of(combined, expected_tokens[token_index]) >= 0)
		token_index = token_index + 1
	}
}

test "long run stress fixture keeps traces bounded" {
	fixture_raw := read_file("tests/fixtures/trace_stress_fixture.json")
	fixture := parse_json(fixture_raw)
	step_count := dict_get_or(fixture, "step_count", 60)
	trace_max_events := dict_get_or(fixture, "trace_max_events", 60)
	trace_max_payload_chars := dict_get_or(fixture, "trace_max_payload_chars", 200)

	steps := []
	i := 0
	while i < step_count {
		steps := push(steps, create_step("stress_step_" + to_string(i), "Stress Step " + to_string(i), "tool", {
			"tool_name": "timestamp_tool",
			"input_from": ["input"],
			"output_key": "stress_output_" + to_string(i)
		}))
		i := i + 1
	}

	workflow := create_workflow({
		"id": "trace_stress_workflow",
		"name": "Trace Stress Workflow",
		"description": "Stress trace bounds under long runs",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": steps,
		"memory_config": {},
		"default_retry_policy": {
			"max_attempts": 1,
			"base_delay_ms": 0,
			"max_delay_ms": 0,
			"strategy": "none",
			"retry_on_codes": []
		},
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	run_state := create_run_state(workflow, {"topic": "Trace stress topic"}, "tests/tmp/stress-outputs", {
		"auto_approve": true,
		"interactive": false,
		"trace_max_events": trace_max_events,
		"trace_max_payload_chars": trace_max_payload_chars
	})
	registry := register_default_tools("examples/research-report/sources")
	result := run_workflow(workflow, run_state, registry, {
		"auto_approve": true,
		"interactive": false
	})
	assert_true(result["ok"])
	final_trace := dict_get_or(result["run_state"], "trace", {})
	assert_true(len(dict_get_or(final_trace, "events", [])) <= trace_max_events)
	assert_true(dict_get_or(dict_get_or(final_trace, "truncated", {}), "events_dropped", 0) > 0)
	assert_true(dict_get_or(final_trace, "event_count_total", 0) > len(dict_get_or(final_trace, "events", [])))
}

test "corruption matrix covers malformed and missing artifact scenarios" {
	output_root := "tests/tmp/corruption-matrix-outputs"
	workflow := create_research_report_workflow("Corruption Matrix Topic", true)

	malformed := create_run_state(workflow, {"topic": "Malformed"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	write_file(malformed["run_dir"] + "/state.json", "{ malformed", true)
	malformed_loaded := load_run_state(output_root, malformed["run_id"])
	assert_false(malformed_loaded["ok"])

	partial_run_id := "run-" + to_string(current_timestamp()) + "-9001"
	partial_run_dir := output_root + "/" + partial_run_id
	create_dir(output_root)
	create_dir(partial_run_dir)
	write_file(partial_run_dir + "/state.json", to_json({
		"run_id": partial_run_id,
		"workflow_id": "partial_workflow",
		"workflow_name": "Partial Workflow",
		"status": "completed",
		"input": {"topic": "Partial"},
		"current_step_index": 1,
		"steps": [{"id": "s1", "status": "completed"}],
		"trace": {
			"status": "running",
			"events": [],
			"started_at": "2026-05-22 00:00:00",
			"finished_at": ""
		},
		"run_dir": partial_run_dir,
		"output_root": output_root,
		"updated_at": "2026-05-22 00:00:00"
	}), true)

	runs := list_runs(output_root)
	assert_true(len(runs) >= 1)
	diagnostics := doctor_runs(output_root, false, {})
	assert_true(len(diagnostics) >= 1)

	has_issueful_run := false
	for item in diagnostics {
		if dict_get_or(item, "load_ok", true) == false || dict_get_or(item, "issues_before", 0) > 0 {
			has_issueful_run = true
		}
	}
	assert_true(has_issueful_run)
}

