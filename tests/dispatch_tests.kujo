	assert_true(dict_get_or(dict_get_or(parsed, "filtered_catalog", {}), "total_runs", 0) >= 5)
}

test "workflow config file supports parsing and cli override precedence" {
	config_path := "tests/tmp/dispatch-demo-config.json"
	write_file(config_path, to_json({
		"topic": "Config Driven Topic",
		"workflow": "research-report",
		"yes": true,
		"non_interactive": true,
		"output_root": "tests/tmp/config-workflow-outputs",
		"sources_dir": "examples/research-report/sources",
		"decision": "maybe"
	}), true)

	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	invalid_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"demo",
		"--config",
		config_path
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(invalid_result.success)
	invalid_output := to_string(invalid_result.stdout) + "\n" + to_string(invalid_result.stderr)
	assert_equal(contains(invalid_output, "Invalid --decision value"), 1)

	override_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"demo",
		"--config",
		config_path,
		"--decision",
		"approve"
	], {
		"inherit_env": true,
		"timeout_ms": 300000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(override_result.success)
	override_output := to_string(override_result.stdout)
	assert_equal(contains(override_output, "Run ID:"), 1)
}

test "tool policy parsing and enforcement supports allow deny normalization" {
	parsed := parse_tool_name_list(" timestamp_tool,markdown_report_writer, timestamp_tool ")
	assert_equal(len(parsed), 2)
	assert_equal(parsed[0], "timestamp_tool")
	assert_equal(parsed[1], "markdown_report_writer")

	policy_settings := build_tool_authorization_policy(["timestamp_tool"], ["flaky_reliability_tool"])
	policy := dict_get_or(policy_settings, "policy", null)
	assert_true(type(policy) != "null")

	denied := policy({"tool_name": "flaky_reliability_tool"})
	assert_false(dict_get_or(denied, "allow", true))

	not_allowed := policy({"tool_name": "citation_formatter"})
	assert_false(dict_get_or(not_allowed, "allow", true))

	allowed := policy({"tool_name": "timestamp_tool"})
	assert_true(allowed)
}

test "policy profile aliases resolve and explicit lists override profile defaults" {
	prod_settings := build_tool_authorization_policy_with_profile("prod", [], [])
	assert_true(dict_get_or(prod_settings, "ok", false))
	assert_equal(dict_get_or(prod_settings, "policy_profile", ""), "prod")
	prod_policy := dict_get_or(prod_settings, "policy", null)
	assert_true(type(prod_policy) != "null")
	prod_denied := prod_policy({"tool_name": "flaky_reliability_tool"})
	assert_false(dict_get_or(prod_denied, "allow", true))
	prod_unknown := prod_policy({"tool_name": "nonexistent_tool"})
	assert_false(dict_get_or(prod_unknown, "allow", true))

	override_settings := build_tool_authorization_policy_with_profile("prod", ["timestamp_tool"], [])
	assert_true(dict_get_or(override_settings, "ok", false))
	override_policy := dict_get_or(override_settings, "policy", null)
	assert_true(type(override_policy) != "null")
	override_allowed := override_policy({"tool_name": "timestamp_tool"})
	assert_true(override_allowed)
	override_not_allowed := override_policy({"tool_name": "citation_formatter"})
	assert_false(dict_get_or(override_not_allowed, "allow", true))

	deny_override := build_tool_authorization_policy_with_profile("dev", [], ["timestamp_tool"])
	assert_true(dict_get_or(deny_override, "ok", false))
	deny_policy := dict_get_or(deny_override, "policy", null)
	assert_true(type(deny_policy) != "null")
	deny_result := deny_policy({"tool_name": "timestamp_tool"})
	assert_false(dict_get_or(deny_result, "allow", true))

	missing_profile := build_tool_authorization_policy_with_profile("unknown-profile", [], [])
	assert_false(dict_get_or(missing_profile, "ok", true))
	assert_true(contains(to_string(dict_get_or(missing_profile, "message", "")), "Unknown policy profile alias") >= 0)
}

