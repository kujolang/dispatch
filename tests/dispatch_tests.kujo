test "run listing filters and catalog support automation workflows" {
	output_root := "tests/tmp/catalog-outputs"
	workflow := create_research_report_workflow("Catalog Alpha", true)

	run_a := create_run_state(workflow, {"topic": "Catalog Alpha"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_a["status"] := "completed"
	run_a["current_step_index"] := len(run_a["steps"])
	run_a := persist_run_state(run_a)

	run_b := create_run_state(workflow, {"topic": "Catalog Beta"}, output_root, {
		"auto_approve": false,
		"interactive": false
	})
	run_b["status"] := "running"
	run_b["current_step_index"] := len(run_b["steps"]) + 1
	run_b := persist_run_state(run_b)

	runs := list_runs(output_root)
	assert_true(len(runs) >= 2)

	completed_runs := filter_runs(runs, "completed", "", false)
	assert_true(len(completed_runs) >= 1)
	assert_equal(completed_runs[0]["status"], "completed")

	topic_runs := filter_runs(runs, "", "alpha", false)
	assert_true(len(topic_runs) >= 1)
	assert_equal(contains(to_lower(topic_runs[0]["topic"]), "alpha"), 1)

	issue_runs := filter_runs(runs, "", "", true)
	assert_true(len(issue_runs) >= 1)
	assert_true(issue_runs[0]["issues_count"] > 0)

	catalog := build_run_catalog(runs)
	assert_true(catalog["total_runs"] >= 2)
	assert_true(has_key(catalog["status_counts"], "completed") == 1)
	assert_true(catalog["issues_total"] >= 1)
}

test "cleanup command supports dry-run and apply pruning" {
	output_root := "tests/tmp/cleanup-outputs"
	workflow := create_research_report_workflow("Cleanup Topic", true)

	run_one := create_run_state(workflow, {"topic": "Cleanup One"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_one["status"] := "completed"
	run_one := persist_run_state(run_one)

	run_two := create_run_state(workflow, {"topic": "Cleanup Two"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_two["status"] := "completed"
	run_two := persist_run_state(run_two)

	run_three := create_run_state(workflow, {"topic": "Cleanup Three"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_three["status"] := "completed"
	run_three := persist_run_state(run_three)

	runs_before := list_runs(output_root)
	assert_true(len(runs_before) >= 3)

	dry_run := prune_runs(output_root, "completed", 1, 0, true)
	assert_true(dry_run["dry_run"])
	assert_true(dry_run["candidate_count"] >= 1)
	assert_equal(dry_run["pruned_count"], 0)
	runs_after_dry := list_runs(output_root)
	assert_true(len(runs_after_dry) >= 3)

	apply_run := prune_runs(output_root, "completed", 1, 0, false)
	assert_false(apply_run["dry_run"])
	assert_true(apply_run["candidate_count"] >= 1)
	assert_true(apply_run["pruned_count"] >= 1)
	runs_after_apply := list_runs(output_root)
	assert_equal(len(runs_after_apply), 1)
}

test "run pagination handles larger catalogs" {
	output_root := "tests/tmp/pagination-outputs"
	workflow := create_research_report_workflow("Pagination Topic", true)
	i := 0
	while i < 12 {
		run_item := create_run_state(workflow, {"topic": "Pagination " + to_string(i)}, output_root, {
			"auto_approve": true,
			"interactive": false
		})
		run_item["status"] := "completed"
		run_item := persist_run_state(run_item)
		i := i + 1
	}

	runs := list_runs(output_root)
	assert_true(len(runs) >= 12)
	page := paginate_runs(runs, 5, 4)
	assert_equal(len(page), 4)
	assert_equal(page[0]["run_id"], runs[5]["run_id"])
	rest := paginate_runs(runs, 10, 0)
	assert_true(len(rest) >= 2)
}

test "dependency scheduling supports parallel-ready DAG steps" {
	default_retry := {
		"max_attempts": 1,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "none",
		"retry_on_codes": []
	}
	step_a := create_step("dag_a", "DAG A", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "a"
	})
	step_b := create_step("dag_b", "DAG B", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "b"
	})
	step_join := create_step("dag_join", "DAG Join", "tool", {
		"tool_name": "combine_tool",
		"input_from": ["a", "b"],
		"depends_on": ["dag_a", "dag_b"],
		"output_key": "combined"
	})
	dag_workflow := create_workflow({
		"id": "dag_workflow",
		"name": "DAG Workflow",
		"description": "Dependency scheduling",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool", "combine_tool"],
		"steps": [step_a, step_b, step_join],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})
	dag_state := create_run_state(dag_workflow, {"topic": "DAG"}, "tests/tmp/outputs", {
		"auto_approve": true,
		"interactive": false
	})
	dag_registry := register_default_tools("examples/research-report/sources")
	dag_registry := register_tool(dag_registry, create_tool(
		"combine_tool",
		"Combines dependency outputs.",
		{"type": "dict"},
		{"type": "dict"},
		func(input_payload, context) {
			return {
				"ok": true,
				"data": {
					"has_a": type(dict_get_or(input_payload, "a", null)) == "dict",
					"has_b": type(dict_get_or(input_payload, "b", null)) == "dict"
				}
			}
		},
		func(step_input) {
			return step_input
		}
	))
	dag_result := run_workflow(dag_workflow, dag_state, dag_registry, {
		"auto_approve": true,
		"interactive": false,
		"parallel_execution": true
	})
	assert_true(dag_result["ok"])
	assert_equal(dag_result["run_state"]["status"], "completed")
	combined := dict_get_or(dag_result["run_state"]["data"], "combined", {})
	assert_true(dict_get_or(combined, "has_a", false))
	assert_true(dict_get_or(combined, "has_b", false))
}

test "summarize run reports artifact availability" {
