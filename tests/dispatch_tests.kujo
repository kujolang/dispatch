test "signed bundle supports key id rotation via a trusted key set" {
	output_root := "tests/tmp/rotation-source"
	workflow := create_research_report_workflow("Rotation Topic", true)
	run_state := create_run_state(workflow, {"topic": "Rotation Topic"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_state["status"] := "completed"
	run_state := persist_run_state(run_state)

	bundle_path := "tests/tmp/run-bundles/rotation-bundle.json"
	exported := export_run_bundle(output_root, run_state["run_id"], bundle_path, {
		"include_signature": true,
		"signing_key": "key-2025",
		"signing_key_id": "k2025"
	})
	assert_true(exported["ok"])

	signature := dict_get_or(parse_json(read_file(bundle_path)), "signature", {})
	assert_equal(dict_get_or(signature, "key_id", ""), "k2025")

	# Verifies using a rotation set that contains the bundle's key id alongside an older key.
	rotated := import_run_bundle("tests/tmp/rotation-target", bundle_path, {
		"verify_signature": true,
		"signing_keys": "k2024=old-key,k2025=key-2025"
	})
	assert_true(rotated["ok"])

	# A set missing the bundle's key id falls back to the single key, which is absent here.
	missing := import_run_bundle("tests/tmp/rotation-target", bundle_path, {
		"verify_signature": true,
		"signing_keys": "k2024=old-key"
	})
	assert_false(missing["ok"])
	assert_equal(missing["error"]["code"], "invalid_bundle_signature")
}

test "idempotency key reuses cached output instead of re-executing" {
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool(
		"marker_tool",
		"Returns a live marker so a cache hit is observable.",
		{"type": "dict"},
		{"type": "dict"},
		func(params, context) {
			return {"ok": true, "data": {"source": "live"}}
		},
		func(step_input) { return {} }
	))

	workflow := create_workflow({
		"id": "idempotency_workflow",
		"name": "Idempotency Workflow",
		"description": "Single step with an idempotency key.",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["marker_tool"],
		"steps": [
			create_step("produce", "Produce", "tool", {
				"tool_name": "marker_tool", "input_from": ["input"], "output_key": "out",
				"idempotency_key": "k1"
			})
		],
		"memory_config": {},
		"default_retry_policy": {"max_attempts": 1, "base_delay_ms": 0, "max_delay_ms": 0, "strategy": "none", "retry_on_codes": []},
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})

	run_state := create_run_state(workflow, {"topic": "idem"}, "tests/tmp/idempotency-outputs", {
		"auto_approve": true, "interactive": false
	})
	# Simulate a prior run having already produced this keyed result.
	run_state["idempotency"] := {"k1": {"source": "cache"}}
	result := run_workflow(workflow, run_state, registry, {
		"auto_approve": true, "interactive": false, "command_name": "test"
	})
	final_state := result["run_state"]
	assert_true(dict_get_or(result, "ok", false))
	assert_equal(final_state["status"], "completed")
	# Cache hit: the cached output is used and the live tool is bypassed.
	assert_equal(final_state["data"]["out"]["source"], "cache")
}

test "dispatch blocks unsafe webhook sink paths and supports cancel-after-step" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	blocked := spawn_process([
		kujo_bin, "run", "dispatch.kujo",
		"demo", "Sink guard", "--yes", "--non-interactive",
		"--output-root", "tests/tmp/sink-guard", "--webhook-sink", "/tmp/evil.jsonl"
	], {"inherit_env": true, "timeout_ms": 120000, "max_output_bytes": 1024 * 1024})
	assert_false(blocked.success)
	combined := to_string(blocked.stdout) + "\n" + to_string(blocked.stderr)
	assert_equal(contains(combined, "Absolute --webhook-sink paths are blocked"), 1)

	cancelled := spawn_process([
		kujo_bin, "run", "dispatch.kujo",
		"demo", "Cancel run", "--yes", "--non-interactive",
		"--output-root", "tests/tmp/cancel-run", "--cancel-after-step", "plan"
	], {"inherit_env": true, "timeout_ms": 120000, "max_output_bytes": 1024 * 1024})
	cancel_combined := to_string(cancelled.stdout) + "\n" + to_string(cancelled.stderr)
	assert_equal(contains(cancel_combined, "workflow_cancelled"), 1)
}

