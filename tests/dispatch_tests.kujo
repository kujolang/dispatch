	run_state := persist_run_state(run_state)

	bundle_path := "tests/tmp/run-bundles/export-bundle.json"
	exported := export_run_bundle(output_root, run_state["run_id"], bundle_path, {})
	assert_true(exported["ok"])
	assert_true(file_exists(bundle_path))

	imported := import_run_bundle("tests/tmp/export-import-target", bundle_path, {})
	assert_true(imported["ok"])
	loaded := load_run_state("tests/tmp/export-import-target", imported["run_id"])
	assert_true(loaded["ok"])
