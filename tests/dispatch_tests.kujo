test "show inspect and doctor json envelopes are consistent" {
	output_root := "tests/tmp/json-envelopes-outputs-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999))
	workflow := create_research_report_workflow("Envelope Topic", true)
	run_state := create_run_state(workflow, {"topic": "Envelope Topic"}, output_root, {
		"auto_approve": true,
		"interactive": false
	})
	run_state["status"] := "completed"
	run_state := persist_run_state(run_state)

	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	show_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"show",
		run_state["run_id"],
		"--output-root",
		output_root,
		"--json"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(show_result.success)
	show_payload := parse_json(to_string(show_result.stdout))
	assert_equal(dict_get_or(show_payload, "command", ""), "show")
	assert_true(dict_get_or(show_payload, "ok", false))
	assert_equal(dict_get_or(show_payload, "output_root", ""), output_root)
	show_contract := dict_get_or(show_payload, "contract", {})
	assert_equal(dict_get_or(show_contract, "artifact_contract_version", 0), 1)
	assert_equal(dict_get_or(dict_get_or(show_contract, "state", {}), "schema_name", ""), "dispatch-run-state")
	assert_equal(dict_get_or(dict_get_or(show_contract, "state", {}), "schema_version", 0), 1)
	assert_equal(dict_get_or(dict_get_or(show_contract, "trace", {}), "schema_name", ""), "dispatch-trace")
	assert_equal(dict_get_or(dict_get_or(show_contract, "trace", {}), "schema_version", 0), 1)
	show_summary := dict_get_or(show_payload, "summary", {})
	assert_equal(dict_get_or(show_summary, "run_id", ""), run_state["run_id"])

	inspect_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"inspect",
		run_state["run_id"],
		"--output-root",
		output_root,
		"--json"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(inspect_result.success)
	inspect_payload := parse_json(to_string(inspect_result.stdout))
	assert_equal(dict_get_or(inspect_payload, "command", ""), "inspect")
	assert_true(dict_get_or(inspect_payload, "ok", false))
	assert_equal(dict_get_or(inspect_payload, "output_root", ""), output_root)
	inspect_contract := dict_get_or(inspect_payload, "contract", {})
	assert_equal(dict_get_or(inspect_contract, "artifact_contract_version", 0), 1)
	assert_equal(dict_get_or(dict_get_or(inspect_contract, "state", {}), "schema_name", ""), "dispatch-run-state")
	assert_equal(dict_get_or(dict_get_or(inspect_contract, "state", {}), "schema_version", 0), 1)
	assert_equal(dict_get_or(dict_get_or(inspect_contract, "trace", {}), "schema_name", ""), "dispatch-trace")
	assert_equal(dict_get_or(dict_get_or(inspect_contract, "trace", {}), "schema_version", 0), 1)
	inspect_summary := dict_get_or(inspect_payload, "summary", {})
	assert_equal(dict_get_or(inspect_summary, "run_id", ""), run_state["run_id"])
	inspect_steps := dict_get_or(inspect_payload, "steps", [])
	assert_true(len(inspect_steps) >= 1)

	doctor_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"doctor",
		"--output-root",
		output_root,
		"--json"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(doctor_result.success)
	doctor_payload := parse_json(to_string(doctor_result.stdout))
	assert_equal(dict_get_or(doctor_payload, "command", ""), "doctor")
	assert_true(dict_get_or(doctor_payload, "ok", false))
	assert_equal(dict_get_or(doctor_payload, "output_root", ""), output_root)
	doctor_runs := dict_get_or(doctor_payload, "runs", [])
	assert_true(len(doctor_runs) >= 1)
	doctor_summary := dict_get_or(doctor_payload, "summary", {})
	assert_true(dict_get_or(doctor_summary, "total_runs", 0) >= 1)
}

test "dispatch run tags persist and runs supports tags filter" {
	output_root := "tests/tmp/runs-tags-filter-outputs-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999))
	workflow := create_research_report_workflow("Tag Topic", true)

	prod_run := create_run_state(workflow, {"topic": "Tag Prod"}, output_root, {
		"auto_approve": true,
		"interactive": false,
		"tags": ["env:prod", "project:dispatch"]
	})
	prod_run["status"] := "completed"
	prod_run := persist_run_state(prod_run)

	dev_run := create_run_state(workflow, {"topic": "Tag Dev"}, output_root, {
		"auto_approve": true,
		"interactive": false,
		"tags": ["env:dev", "project:dispatch"]
	})
	dev_run["status"] := "completed"
	dev_run := persist_run_state(dev_run)

	loaded_prod := load_run_state(output_root, prod_run["run_id"])
	assert_true(loaded_prod["ok"])
	loaded_prod_tags := to_json(dict_get_or(loaded_prod["run_state"], "tags", []))
	assert_equal(contains(loaded_prod_tags, "env:prod"), 1)
	assert_equal(contains(loaded_prod_tags, "project:dispatch"), 1)

	all_runs := list_runs(output_root)
	assert_true(len(all_runs) >= 2)

	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}
	result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"runs",
		"--output-root",
		output_root,
		"--tags",
		"env:prod",
		"--json"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(result.success)
	parsed := parse_json(to_string(result.stdout))
	filters := dict_get_or(parsed, "filters", {})
	filter_tags := to_json(dict_get_or(filters, "tags", []))
	assert_true(contains(filter_tags, "env:prod") >= 0)
	runs := dict_get_or(parsed, "runs", [])
	assert_equal(len(runs), 1)
	matched_tags := dict_get_or(runs[0], "tags", [])
	has_prod := false
	has_dev := false
	for tag in matched_tags {
		if to_string(tag) == "env:prod" {
			has_prod = true
		}
		if to_string(tag) == "env:dev" {
			has_dev = true
		}
	}
	assert_true(has_prod)
	assert_false(has_dev)
	assert_equal(dict_get_or(runs[0], "run_id", ""), prod_run["run_id"])

	assert_true(dict_get_or(load_run_state(output_root, dev_run["run_id"]), "ok", false))
}

test "tool authorization policy supports deny and allow outcomes" {
	default_retry := {
		"max_attempts": 1,
		"base_delay_ms": 0,
		"max_delay_ms": 0,
		"strategy": "none",
		"retry_on_codes": []
	}
	step := create_step("auth_tool_step", "Auth Tool Step", "tool", {
		"tool_name": "timestamp_tool",
		"input_from": ["input"],
		"output_key": "auth_output"
	})
	workflow := create_workflow({
		"id": "tool_auth_workflow",
		"name": "Tool Auth Workflow",
		"description": "Authorization policy checks",
		"input_schema": {"type": "dict"},
		"agents": {},
		"tools": ["timestamp_tool"],
		"steps": [step],
		"memory_config": {},
		"default_retry_policy": default_retry,
		"approval_config": {"auto_approve": true},
		"output_schema": {"type": "dict"}
	})

	deny_state := create_run_state(workflow, {"topic": "Policy deny"}, "tests/tmp/authz-outputs", {
		"auto_approve": true,
		"interactive": false
	})
	registry := register_default_tools("examples/research-report/sources")
	deny_result := run_workflow(workflow, deny_state, registry, {
		"auto_approve": true,
		"interactive": false,
		"command_name": "test_policy_deny",
		"tool_authorization_policy": func(policy_input) {
			return {
				"allow": false,
				"message": "Denied by policy for " + dict_get_or(policy_input, "tool_name", "")
			}
		}
	})
	assert_false(deny_result["ok"])
	assert_equal(deny_result["error"]["code"], "tool_execution_denied")
	trace_events := dict_get_or(dict_get_or(deny_result["run_state"], "trace", {}), "events", [])
	has_policy_denied := false
	for event in trace_events {
		if dict_get_or(event, "type", "") == "policy_denied" {
			has_policy_denied = true
		}
	}
	assert_true(has_policy_denied)
	audit_raw := read_file(mutation_audit_path("tests/tmp/authz-outputs"))
	assert_equal(contains(audit_raw, "\"operation\":\"policy_deny\""), 1)
	assert_equal(contains(audit_raw, "\"command_name\":\"test_policy_deny\""), 1)

	allow_state := create_run_state(workflow, {"topic": "Policy allow"}, "tests/tmp/authz-outputs", {
		"auto_approve": true,
		"interactive": false
	})
	allow_result := run_workflow(workflow, allow_state, registry, {
		"auto_approve": true,
		"interactive": false,
		"tool_authorization_policy": func(policy_input) {
			return true
		}
	})
	assert_true(allow_result["ok"])
	assert_equal(allow_result["run_state"]["status"], "completed")
}

test "run export and import support round trip bundles" {
	output_root := "tests/tmp/export-import-source"
	workflow := create_research_report_workflow("Export Import Topic", true)
	run_state := create_run_state(workflow, {"topic": "Export Import Topic"}, output_root, {
