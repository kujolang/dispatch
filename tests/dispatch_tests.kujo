test "high volume run index listing remains deterministic" {
	output_root := "tests/tmp/index-stress-outputs-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999))
	workflow := create_research_report_workflow("Index Stress Topic", true)
	total_runs := 140
	expected_completed := 0

	i := 0
	while i < total_runs {
		run_topic := "Stress Topic Beta " + to_string(i)
		if i % 2 == 0 {
			run_topic = "Stress Topic Alpha " + to_string(i)
		}

		run_state := create_run_state(workflow, {"topic": run_topic}, output_root, {
			"auto_approve": true,
			"interactive": false,
			"tags": ["env:stress", "batch:" + to_string(i % 5)]
		})

		run_status := "interrupted"
		if i % 3 == 0 {
			run_status = "completed"
			expected_completed = expected_completed + 1
		} else {
			if i % 3 == 1 {
				run_status = "failed"
			}
		}

		run_state["status"] := run_status
		run_state["updated_at"] := "2026-02-01 00:00:" + to_string(1000 + i)
		run_state := persist_run_state(run_state)
		i = i + 1
	}

	first_payload := list_runs_with_diagnostics(output_root)
	first_runs := dict_get_or(first_payload, "runs", [])
	first_diagnostics := dict_get_or(first_payload, "diagnostics", {})
	assert_equal(len(first_runs), total_runs)
	assert_equal(dict_get_or(first_diagnostics, "index_source", ""), "index")
	assert_true(dict_get_or(first_diagnostics, "index_run_count", 0) >= total_runs)

	completed_runs := filter_runs(first_runs, "completed", "", false)
	assert_equal(len(completed_runs), expected_completed)

	page_one := paginate_runs(first_runs, 0, 30)
	page_two := paginate_runs(first_runs, 30, 30)
	assert_equal(len(page_one), 30)
	assert_equal(len(page_two), 30)
	assert_false(dict_get_or(page_one[0], "run_id", "") == dict_get_or(page_two[0], "run_id", ""))

	second_payload := list_runs_with_diagnostics(output_root)
	second_runs := dict_get_or(second_payload, "runs", [])
	assert_equal(len(second_runs), total_runs)

	compare_count := 20
	j := 0
	while j < compare_count {
		assert_equal(dict_get_or(first_runs[j], "run_id", ""), dict_get_or(second_runs[j], "run_id", ""))
		j = j + 1
	}

	catalog := build_run_catalog(first_runs)
	assert_equal(dict_get_or(catalog, "total_runs", 0), total_runs)
	status_counts := dict_get_or(catalog, "status_counts", {})
	assert_equal(dict_get_or(status_counts, "completed", 0), expected_completed)
}

test "trace truncation preserves limits and summary metadata" {
	trace := create_trace("trace-truncation-run", "Trace Truncation Workflow")
	trace := apply_trace_limits(trace, {
		"trace_max_events": 3,
		"trace_max_payload_chars": 80
	})
	i := 0
	while i < 8 {
		trace := append_trace(trace, "step_completed", "step-" + to_string(i), "Completed step", {
			"blob": "abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz"
		})
		i := i + 1
	}
	assert_equal(len(trace["events"]), 3)
	truncation := dict_get_or(trace, "truncated", {})
	assert_true(dict_get_or(truncation, "events_dropped", 0) >= 5)
	assert_true(dict_get_or(trace, "event_count_total", 0) >= 8)
}

test "dispatch runs json exposes filtered and page catalogs" {
	output_root := "tests/tmp/runs-json-catalog-outputs"
	workflow := create_research_report_workflow("Runs Catalog Topic", true)
	i := 0
	while i < 5 {
		run_item := create_run_state(workflow, {"topic": "Runs Catalog " + to_string(i)}, output_root, {
			"auto_approve": true,
			"interactive": false
		})
		run_item["status"] := "completed"
		run_item := persist_run_state(run_item)
		i := i + 1
	}

	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}
	process_result := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"runs",
		"--output-root",
		output_root,
		"--limit",
		"2",
		"--offset",
		"1",
		"--json",
		"--diagnostics"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(process_result.success)
	parsed := parse_json(to_string(process_result.stdout))
	assert_true(has_key(parsed, "page_catalog") == 1)
	assert_true(has_key(parsed, "filtered_catalog") == 1)
	assert_true(has_key(parsed, "diagnostics") == 1)
