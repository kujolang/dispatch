test "strict mutation mode blocks destructive commands unless confirmed" {
	kujo_bin := trim(to_string(env("KUJO_BIN")))
	if kujo_bin == "" {
		kujo_bin = "kujo"
	}

	doctor_blocked := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"doctor",
		"--output-root",
		"tests/tmp/strict-doctor",
		"--write",
		"--strict-mutations"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(doctor_blocked.success)
	doctor_blocked_output := to_string(doctor_blocked.stdout) + "\n" + to_string(doctor_blocked.stderr)
	assert_equal(contains(doctor_blocked_output, "Strict mutation mode blocked doctor --write"), 1)

	doctor_allowed := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"doctor",
		"--output-root",
		"tests/tmp/strict-doctor",
		"--write",
		"--strict-mutations",
		"--confirm-mutation"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(doctor_allowed.success)
	doctor_allowed_output := to_string(doctor_allowed.stdout) + "\n" + to_string(doctor_allowed.stderr)
	assert_equal(contains(doctor_allowed_output, "Strict mutation mode blocked"), 0)

	cleanup_blocked := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"cleanup",
		"--output-root",
		"tests/tmp/strict-cleanup",
		"--apply",
		"--strict-mutations"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(cleanup_blocked.success)
	cleanup_blocked_output := to_string(cleanup_blocked.stdout) + "\n" + to_string(cleanup_blocked.stderr)
	assert_equal(contains(cleanup_blocked_output, "Strict mutation mode blocked cleanup --apply"), 1)

	cleanup_allowed := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"cleanup",
		"--output-root",
		"tests/tmp/strict-cleanup",
		"--apply",
		"--strict-mutations",
		"--confirm-mutation"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_true(cleanup_allowed.success)
	cleanup_allowed_output := to_string(cleanup_allowed.stdout) + "\n" + to_string(cleanup_allowed.stderr)
	assert_equal(contains(cleanup_allowed_output, "Strict mutation mode blocked"), 0)

	import_blocked := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"import-run",
		"--bundle-path",
		"tests/tmp/strict-mode-missing-bundle.json",
		"--strict-mutations"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(import_blocked.success)
	import_blocked_output := to_string(import_blocked.stdout) + "\n" + to_string(import_blocked.stderr)
	assert_equal(contains(import_blocked_output, "Strict mutation mode blocked import-run --bundle-path"), 1)

	import_allowed := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"import-run",
		"--bundle-path",
		"tests/tmp/strict-mode-missing-bundle.json",
		"--strict-mutations",
		"--confirm-mutation"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(import_allowed.success)
	import_allowed_output := to_string(import_allowed.stdout) + "\n" + to_string(import_allowed.stderr)
	assert_equal(contains(import_allowed_output, "Strict mutation mode blocked"), 0)
	assert_equal(contains(import_allowed_output, "Could not read bundle file"), 1)
}

