		kujo_bin = "kujo"
	}
	blocked := spawn_process([
		kujo_bin,
		"run",
		"dispatch.kujo",
		"runs",
		"--output-root",
		"/tmp/dispatch-test"
	], {
		"inherit_env": true,
		"timeout_ms": 120000,
		"max_output_bytes": 1024 * 1024
	})
	assert_false(blocked.success)
