test "plugin registration injects custom tool and agent" {
	workflow := create_research_report_workflow("Plugin topic", true)
	tool_registry := register_default_tools("examples/research-report/sources")

	custom_tool := create_tool(
		"plugin_echo_tool",
		"Echoes plugin payload for integration checks.",
		{"type": "dict"},
		{"type": "dict"},
		func(input_payload, context) {
			return {
				"ok": true,
				"data": {
					"echo": dict_get_or(input_payload, "value", "")
				}
			}
		},
		func(step_input) {
			return {
				"value": dict_get_or(dict_get_or(step_input, "input", {}), "topic", "")
			}
		}
	)
	plugin := create_plugin(
		"sample-plugin",
		{
			"plugin_agent": {
				"id": "plugin_agent",
				"name": "Plugin Agent",
				"purpose": "Runs external plugin logic",
				"instructions": "Return plugin marker",
				"model": {},
				"tools": ["plugin_echo_tool"],
				"handoff_targets": [],
				"output_schema": {"type": "dict"},
				"guardrails": []
			}
		},
		{
			"plugin_agent": func(agent, step_input, run_state, runtime_tool_registry, context) {
				tool_result := call_tool(runtime_tool_registry, "plugin_echo_tool", {
					"value": "plugin-agent-ok"
				}, context)
				return {
					"ok": true,
					"data": {
						"agent": "plugin_agent",
						"tool_echo": dict_get_or(dict_get_or(tool_result, "data", {}), "echo", "")
					}
				}
			}
		},
		[custom_tool]
	)
	plugin_registry := create_plugin_registry()
	plugin_registry := register_plugin(plugin_registry, plugin)
	updated := apply_plugins_to_runtime(workflow, tool_registry, plugin_registry)
	workflow := updated["workflow"]
	tool_registry := updated["tool_registry"]

	assert_equal(has_key(workflow["agents"], "plugin_agent"), 1)
	assert_equal(has_key(tool_registry, "plugin_echo_tool"), 1)

	tool_check := call_tool(tool_registry, "plugin_echo_tool", {
		"value": "plugin-tool-ok"
	}, {
		"run_id": "plugin-run",
		"input": {"topic": "Plugin topic"},
		"sources_dir": "examples/research-report/sources"
	})
	assert_true(tool_check["ok"])
	assert_equal(tool_check["data"]["echo"], "plugin-tool-ok")

	agent_check := run_agent("plugin_agent", workflow["agents"], {
		"input": {"topic": "Plugin topic"}
	}, {
		"run_id": "plugin-run",
		"input": {"topic": "Plugin topic"}
	}, tool_registry)
	assert_true(agent_check["ok"])
	assert_equal(agent_check["data"]["tool_echo"], "plugin-agent-ok")
}

