# ===========================================================================
# Results persistence (last_run.json — item 1.3)
# ===========================================================================

test "run_suite results can be serialized and loaded back" {
	try {
		write_file(".eval_test_config.json", "{\"name\":\"roundtrip-suite\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}

	results := run_suite(".eval_test_config.json", {})

	results_json := to_json(results)
	loaded := parse_json(results_json)

	assert_equal(loaded["suite_name"], "roundtrip-suite")
	assert_true(loaded["total"] >= 1)

	try {
		remove_file(".eval_test_config.json")
	} except err {}
}

test "run_suite results saved to file can be loaded for reporting" {
	try {
		write_file(".eval_test_config2.json", "{\"name\":\"persist-suite\",\"tests\":[{\"name\":\"p1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}

	results := run_suite(".eval_test_config2.json", {})
	results_json := to_json(results)

	try {
		create_dir(".eval_test_output")
	} except err {}
	write_file(".eval_test_output/last_run.json", results_json)

	raw := read_file(".eval_test_output/last_run.json")
	cached := parse_json(raw)
	assert_equal(cached["suite_name"], "persist-suite")
	assert_equal(cached["total"], 1)

	try {
		remove_file(".eval_test_output/last_run.json")
		remove_file(".eval_test_output")
		remove_file(".eval_test_config2.json")
	} except err {}
}

# ===========================================================================
# HTML report format (item 6.4.6)
# ===========================================================================

test "generate_html_report produces valid HTML structure" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "html-test",
		"passed": 2,
		"failed": 1,
		"skipped": 0,
		"total": 3,
		"duration_ms": 42,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t2", "check": "command_succeeds", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t3", "check": "command_fails", "passed": false, "skipped": false, "message": "expected failure", "details": {"command": "echo hi", "exit_code": 0}}
		]
	}

	html := generate_html_report(mock)

	assert_true(contains(html, "<!DOCTYPE html>") == true)
	assert_true(contains(html, "<html") == true)
	assert_true(contains(html, "<head>") == true)
	assert_true(contains(html, "<body>") == true)
	assert_true(contains(html, "</html>") == true)
}

test "generate_html_report contains suite name in title" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "html-title-test",
		"passed": 1,
		"failed": 0,
		"skipped": 0,
		"total": 1,
		"duration_ms": 10,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	}

	html := generate_html_report(mock)
	assert_true(contains(html, "html-title-test") == true)
	assert_true(contains(html, "<title>Eval Report: html-title-test</title>") == true)
}

test "generate_html_report shows pass/fail counts in summary cards" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "counts-test",
		"passed": 3,
		"failed": 2,
		"skipped": 1,
		"total": 6,
		"duration_ms": 100,
		"test_results": []
	}

	html := generate_html_report(mock)
	assert_true(contains(html, ">3<") == true)
	assert_true(contains(html, ">2<") == true)
	assert_true(contains(html, ">1<") == true)
}

test "generate_html_report shows test names in results table" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "names-test",
		"passed": 1,
		"failed": 0,
		"skipped": 0,
		"total": 1,
		"duration_ms": 5,
		"test_results": [
			{"name": "unique-test-name-xyz", "check": "command_succeeds", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	}

	html := generate_html_report(mock)
	assert_true(contains(html, "unique-test-name-xyz") == true)
}

test "generate_html_report with all passes shows success styling" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "all-pass",
		"passed": 2,
		"failed": 0,
		"skipped": 0,
		"total": 2,
		"duration_ms": 20,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}},
			{"name": "t2", "check": "command_succeeds", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	}

	html := generate_html_report(mock)
	assert_true(contains(html, "ALL PASSED") == true)
	assert_true(contains(html, "row-fail") == false)
}

test "generate_html_report with failures shows collapsible details" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "fail-test",
		"passed": 0,
		"failed": 1,
		"skipped": 0,
		"total": 1,
		"duration_ms": 15,
		"test_results": [
			{"name": "failing-test", "check": "command_fails", "passed": false, "skipped": false, "message": "command succeeded unexpectedly", "details": {"command": "echo ok", "exit_code": 0, "diff": "-expected\n+actual"}}
		]
	}

	html := generate_html_report(mock)
	assert_true(contains(html, "<details>") == true)
	assert_true(contains(html, "<summary>") == true)
	assert_true(contains(html, "Failure details") == true)
	assert_true(contains(html, "failing-test") == true)
	assert_true(contains(html, "<pre>") == true)
	assert_true(contains(html, "-expected") == true)
	assert_true(contains(html, "+actual") == true)
}

test "generate_html_report escapes HTML in test names" {
	from src.report import generate_html_report

	mock := {
		"suite_name": "escape-test",
		"passed": 1,
		"failed": 0,
		"skipped": 0,
		"total": 1,
		"duration_ms": 5,
		"test_results": [
			{"name": "test <script>alert('xss')</script>", "check": "file_exists", "passed": true, "skipped": false, "message": "ok", "details": {}}
		]
	}

	html := generate_html_report(mock)
	assert_true(contains(html, "<script>") == false)
	assert_true(contains(html, "&lt;script&gt;") == true)
}

