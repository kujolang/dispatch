test "file_matches_regex rejects empty pattern" {
	from src.checks import check_file_matches_regex

	result := check_file_matches_regex({"path": "kennel.toml", "pattern": ""})
	assert_false(result["ok"])
}

test "file_matches_regex matches file content" {
	from src.checks import check_file_matches_regex

	try { write_file(".eval_regex_test.txt", "hello 123 world") } except err {}
	result := check_file_matches_regex({"path": ".eval_regex_test.txt", "pattern": "[0-9]+"})
	assert_true(result["ok"])
	try { remove_file(".eval_regex_test.txt") } except err {}
}

test "file_matches_regex detects non-match" {
	from src.checks import check_file_matches_regex

	try { write_file(".eval_regex_test2.txt", "hello world") } except err {}
	result := check_file_matches_regex({"path": ".eval_regex_test2.txt", "pattern": "[0-9]+"})
	assert_false(result["ok"])
	try { remove_file(".eval_regex_test2.txt") } except err {}
}

test "file_matches_regex is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("file_matches_regex", {"path": "", "pattern": ""})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "file_matches_regex")
}

test "file_matches_regex is registered in KNOWN_CHECKS" {
	from src.config import KNOWN_CHECKS

	checks := KNOWN_CHECKS()
	found := false
	i := 0
	while i < len(checks) {
		if checks[i] == "file_matches_regex" { found = true }
		i := i + 1
	}
	assert_true(found)
}

# ===========================================================================
# check_command_timing_less_than (A.4)
# ===========================================================================

test "command_timing_less_than rejects empty command" {
	from src.checks import check_command_timing_less_than

	result := check_command_timing_less_than({"command": "", "max_ms": 1000})
	assert_false(result["ok"])
}

test "command_timing_less_than passes fast command" {
	from src.checks import check_command_timing_less_than

	result := check_command_timing_less_than({"command": "echo hi", "max_ms": 5000})
	assert_true(result["ok"])
}

test "command_timing_less_than fails slow command (tight budget)" {
	from src.checks import check_command_timing_less_than

	result := check_command_timing_less_than({"command": "echo hi", "max_ms": 0})
	assert_false(result["ok"])
}

test "command_timing_less_than is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("command_timing_less_than", {"command": "", "max_ms": 100})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "command_timing_less_than")
}

test "command_timing_less_than records elapsed_ms" {
	from src.checks import check_command_timing_less_than

	result := check_command_timing_less_than({"command": "echo hi", "max_ms": 5000})
	result_data := dict_get_or(result, "data", {})
	assert_true(dict_get_or(result_data, "elapsed_ms", -1) >= 0)
}

# ===========================================================================
# check_file_line_count (A.5)
# ===========================================================================

test "file_line_count rejects empty path" {
	from src.checks import check_file_line_count

	result := check_file_line_count({"path": "", "expected": 5})
	assert_false(result["ok"])
}

test "file_line_count counts lines correctly" {
	from src.checks import check_file_line_count

	try { write_file(".eval_lines_test.txt", "line1\nline2\nline3\n") } except err {}
	result := check_file_line_count({"path": ".eval_lines_test.txt", "expected": 4, "comparison": "equals"})
	assert_true(result["ok"])
	try { remove_file(".eval_lines_test.txt") } except err {}
}

test "file_line_count supports greater_than comparison" {
	from src.checks import check_file_line_count

	try { write_file(".eval_lines_test2.txt", "a\nb\nc\n") } except err {}
	result := check_file_line_count({"path": ".eval_lines_test2.txt", "expected": 2, "comparison": "greater_than"})
	assert_true(result["ok"])
	try { remove_file(".eval_lines_test2.txt") } except err {}
}

test "file_line_count is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("file_line_count", {"path": "", "expected": 0})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "file_line_count")
}

# ===========================================================================
# check_directory_contains (A.6)
# ===========================================================================

test "directory_contains rejects empty dir" {
	from src.checks import check_directory_contains

	result := check_directory_contains({"dir": "", "pattern": ".ruff"})
	assert_false(result["ok"])
}

test "directory_contains finds matching files" {
	from src.checks import check_directory_contains

	result := check_directory_contains({"dir": "src", "pattern": ".ruff", "min_files": 1})
	assert_true(result["ok"])
}

test "directory_contains fails when too few matches" {
	from src.checks import check_directory_contains

	result := check_directory_contains({"dir": "src", "pattern": "nonexistent_xyz", "min_files": 1})
	assert_false(result["ok"])
}

test "directory_contains is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("directory_contains", {"dir": "", "pattern": ""})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "directory_contains")
}

# ===========================================================================
# check_two_files_equal (A.7)
# ===========================================================================

test "two_files_equal rejects missing path_a" {
	from src.checks import check_two_files_equal

	result := check_two_files_equal({"path_a": "", "path_b": "kennel.toml"})
	assert_false(result["ok"])
}

test "two_files_equal detects identical files" {
	from src.checks import check_two_files_equal

	try { write_file(".eval_eq_a.txt", "same content"); write_file(".eval_eq_b.txt", "same content") } except err {}
	result := check_two_files_equal({"path_a": ".eval_eq_a.txt", "path_b": ".eval_eq_b.txt"})
	assert_true(result["ok"])
	try { remove_file(".eval_eq_a.txt"); remove_file(".eval_eq_b.txt") } except err {}
}

test "two_files_equal detects different files" {
	from src.checks import check_two_files_equal

	try { write_file(".eval_diff_a.txt", "content A"); write_file(".eval_diff_b.txt", "content B") } except err {}
	result := check_two_files_equal({"path_a": ".eval_diff_a.txt", "path_b": ".eval_diff_b.txt"})
	assert_false(result["ok"])
	try { remove_file(".eval_diff_a.txt"); remove_file(".eval_diff_b.txt") } except err {}
}

test "two_files_equal is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("two_files_equal", {"path_a": "", "path_b": ""})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "two_files_equal")
}
