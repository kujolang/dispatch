	result := check_http_body_contains({"url": "http://example.com", "expected": ""})
	assert_false(result["ok"])
}

test "http_body_contains is registered in KNOWN_CHECKS" {
	from src.config import KNOWN_CHECKS

	checks := KNOWN_CHECKS()
	found := false
	i := 0
	while i < len(checks) {
		if checks[i] == "http_body_contains" { found = true }
		i := i + 1
	}
	assert_true(found)
}

test "http_body_contains is dispatched by run_check" {
	from src.checks import run_check

	result := run_check("http_body_contains", {"url": "", "expected": "test"})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "http_body_contains")
}

