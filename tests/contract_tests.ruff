# Contract tests for Kujo Eval.
#
# Validates the exported API surface, check behaviors, config
# loading/validation, snapshot mechanics, and report generation.

test_setup {
	from src.eval_core import run_suite, compare_runs, contract_version
	from src.config import load_config, validate_config, init_config, KNOWN_CHECKS
	from src.checks import run_check, check_command_succeeds, check_command_fails
	from src.checks import check_file_exists, check_file_does_not_exist
	from src.checks import check_file_contains, check_file_does_not_contain
	from src.checks import check_output_contains, check_output_does_not_contain
	from src.checks import check_json_matches_shape, check_exit_code_equals
	from src.checks import check_directory_diff, check_snapshot_matches, run_shell, run_shell_timed
	from src.checks import check_file_matches_glob, check_output_matches_glob, check_json_value_equals, check_file_size_greater_than
	from src.snapshot import save_snapshot, compare_snapshot, list_snapshots, delete_snapshot
	from src.report import generate_markdown_report, generate_junit_report, generate_tap_report, save_report, print_report
	from src.common import make_result, make_success_result, make_error_result, contains_text
}

# ===========================================================================
# Contract version
# ===========================================================================

test "contract version is exported" {
	version := contract_version()
	assert_equal(version, "2.0.0")
}

# ===========================================================================
# Standard result envelope (item 3.4.1)
# ===========================================================================

test "make_success_result returns ok=true with empty error" {
	result := make_success_result({"key": "value"})
	assert_true(result["ok"])
	assert_equal(result["error"], "")
	assert_equal(result["data"]["key"], "value")
}

test "make_error_result returns ok=false with error message" {
	result := make_error_result("something failed", {"detail": "info"})
	assert_false(result["ok"])
	assert_equal(result["error"], "something failed")
	assert_equal(result["data"]["detail"], "info")
}

test "make_result handles empty data dict" {
	result := make_result(true, "", {})
	assert_true(result["ok"])
}

test "contains_text handles start and middle matches" {
	assert_true(contains_text("prefix-value", "prefix"))
	assert_true(contains_text("abc-prefix-value", "prefix"))
	assert_false(contains_text("abc-value", "prefix"))
}

# ===========================================================================
# Known checks
# ===========================================================================

test "KNOWN_CHECKS returns all check types" {
	checks := KNOWN_CHECKS()
	assert_true(len(checks) > 0)
	assert_true(len(checks) >= 12)
}

# ===========================================================================
# Config validation
# ===========================================================================

test "validate_config rejects empty config" {
	result := validate_config({})
	assert_false(result["ok"])
}

test "validate_config rejects config without name" {
	result := validate_config({"tests": [{"name": "t1", "check": "file_exists", "params": {"path": "eval.json"}}]})
	assert_false(result["ok"])
}

test "validate_config rejects config without tests" {
	result := validate_config({"name": "suite"})
	assert_false(result["ok"])
}

test "validate_config rejects unknown check type" {
	result := validate_config({
		"name": "suite",
		"tests": [{"name": "t1", "check": "nonexistent_check", "params": {}}]
	})
	assert_false(result["ok"])
}

test "validate_config accepts valid config" {
	result := validate_config({
		"name": "valid-suite",
		"description": "A valid suite",
		"tests": [
			{"name": "echo test", "check": "command_succeeds", "params": {"command": "echo hello"}}
		]
	})
	assert_true(result["ok"])
	result_data := dict_get_or(result, "data", {})
	cfg := dict_get_or(result_data, "config", {})
	assert_equal(cfg["name"], "valid-suite")
	assert_equal(len(cfg["tests"]), 1)
}

test "load_config returns error for missing file" {
	result := load_config("./nonexistent_eval_config_12345.json")
	assert_false(result["ok"])
	assert_true(len(result["error"]) > 0)
}

# ===========================================================================
# Check: command_succeeds
# ===========================================================================

test "command_succeeds with simple echo" {
	result := check_command_succeeds({"command": "echo hello"})
	assert_true(result["ok"])
	check_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(check_data, "check", ""), "command_succeeds")
}

test "command_succeeds fails on bad command" {
	result := check_command_succeeds({"command": "exit 1"})
	assert_false(result["ok"])
}

test "command_succeeds fails with empty command" {
	result := check_command_succeeds({"command": ""})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: run_shell (direct tests — item 1.5)
# ===========================================================================

test "run_shell returns ok for valid command" {
	result := run_shell("echo hello")
	assert_true(result["ok"])
	assert_equal(result["exit_code"], 0)
	assert_true(len(result["stdout"]) > 0)
}

test "run_shell captures multi-line output" {
	result := run_shell("echo line1 && echo line2")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "line1") == 1)
	assert_true(contains(result["stdout"], "line2") == 1)
}

test "run_shell captures stderr" {
	result := run_shell("echo error >&2")
	assert_true(result["ok"])
}

test "run_shell returns error for empty command" {
	result := run_shell("")
	assert_false(result["ok"])
	assert_true(len(result["error"]) > 0)
}

test "run_shell handles non-zero exit" {
	result := run_shell("exit 42")
	exit_code := result["exit_code"]
	message := "exit code: " + to_string(exit_code)
	print(message)
}

test "run_shell_timed enforces timeout and returns timeout error" {
	start_ms := time()
	result := run_shell_timed("sleep 2", 50)
	elapsed_ms := time() - start_ms
	assert_false(result["ok"])
	assert_true(contains(result["error"], "timed out") == 1)
	assert_true(elapsed_ms < 1500)
}

test "run_shell returns empty stdout for silent command" {
	result := run_shell("echo -n ''")
	assert_true(result["ok"])
}

# ===========================================================================
# Check: command_fails
# ===========================================================================

test "command_fails with failing command" {
	result := check_command_fails({"command": "exit 2"})
	assert_true(result["ok"])
}

test "command_fails fails when command succeeds" {
	result := check_command_fails({"command": "echo ok"})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: exit_code_equals
# ===========================================================================

test "exit_code_equals matches expected code" {
	result := check_exit_code_equals({"command": "exit 3", "expected": 3})
	assert_true(result["ok"])
}

test "exit_code_equals fails on mismatch" {
	result := check_exit_code_equals({"command": "exit 3", "expected": 0})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: file_exists
# ===========================================================================

test "file_exists finds existing file" {
	result := check_file_exists({"path": "kennel.toml"})
	assert_true(result["ok"])
}

test "file_exists fails for missing file" {
	result := check_file_exists({"path": "./nonexistent_file_xyz_12345.test"})
	assert_false(result["ok"])
}

test "file_exists fails with empty path" {
	result := check_file_exists({"path": ""})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: file_does_not_exist
# ===========================================================================

test "file_does_not_exist passes for missing file" {
	result := check_file_does_not_exist({"path": "./nonexistent_file_xyz_12345.test"})
	assert_true(result["ok"])
}

test "file_does_not_exist fails for existing file" {
	result := check_file_does_not_exist({"path": "kennel.toml"})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: file_contains
# ===========================================================================

test "file_contains finds text in file" {
	try {
		write_file(".eval_test_tmp.txt", "Hello Eval World\nThis is a test file.")
	} except err {}

	result := check_file_contains({"path": ".eval_test_tmp.txt", "expected": "Eval World"})
	assert_true(result["ok"])

	try {
		remove_file(".eval_test_tmp.txt")
	} except err {}
}

test "file_contains fails for missing text" {
	try {
		write_file(".eval_test_tmp.txt", "Hello Eval World")
	} except err {}

	result := check_file_contains({"path": ".eval_test_tmp.txt", "expected": "NONEXISTENT_TEXT_XYZ"})
	assert_false(result["ok"])

	try {
		remove_file(".eval_test_tmp.txt")
	} except err {}
}

test "file_contains fails for missing file" {
	result := check_file_contains({"path": "./nonexistent_file_xyz.test", "expected": "text"})
	assert_false(result["ok"])
	details := dict_get_or(result, "data", {})
	assert_true(contains(to_json(details), "File not found") == 1)
}

# ===========================================================================
# Check: file_does_not_contain
# ===========================================================================

test "file_does_not_contain passes when text absent" {
	try {
		write_file(".eval_test_tmp.txt", "Clean content here")
	} except err {}

	result := check_file_does_not_contain({"path": ".eval_test_tmp.txt", "expected": "BAD_WORD"})
	assert_true(result["ok"])

	try {
		remove_file(".eval_test_tmp.txt")
	} except err {}
}

test "file_does_not_contain fails when text present" {
	try {
		write_file(".eval_test_tmp.txt", "This has BAD_WORD in it")
	} except err {}

	result := check_file_does_not_contain({"path": ".eval_test_tmp.txt", "expected": "BAD_WORD"})
	assert_false(result["ok"])

	try {
		remove_file(".eval_test_tmp.txt")
	} except err {}
}

test "file_does_not_contain passes for missing file branch" {
	result := check_file_does_not_contain({"path": "./definitely_missing_file_abc.xyz", "expected": "needle"})
	assert_true(result["ok"])
	details := dict_get_or(result, "data", {})
	assert_true(contains(to_json(details), "trivially") == 1)
}

# ===========================================================================
# Check: output_contains
# ===========================================================================

test "output_contains finds text in command output" {
	result := check_output_contains({"command": "echo Hello Eval World", "expected": "Eval"})
	assert_true(result["ok"])
}

test "output_contains fails when text not found" {
	result := check_output_contains({"command": "echo Hello", "expected": "NONEXISTENT"})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: output_does_not_contain
# ===========================================================================

test "output_does_not_contain passes when text absent" {
	result := check_output_does_not_contain({"command": "echo Clean Output", "expected": "ERROR"})
	assert_true(result["ok"])
}

test "output_does_not_contain fails when text present" {
	result := check_output_does_not_contain({"command": "echo Found ERROR here", "expected": "ERROR"})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: json_matches_shape
# ===========================================================================

test "json_matches_shape validates required keys" {
	try {
		write_file(".eval_test_json.json", "{\"name\": \"test\", \"version\": \"1.0\", \"extra\": \"field\"}")
	} except err {}

	result := check_json_matches_shape({
		"path": ".eval_test_json.json",
		"required_keys": ["name", "version"]
	})
	assert_true(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "json_matches_shape")
	assert_true(len(dict_get_or(result_data, "message", "")) > 0)

	try {
		remove_file(".eval_test_json.json")
	} except err {}
}

test "json_matches_shape fails for missing keys" {
	try {
		write_file(".eval_test_json.json", "{\"name\": \"test\"}")
	} except err {}

	result := check_json_matches_shape({
		"path": ".eval_test_json.json",
		"required_keys": ["name", "version"]
	})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "json_matches_shape")
	assert_true(len(dict_get_or(result_data, "message", "")) > 0)

	try {
		remove_file(".eval_test_json.json")
	} except err {}
}

test "json_matches_shape handles shape string" {
	try {
		write_file(".eval_test_json.json", "{\"name\": \"test\", \"version\": \"1.0\"}")
	} except err {}

	result := check_json_matches_shape({
		"path": ".eval_test_json.json",
		"shape": "name, version"
	})
	assert_true(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "json_matches_shape")
	assert_true(len(dict_get_or(result_data, "message", "")) > 0)

	try {
		remove_file(".eval_test_json.json")
	} except err {}
}

# ===========================================================================
# Check: directory_diff
# ===========================================================================

test "directory_diff with same directory" {
	try {
		create_dir(".eval_test_dir_a")
		create_dir(".eval_test_dir_b")
		write_file(".eval_test_dir_a/file1.txt", "content")
		write_file(".eval_test_dir_b/file1.txt", "content")
	} except err {}

	result := check_directory_diff({
		"dir_a": ".eval_test_dir_a",
		"dir_b": ".eval_test_dir_b"
	})
	assert_true(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "directory_diff")
	assert_true(len(dict_get_or(result_data, "message", "")) > 0)

	try {
		remove_file(".eval_test_dir_a/file1.txt")
		remove_file(".eval_test_dir_b/file1.txt")
		remove_file(".eval_test_dir_a")
		remove_file(".eval_test_dir_b")
	} except err {}
}

test "directory_diff detects differences" {
	try {
		create_dir(".eval_test_dir_c")
		create_dir(".eval_test_dir_d")
		write_file(".eval_test_dir_c/file1.txt", "content_a")
		write_file(".eval_test_dir_d/file1.txt", "content_b")
	} except err {}

	result := check_directory_diff({
		"dir_a": ".eval_test_dir_c",
		"dir_b": ".eval_test_dir_d"
	})
	assert_false(result["ok"])
	result_data := dict_get_or(result, "data", {})
	assert_equal(dict_get_or(result_data, "check", ""), "directory_diff")
	assert_true(len(dict_get_or(result_data, "message", "")) > 0)

	try {
		remove_file(".eval_test_dir_c/file1.txt")
		remove_file(".eval_test_dir_d/file1.txt")
		remove_file(".eval_test_dir_c")
		remove_file(".eval_test_dir_d")
	} except err {}
}

# ===========================================================================
# Snapshot operations
# ===========================================================================

test "save_snapshot creates a snapshot file" {
	result := save_snapshot(".eval_test_snapshots", "test_snap", "snapshot content v1")
	assert_true(result["ok"])
	assert_true(path_exists(result["path"]) == 1)

	try {
		remove_file(result["path"])
		remove_file(".eval_test_snapshots")
	} except err {}
}

test "compare_snapshot matches identical content" {
	save_snapshot(".eval_test_snapshots", "test_match", "exact content")

	result := compare_snapshot(".eval_test_snapshots", "test_match", "exact content")
	assert_equal(result["match"], 1)

	try {
		remove_file(".eval_test_snapshots/test_match.snap")
		remove_file(".eval_test_snapshots")
	} except err {}
}

test "compare_snapshot detects differences" {
	save_snapshot(".eval_test_snapshots", "test_diff", "expected")

	result := compare_snapshot(".eval_test_snapshots", "test_diff", "actual")
	assert_equal(result["match"], 0)

	try {
		remove_file(".eval_test_snapshots/test_diff.snap")
		remove_file(".eval_test_snapshots")
	} except err {}
}

test "compare_snapshot reports missing snapshot" {
	result := compare_snapshot(".eval_test_snapshots", "nonexistent_snap", "content")
	assert_equal(result["match"], 0)
}

test "list_snapshots returns snapshots" {
	save_snapshot(".eval_test_snapshots", "list_test_1", "c1")

	result := list_snapshots(".eval_test_snapshots")
	assert_true(result["ok"])
	assert_true(result["count"] >= 1)

	try {
		remove_file(".eval_test_snapshots/list_test_1.snap")
		remove_file(".eval_test_snapshots")
	} except err {}
}

test "delete_snapshot removes snapshot" {
	save_snapshot(".eval_test_snapshots", "to_delete", "content")
	file_path := ".eval_test_snapshots/to_delete.snap"

	result := delete_snapshot(".eval_test_snapshots", "to_delete")
	assert_true(result["ok"])
	assert_true(path_exists(file_path) == 0)

	try {
		remove_file(".eval_test_snapshots")
	} except err {}
}

test "check_snapshot_matches with update flag creates snapshot" {
	snap_dir := ".eval_test_snapshots_update"

	result := check_snapshot_matches({
		"name": "cli-help-snap",
		"content": "Usage: my-tool --help\n\nOptions:\n  --verbose",
		"snapshot_dir": snap_dir,
		"update": "true"
	})
	assert_true(result["ok"])
	assert_true(contains(result["message"], "updated") == 1 || contains(result["message"], "Snapshot updated") == 1)

	snap_path := snap_dir + "/cli-help-snap.snap"
	assert_true(path_exists(snap_path) == 1)

	try {
		remove_file(snap_path)
		remove_file(snap_dir)
	} except err {}
}

test "check_snapshot_matches with update flag updates existing snapshot" {
	snap_dir := ".eval_test_snapshots_update2"
	snap_path := snap_dir + "/update-test.snap"

	save_snapshot(snap_dir, "update-test", "old content")

	result := check_snapshot_matches({
		"name": "update-test",
		"content": "new content",
		"snapshot_dir": snap_dir,
		"update": "true"
	})
	assert_true(result["ok"])

	updated_content := read_file(snap_path)
	assert_equal(updated_content, "new content")

	try {
		remove_file(snap_path)
		remove_file(snap_dir)
	} except err {}
}

test "check_snapshot_matches without update compares against stored snapshot" {
	snap_dir := ".eval_test_snapshots_compare"
	save_snapshot(snap_dir, "compare-test", "expected content")

	result := check_snapshot_matches({
		"name": "compare-test",
		"content": "expected content",
		"snapshot_dir": snap_dir
	})
	assert_true(result["ok"])

	result_diff := check_snapshot_matches({
		"name": "compare-test",
		"content": "different content",
		"snapshot_dir": snap_dir
	})
	assert_false(result_diff["ok"])

	try {
		remove_file(snap_dir + "/compare-test.snap")
		remove_file(snap_dir)
	} except err {}
}

# ===========================================================================
# Report generation
# ===========================================================================

test "generate_markdown_report produces valid report" {
	results := {
		"suite_name": "Test Suite",
		"suite_version": "1.0.0",
		"suite_description": "A test suite",
		"passed": 2,
		"failed": 1,
		"skipped": 0,
		"total": 3,
		"duration_ms": 150,
		"timestamp": "2026-01-01T00:00:00Z",
		"test_results": [
			{"name": "test 1", "check": "file_exists", "passed": true, "message": "OK", "details": {}},
			{"name": "test 2", "check": "file_exists", "passed": true, "message": "OK", "details": {}},
			{"name": "test 3", "check": "command_succeeds", "passed": false, "message": "Failed", "details": {"command": "bad"}}
		]
	}

	report := generate_markdown_report(results)
	assert_true(contains(report, "Test Suite") == 1)
	assert_true(contains(report, "2") == 1)
	assert_true(contains(report, "Failed Test Details") == 1)
}

test "generate_markdown_report handles all passed" {
	results := {
		"suite_name": "All Pass Suite",
		"passed": 5,
		"failed": 0,
		"skipped": 0,
		"total": 5,
		"duration_ms": 200,
		"test_results": [
			{"name": "t1", "check": "file_exists", "passed": true, "message": "OK", "details": {}}
		]
	}

	report := generate_markdown_report(results)
	assert_true(contains(report, "ALL PASSED") == 1)
}

test "generate_junit_report conforms to expected structure" {
	fixture := {
		"suite_name": "junit-fixture",
		"passed": 1,
		"failed": 1,
		"skipped": 0,
		"total": 2,
		"duration_ms": 11,
		"test_results": [
			{"name": "junit pass", "check": "file_exists", "passed": true, "message": "OK", "details": {}},
			{"name": "junit fail", "check": "command_succeeds", "passed": false, "message": "boom", "details": {}}
		]
	}

	xml := generate_junit_report(fixture)
	assert_true(contains(xml, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>") == 1)
	assert_true(contains(xml, "<testsuite name=\"junit-fixture\" tests=\"2\" failures=\"1\" skipped=\"0\"") == 1)
	assert_true(contains(xml, "<testcase name=\"junit pass\"") == 1)
	assert_true(contains(xml, "<testcase name=\"junit fail\"") == 1)
	assert_true(contains(xml, "<failure message=\"boom\"/>") == 1)
	assert_true(contains(xml, "</testsuite>") == 1)
}

test "generate_tap_report conforms to expected structure" {
	fixture := {
		"suite_name": "tap-fixture",
		"passed": 2,
		"failed": 1,
		"skipped": 0,
		"total": 3,
		"duration_ms": 9,
		"test_results": [
			{"name": "tap pass one", "check": "file_exists", "passed": true, "message": "OK", "details": {}},
			{"name": "tap pass two", "check": "file_exists", "passed": true, "message": "OK", "details": {}},
			{"name": "tap fail", "check": "command_succeeds", "passed": false, "message": "failed", "details": {}}
		]
	}

	tap := generate_tap_report(fixture)
	assert_true(contains(tap, "1..3") == 1)
	assert_true(contains(tap, "ok 1 - tap pass one") == 1)
	assert_true(contains(tap, "ok 2 - tap pass two") == 1)
	assert_true(contains(tap, "not ok 3 - tap fail") == 1)
	assert_true(contains(tap, "message: failed") == 1)
}

# ===========================================================================
# Compare runs
# ===========================================================================

test "compare_runs detects regression" {
	run_a := {"suite_name": "Run A", "passed": 10, "failed": 2, "total": 12}
	run_b := {"suite_name": "Run B", "passed": 9, "failed": 3, "total": 12}

	result := compare_runs(run_a, run_b)
	assert_true(result["regression"])
	assert_false(result["improvement"])
}

test "compare_runs detects improvement" {
	run_a := {"suite_name": "Run A", "passed": 5, "failed": 5, "total": 10}
	run_b := {"suite_name": "Run B", "passed": 8, "failed": 2, "total": 10}

	result := compare_runs(run_a, run_b)
	assert_false(result["regression"])
	assert_true(result["improvement"])
}

test "compare_runs detects no change" {
	run_a := {"suite_name": "Run A", "passed": 10, "failed": 0, "total": 10}
	run_b := {"suite_name": "Run B", "passed": 10, "failed": 0, "total": 10}

	result := compare_runs(run_a, run_b)
	assert_false(result["regression"])
	assert_false(result["improvement"])
}

# ===========================================================================
# run_check dispatcher
