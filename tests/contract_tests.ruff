# ===========================================================================
# run_suite integration tests (item 8.4)
# ===========================================================================

test "run_suite with stop_on_failure halts after first failure" {
	try {
		write_file(".eval_test_stop.json", "{\"name\":\"stop-suite\",\"stop_on_failure\":true,\"tests\":[{\"name\":\"fail first\",\"check\":\"command_fails\",\"params\":{\"command\":\"echo ok\"}},{\"name\":\"never runs\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}

	results := run_suite(".eval_test_stop.json", {})
	assert_equal(results["total"], 1)
	assert_equal(results["failed"], 1)

	try { remove_file(".eval_test_stop.json") } except err {}
}

test "run_suite counts skipped tests" {
	try {
		write_file(".eval_test_skip.json", "{\"name\":\"skip-suite\",\"tests\":[{\"name\":\"skip me\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"},\"skip\":true},{\"name\":\"run me\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}

	results := run_suite(".eval_test_skip.json", {})
	assert_equal(results["total"], 2)
	assert_equal(results["skipped"], 1)
	assert_equal(results["passed"], 1)

	try { remove_file(".eval_test_skip.json") } except err {}
}

test "run_suite returns error for missing config file" {
