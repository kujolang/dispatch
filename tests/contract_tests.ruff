	assert_false(results["ok"])
}

test "run_suite with hooks executes all tests" {
	try {
		write_file(".eval_test_hooks2.json", "{\"name\":\"hook-suite2\",\"setup\":\"echo start\",\"teardown\":\"echo end\",\"before_each\":\"echo before\",\"after_each\":\"echo after\",\"tests\":[{\"name\":\"h1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}},{\"name\":\"h2\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo test\"}}]}")
	} except err {}

	results := run_suite(".eval_test_hooks2.json", {})
	assert_true(results["ok"])
	assert_equal(results["total"], 2)
	assert_equal(results["passed"], 2)

	try { remove_file(".eval_test_hooks2.json") } except err {}
}

