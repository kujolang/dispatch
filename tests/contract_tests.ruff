test "run_check dispatches to correct handler" {
	result := run_check("file_exists", {"path": "kennel.toml"})
	assert_equal(result["check"], "file_exists")
	assert_true(result["ok"])
}

test "run_check returns error for unknown type" {
	result := run_check("invalid_check_type", {})
	assert_false(result["ok"])
}

# ===========================================================================
# Check: file_matches_glob (item 4.1)
# ===========================================================================

test "file_matches_glob finds matching pattern" {
	try {
		write_file(".eval_test_glob.txt", "SUCCESS: deployment complete")
	} except err {}
	result := check_file_matches_glob({"path": ".eval_test_glob.txt", "pattern": "SUCCESS"})
	assert_true(result["ok"])
	try { remove_file(".eval_test_glob.txt") } except err {}
}

test "file_matches_glob fails for non-matching pattern" {
	try {
		write_file(".eval_test_glob2.txt", "all systems normal")
	} except err {}
	result := check_file_matches_glob({"path": ".eval_test_glob2.txt", "pattern": "ERROR"})
	assert_false(result["ok"])
	try { remove_file(".eval_test_glob2.txt") } except err {}
}

test "file_matches_glob fails for missing file" {
	result := check_file_matches_glob({"path": "./nonexistent_glob_test.txt", "pattern": "text"})
	assert_false(result["ok"])
}

