# ===========================================================================
# Path boundary enforcement (item 2.2)
# ===========================================================================

test "check_file_exists rejects path with .. traversal" {
	result := check_file_exists({"path": "../etc/passwd"})
	assert_false(result["ok"])
	sec_msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(sec_msg, "rejected") == 1 || contains(sec_msg, "traversal") == 1)
}

test "check_file_exists rejects system directory path" {
	result := check_file_exists({"path": "/etc/passwd"})
	assert_false(result["ok"])
}

test "check_file_exists allows safe relative path" {
	result := check_file_exists({"path": "kennel.toml"})
	assert_true(result["ok"])
}

test "check_file_contains rejects path traversal" {
	result := check_file_contains({"path": "../../root/.ssh/id_rsa", "expected": "key"})
	assert_false(result["ok"])
}

test "check_file_contains allows safe file read" {
	try {
		write_file(".eval_sec_test.txt", "safe content")
	} except err {}
	result := check_file_contains({"path": ".eval_sec_test.txt", "expected": "safe"})
	assert_true(result["ok"])
	try {
		remove_file(".eval_sec_test.txt")
	} except err {}
}

test "check_file_exists enforces allowed_paths allowlist" {
	try {
		create_dir(".eval_allowed_paths")
		write_file(".eval_allowed_paths/ok.txt", "ok")
	} except err {}

	allowed := check_file_exists({"path": ".eval_allowed_paths/ok.txt", "allowed_paths": [".eval_allowed_paths/"]})
	assert_true(allowed["ok"])

	blocked := check_file_exists({"path": "kennel.toml", "allowed_paths": [".eval_allowed_paths/"]})
	assert_false(blocked["ok"])

	try {
		remove_file(".eval_allowed_paths/ok.txt")
		remove_file(".eval_allowed_paths")
	} except err {}
}

test "check_file_exists rejects symlink escape outside allowed_paths" {
	try {
		create_dir(".eval_symlink_allowed")
		remove_file(".eval_symlink_allowed/link_outside")
	} except err {}

	link_cmd := run_shell("ln -s ../README.md .eval_symlink_allowed/link_outside")
	assert_true(link_cmd["ok"])

	result := check_file_exists({"path": ".eval_symlink_allowed/link_outside", "allowed_paths": [".eval_symlink_allowed/"]})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "symlink") == 1 || contains(msg, "outside") == 1 || contains(msg, "allowed") == 1)

	try {
		remove_file(".eval_symlink_allowed/link_outside")
		remove_file(".eval_symlink_allowed")
	} except err {}
}

test "check_file_contains rejects symlink escape outside allowed_paths" {
	try {
		create_dir(".eval_symlink_content")
		remove_file(".eval_symlink_content/link_outside")
	} except err {}

	link_cmd := run_shell("ln -s ../README.md .eval_symlink_content/link_outside")
	assert_true(link_cmd["ok"])

	result := check_file_contains({"path": ".eval_symlink_content/link_outside", "expected": "Kujo", "allowed_paths": [".eval_symlink_content/"]})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "symlink") == 1 || contains(msg, "outside") == 1 || contains(msg, "allowed") == 1)

	try {
		remove_file(".eval_symlink_content/link_outside")
		remove_file(".eval_symlink_content")
	} except err {}
}

test "check_file_exists normalizes candidate and allowed paths before allowlist checks" {
	try {
		create_dir(".eval_allowed_paths_norm")
		write_file(".eval_allowed_paths_norm/ok.txt", "ok")
	} except err {}

	allowed := check_file_exists({"path": ".//.eval_allowed_paths_norm//ok.txt", "allowed_paths": ["./.eval_allowed_paths_norm///"]})
	assert_true(allowed["ok"])

	try {
		remove_file(".eval_allowed_paths_norm/ok.txt")
		remove_file(".eval_allowed_paths_norm")
	} except err {}
}

test "check_file_exists treats ./ allowlist as workspace root" {
	result := check_file_exists({"path": "README.md", "allowed_paths": ["./"]})
	assert_true(result["ok"])
}

test "check_file_exists rejects normalized traversal segments" {
	result := check_file_exists({"path": "./.eval_allowed_paths_norm/../kennel.toml", "allowed_paths": [".eval_allowed_paths_norm"]})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "traversal") == 1 || contains(msg, "rejected") == 1)
}

test "run_suite threads suite-level allowed_paths into file checks" {
	try {
		create_dir(".eval_allowed_paths_suite")
		write_file(".eval_allowed_paths_suite/ok.txt", "ok")
		write_file(".eval_allowed_paths_suite.json", "{\"name\":\"allowed-paths-suite\",\"allowed_paths\":[\".eval_allowed_paths_suite/\"],\"tests\":[{\"name\":\"allowed\",\"check\":\"file_exists\",\"params\":{\"path\":\".eval_allowed_paths_suite/ok.txt\"}},{\"name\":\"blocked\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}")
	} except err {}

	results := run_suite(".eval_allowed_paths_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 2)
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "failed", 0), 1)

	try {
		remove_file(".eval_allowed_paths_suite/ok.txt")
		remove_file(".eval_allowed_paths_suite")
		remove_file(".eval_allowed_paths_suite.json")
	} except err {}
}

test "validate_config normalizes stage overlay path policy profile defaults" {
	from src.config import validate_config

	result := validate_config({
		"name": "stage-path-profile-suite",
		"policy_stage_overlays": {
			"release": {}
		},
		"tests": [{"name": "readme", "check": "file_exists", "params": {"path": "README.md"}}]
	})
	assert_true(result["ok"])
	data := dict_get_or(result, "data", {})
	cfg := dict_get_or(data, "config", {})
	overlays := dict_get_or(cfg, "policy_stage_overlays", {})
	release_overlay := dict_get_or(overlays, "release", {})
	assert_equal(dict_get_or(release_overlay, "path_policy_profile", ""), "release-deny-default")
	assert_true(len(dict_get_or(release_overlay, "allowed_paths", [])) > 0)
}

test "run_suite release stage uses deny by default path profile" {
	try {
		write_file(".eval_release_path_profile_suite.json", "{\"name\":\"release-path-profile-suite\",\"policy_profile\":\"local-dev\",\"policy_stage_overlays\":{\"release\":{}},\"tests\":[{\"name\":\"readme\",\"check\":\"file_exists\",\"params\":{\"path\":\"README.md\"}}]}")
	} except err {}

	default_result := run_suite(".eval_release_path_profile_suite.json", {"quiet": true})
	default_data := dict_get_or(default_result, "data", {})
	assert_true(default_result["ok"])
	assert_equal(dict_get_or(default_data, "passed", 0), 1)

	release_result := run_suite(".eval_release_path_profile_suite.json", {"quiet": true, "policy_stage": "release"})
	release_data := dict_get_or(release_result, "data", {})
	assert_true(release_result["ok"])
	assert_equal(dict_get_or(release_data, "failed", 0), 1)

	try { remove_file(".eval_release_path_profile_suite.json") } except err {}
}

test "run_suite stage path profile overlay takes precedence over top level allowlist" {
	try {
		write_file(".eval_stage_path_precedence_suite.json", "{\"name\":\"stage-path-precedence-suite\",\"allowed_paths\":[\"./tests/\"],\"policy_stage_overlays\":{\"ci\":{\"path_policy_profile\":\"ci-restricted\"}},\"tests\":[{\"name\":\"readme\",\"check\":\"file_exists\",\"params\":{\"path\":\"README.md\"}}]}")
	} except err {}

	default_result := run_suite(".eval_stage_path_precedence_suite.json", {"quiet": true})
	default_data := dict_get_or(default_result, "data", {})
	assert_true(default_result["ok"])
	assert_equal(dict_get_or(default_data, "failed", 0), 1)

	ci_result := run_suite(".eval_stage_path_precedence_suite.json", {"quiet": true, "policy_stage": "ci"})
	ci_data := dict_get_or(ci_result, "data", {})
	assert_true(ci_result["ok"])
	assert_equal(dict_get_or(ci_data, "passed", 0), 1)

	try { remove_file(".eval_stage_path_precedence_suite.json") } except err {}
}

test "run_suite appends output and snapshot dirs to non-empty suite allowlist at runtime" {
	try {
		create_dir(".eval_runtime_paths")
		write_file(".eval_runtime_paths/ok.txt", "ok")
		write_file(".eval_runtime_paths_suite.json", "{\"name\":\"runtime-path-suite\",\"allowed_paths\":[\"./tests/\"],\"tests\":[{\"name\":\"output-allowed\",\"check\":\"file_exists\",\"params\":{\"path\":\".eval_runtime_paths/ok.txt\"}}]}")
	} except err {}

	results := run_suite(".eval_runtime_paths_suite.json", {"quiet": true, "output_dir_override": ".eval_runtime_paths", "snapshot_dir_override": ".eval_runtime_paths"})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 1)
	assert_equal(dict_get_or(data, "passed", 0), 1)

	try {
		remove_file(".eval_runtime_paths/ok.txt")
		remove_file(".eval_runtime_paths")
		remove_file(".eval_runtime_paths_suite.json")
	} except err {}
}

test "check_env_var_equals enforces allowed_env_vars allowlist" {
	home_val := env("HOME")
	allowed := check_env_var_equals({"name": "HOME", "expected": home_val, "allowed_env_vars": ["HOME"]})
	assert_true(allowed["ok"])

	blocked := check_env_var_equals({"name": "PATH", "expected": env("PATH"), "allowed_env_vars": ["HOME"]})
	assert_false(blocked["ok"])
	msg := dict_get_or(dict_get_or(blocked, "data", {}), "message", "")
	assert_true(contains(msg, "allowed") == 1)
}

test "run_suite threads suite-level allowed_env_vars into env checks" {
	try {
		write_file(".eval_allowed_env_suite.json", "{\"name\":\"allowed-env-suite\",\"allowed_env_vars\":[\"HOME\"],\"tests\":[{\"name\":\"allowed\",\"check\":\"env_var_equals\",\"params\":{\"name\":\"HOME\",\"expected\":\"" + env("HOME") + "\"}},{\"name\":\"blocked\",\"check\":\"env_var_equals\",\"params\":{\"name\":\"PATH\",\"expected\":\"" + env("PATH") + "\"}}]}")
	} except err {}

	results := run_suite(".eval_allowed_env_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "total", 0), 2)
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_equal(dict_get_or(data, "failed", 0), 1)

	try { remove_file(".eval_allowed_env_suite.json") } except err {}
}

test "check_json_matches_shape rejects system path" {
	result := check_json_matches_shape({"path": "/var/log/system.log", "required_keys": ["test"]})
	assert_false(result["ok"])
}

# ===========================================================================
# Output redaction (item 2.3)
# ===========================================================================

test "run_shell redacts API key from output" {
	result := run_shell("echo 'Authorization: Bearer sk-abc123secret'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "sk-abc123secret") == 0)
}

test "run_shell redacts password from output" {
	result := run_shell("echo 'password=supersecret123'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "supersecret123") == 0)
}

test "run_shell preserves safe output" {
	result := run_shell("echo 'all systems operational'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "operational") == 1)
}

# ===========================================================================
# Config size/depth limits (item 2.4)
# ===========================================================================

test "validate_config rejects too many tests" {
	from src.config import validate_config

	many_tests := []
	ti := 0
	while ti < 1001 {
		many_tests := push(many_tests, {"name": "t" + to_string(ti), "check": "file_exists", "params": {"path": "kennel.toml"}})
		ti := ti + 1
	}

	result := validate_config({"name": "too-many", "tests": many_tests})
	assert_false(result["ok"])
	assert_true(contains(result["error"], "1000") == 1)
}

test "validate_config rejects oversized test name" {
	from src.config import validate_config

	long_name := ""
	ni := 0
	while ni < 10001 {
		long_name = long_name + "x"
		ni := ni + 1
	}

	result := validate_config({"name": "suite", "tests": [{"name": long_name, "check": "file_exists", "params": {"path": "kennel.toml"}}]})
	assert_false(result["ok"])
}

# ===========================================================================
# Additional security edge cases (item 8.3)
# ===========================================================================

test "run_shell rejects shutdown command" {
	result := run_shell("shutdown now")
	assert_false(result["ok"])
}

test "run_shell rejects mkfs command" {
	result := run_shell("mkfs.ext4 /dev/sda")
	assert_false(result["ok"])
}

test "check_file_exists rejects root path" {
	result := check_file_exists({"path": "/root/.ssh/authorized_keys"})
	assert_false(result["ok"])
}

test "check_file_contains rejects /etc/passwd access" {
	result := check_file_contains({"path": "/etc/passwd", "expected": "root"})
	assert_false(result["ok"])
}

test "run_shell redacts Bearer token from stderr" {
	result := run_shell("echo 'Authorization: Bearer token123' >&2")
	assert_true(result["ok"])
	assert_true(contains(result["stderr"], "token123") == 0)
}

test "run_shell redacts token query pattern in stdout" {
	result := run_shell("echo 'https://example.test?token=abcd1234'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "abcd1234") == 0)
	assert_true(contains(result["stdout"], "REDACTED") == 1)
}

test "run_shell redacts api_key pattern in stdout" {
	result := run_shell("echo 'api_key=supersecretkey'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "supersecretkey") == 0)
	assert_true(contains(result["stdout"], "REDACTED") == 1)
}

test "check_output_contains redacts nested JSON token and api_key payloads" {
	result := check_output_contains({"command": "echo '{\"auth\":{\"token\":\"ultraSecretToken\",\"api_key\":\"nestedApiKey\"}}'", "expected": "REDACTED", "redaction_audit_mode": true})
	assert_true(result["ok"])
	details := dict_get_or(dict_get_or(result, "data", {}), "details", {})
	stdout_val := dict_get_or(details, "stdout", "")
	assert_true(contains(stdout_val, "ultraSecretToken") == 0)
	assert_true(contains(stdout_val, "nestedApiKey") == 0)
	assert_true(contains(stdout_val, "REDACTED") == 1)
	assert_true(dict_get_or(details, "redaction_hits", 0) > 0)
	patterns := dict_get_or(details, "redaction_patterns", [])
	assert_true(len(patterns) > 0)
}

test "check_output_contains emits redaction audit metadata when enabled" {
	result := check_output_contains({"command": "echo 'token=abcd1234'", "expected": "REDACTED", "redaction_audit_mode": true})
	assert_true(result["ok"])
	details := dict_get_or(dict_get_or(result, "data", {}), "details", {})
	assert_true(has_key(details, "redaction_hits") == 1)
	assert_true(dict_get_or(details, "redaction_hits", 0) > 0)
	patterns := dict_get_or(details, "redaction_patterns", [])
	assert_true(len(patterns) > 0)
}

test "run_suite threads suite-level redaction_audit_mode into command checks" {
	try {
		write_file(".eval_redaction_audit_suite.json", "{\"name\":\"redaction-audit-suite\",\"redaction_audit_mode\":true,\"tests\":[{\"name\":\"audit\",\"check\":\"output_contains\",\"params\":{\"command\":\"echo token=abc\",\"expected\":\"REDACTED\"}}]}")
	} except err {}

	results := run_suite(".eval_redaction_audit_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	assert_true(results["ok"])
	test_results := dict_get_or(data, "test_results", [])
	first := {}
	if len(test_results) > 0 {
		first = test_results[0]
	}
	details := dict_get_or(first, "details", {})
	assert_true(has_key(details, "redaction_hits") == 1)

	try { remove_file(".eval_redaction_audit_suite.json") } except err {}
}

test "check_output_contains redacts organization specific custom patterns" {
	result := check_output_contains({
		"command": "echo 'internal_secret_abcd1234'",
		"expected": "REDACTED",
		"redaction_audit_mode": true,
		"redact_output_patterns": ["internal_secret_[a-z0-9]+"]
	})
	assert_true(result["ok"])
	details := dict_get_or(dict_get_or(result, "data", {}), "details", {})
	stdout_val := dict_get_or(details, "stdout", "")
	assert_true(contains(stdout_val, "internal_secret_abcd1234") == 0)
	assert_true(contains(stdout_val, "REDACTED") == 1)
	assert_true(dict_get_or(details, "redaction_hits", 0) > 0)
}

test "run_suite threads suite level custom redaction patterns into command checks" {
	try {
		write_file(".eval_custom_redaction_suite.json", "{\"name\":\"custom-redaction-suite\",\"redaction_audit_mode\":true,\"redact_output_patterns\":[\"internal_secret_[a-z0-9]+\"],\"tests\":[{\"name\":\"custom-redaction\",\"check\":\"output_contains\",\"params\":{\"command\":\"echo internal_secret_abcd1234\",\"expected\":\"REDACTED\"}}]}")
	} except err {}

	results := run_suite(".eval_custom_redaction_suite.json", {"quiet": true})
	data := dict_get_or(results, "data", {})
	test_results := dict_get_or(data, "test_results", [])
	first := {}
	if len(test_results) > 0 {
		first = test_results[0]
	}
	details := dict_get_or(first, "details", {})
	stdout_val := dict_get_or(details, "stdout", "")

	assert_true(results["ok"])
	assert_equal(dict_get_or(data, "passed", 0), 1)
	assert_true(contains(stdout_val, "internal_secret_abcd1234") == 0)
	assert_true(contains(stdout_val, "REDACTED") == 1)
	assert_true(dict_get_or(details, "redaction_hits", 0) > 0)

	try { remove_file(".eval_custom_redaction_suite.json") } except err {}
}

test "run_shell redacts bearer token pattern in stdout" {
	result := run_shell("echo 'Authorization: Bearer longtokenvalue'")
	assert_true(result["ok"])
	assert_true(contains(result["stdout"], "longtokenvalue") == 0)
	assert_true(contains(result["stdout"], "REDACTED") == 1)
}

test "output_contains denies command outside allowlist" {
	result := check_output_contains({"command": "ls -la", "expected": "README", "allowed_commands": ["echo"]})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "Command execution failed") == 1 || contains(msg, "rejected") == 1)
}

test "command_stdout_json_path_equals fails on malformed stdout JSON" {
	result := check_command_stdout_json_path_equals({"command": "echo not-json", "json_path": "a.b", "expected": "x"})
	assert_false(result["ok"])
	msg := dict_get_or(dict_get_or(result, "data", {}), "message", "")
	assert_true(contains(msg, "Failed to parse stdout as JSON") == 1)
}

test "two_files_equal enforces allowed_paths policy" {
	try {
		write_file(".eval_sec_two_a.txt", "same")
		write_file(".eval_sec_two_b.txt", "same")
	} except err {}

	result := check_two_files_equal({"path_a": ".eval_sec_two_a.txt", "path_b": ".eval_sec_two_b.txt", "allowed_paths": ["./safe/"]})
	assert_false(result["ok"])

	try {
		remove_file(".eval_sec_two_a.txt")
		remove_file(".eval_sec_two_b.txt")
	} except err {}
}

test "directory_diff enforces allowed_paths policy" {
	try {
		create_dir(".eval_sec_dir_a")
		create_dir(".eval_sec_dir_b")
	} except err {}

	result := check_directory_diff({"dir_a": ".eval_sec_dir_a", "dir_b": ".eval_sec_dir_b", "allowed_paths": ["./safe/"]})
	assert_false(result["ok"])

	try {
		remove_file(".eval_sec_dir_a")
		remove_file(".eval_sec_dir_b")
	} except err {}
}
