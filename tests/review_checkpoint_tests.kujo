test_setup {
    from src.core.state import create_run_state, load_run_state, persist_run_state
    from src.core.runner import run_workflow
    from src.core.checkpoint import publish_review_checkpoint, validate_review_checkpoint
    from tests.control_boundary_fixtures import control_workflow, control_run_options, control_registry

    func paused_checkpoint_run() {
        workflow := control_workflow("gate_fail", [{"when": {"result": "evaluation", "verdict": "fail"}, "decide": {"disposition": "require_intervention", "reason": "Review", "allowed_actions": ["approve_override", "abort"]}}])
        options := control_run_options("tests/tmp/checkpoint-" + uuid_v4())
        state := create_run_state(workflow, {"topic": "checkpoint"}, options["output_root"], options)
        result := run_workflow(workflow, state, control_registry(), options)
        assert_true(result["paused"])
        return result["run_state"]
    }
}

test "checkpoint publication is immutable repeatable and leaves authority unchanged" {
    state := paused_checkpoint_run()
    before := read_file(state["run_dir"] + "/state.json")
    first := publish_review_checkpoint(state["output_root"], state["run_id"])
    assert_true(first["ok"])
    schema := parse_json(read_file("schemas/review-checkpoint-v1.schema.json"))
    assert_true(json_schema_validate(first["checkpoint"], schema)["valid"])
    second := publish_review_checkpoint(state["output_root"], state["run_id"])
    assert_equal(first, second)
    loaded := load_run_state(state["output_root"], state["run_id"])["run_state"]
    assert_true(validate_review_checkpoint(loaded, first["checkpoint"]["checkpoint_id"])["ok"])
    assert_equal(read_file(state["run_dir"] + "/state.json"), before)
    assert_equal(first["checkpoint"]["state_revision"], state["revision"])
    if env("DISPATCH_STATE_BACKEND") == "sqlite" {
        # A stale secondary export is not authoritative in SQLite mode.
        write_file(state["run_dir"] + "/state.json", "{}", true)
        assert_equal(publish_review_checkpoint(state["output_root"], state["run_id"]), first)
    }
}

test "missing or altered checkpoint bytes never authorize continuation" {
    state := paused_checkpoint_run()
    checkpoint := publish_review_checkpoint(state["output_root"], state["run_id"])
    loaded := load_run_state(state["output_root"], state["run_id"])["run_state"]
    id := checkpoint["checkpoint"]["checkpoint_id"]
    manifest := read_file(state["run_dir"] + "/" + checkpoint["checkpoint_ref"])
    write_file(state["run_dir"] + "/" + checkpoint["checkpoint_ref"], "{}", true)
    assert_equal(validate_review_checkpoint(loaded, id)["error"]["code"], "checkpoint_manifest_mismatch")
    write_file(state["run_dir"] + "/" + checkpoint["checkpoint_ref"], manifest, true)
    write_file(state["run_dir"] + "/" + checkpoint["checkpoint"]["state_ref"], "{}", true)
    assert_equal(validate_review_checkpoint(loaded, id)["error"]["code"], "checkpoint_state_mismatch")
    assert_false(publish_review_checkpoint(state["output_root"], state["run_id"])["ok"])
    assert_equal(validate_review_checkpoint(loaded, "../../state.json")["error"]["code"], "invalid_checkpoint_id")
}

test "checkpoint refuses changed revision or in-flight work" {
    state := paused_checkpoint_run()
    checkpoint := publish_review_checkpoint(state["output_root"], state["run_id"])
    loaded := load_run_state(state["output_root"], state["run_id"])["run_state"]
    invalid := loaded
    boundary := invalid["current_control_boundary"]; boundary["schema"] := "unknown"; invalid["current_control_boundary"] := boundary
    assert_equal(validate_review_checkpoint(invalid, checkpoint["checkpoint"]["checkpoint_id"])["error"]["code"], "checkpoint_boundary_not_ready")
    input := loaded["input"]; input["changed"] := true; loaded["input"] := input
    assert_equal(validate_review_checkpoint(loaded, checkpoint["checkpoint"]["checkpoint_id"])["error"]["code"], "stale_checkpoint")
    steps := loaded["steps"]; step := steps[1]; step["status"] := "running"; steps[1] := step; loaded["steps"] := steps
    assert_equal(validate_review_checkpoint(loaded, checkpoint["checkpoint"]["checkpoint_id"])["error"]["code"], "checkpoint_boundary_not_ready")
    loaded = persist_run_state(loaded)
    assert_false(publish_review_checkpoint(loaded["output_root"], loaded["run_id"])["ok"])
}

test "orphan and torn journal prohibit checkpoint publication" {
    state := paused_checkpoint_run()
    sequence := state["control_journal"]["sequence"] + 1
    write_file(state["run_dir"] + "/control-records/" + to_string(sequence) + ".json", "{}")
    assert_equal(publish_review_checkpoint(state["output_root"], state["run_id"])["error"]["code"], "control_recovery_required")
    state = paused_checkpoint_run()
    append_file(state["run_dir"] + "/control-events.jsonl", "\n{")
    assert_equal(publish_review_checkpoint(state["output_root"], state["run_id"])["error"]["code"], "control_journal_corrupt")
}
