    calls = [{"id": "policy-call", "type": "function", "function": {"name": "timestamp_tool", "arguments": "{}"}}]
}
print(to_json({"ok": true, "provider": "fixture", "model": "policy-fixture", "output_text": "done", "tool_calls": calls, "usage": {"total_tokens": 1}}))
