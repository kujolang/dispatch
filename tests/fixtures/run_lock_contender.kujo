from src.core.state import acquire_run_lock

values := args()
result := acquire_run_lock({"run_dir": values[0], "run_id": "run-contender"})
print(to_json(result))
if result["ok"] {
	# Keep the process-owned lock alive longer than contenders' bounded wait.
	# Exiting without an explicit unlock exercises crash-style auto-release.
	sleep(1000)
}
