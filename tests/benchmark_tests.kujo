# Micro-benchmark tests for Kujo Eval.
#
# Measures execution time for common check operations to catch
# performance regressions. Not a precision benchmark — wall-clock
# timing via time() is used.
#
# Baseline snapshot (2026-05-25):
# - Suite runtime in dual mode: ~13-22ms
# - Suite runtime in interpreter mode: ~30-65ms
# Thresholds below keep broad CI variance headroom while still
# detecting order-of-magnitude regressions.

test_setup {
	from src.checks import check_file_exists, check_command_succeeds, check_output_contains
	from src.checks import check_file_contains, check_json_matches_shape
	from src.checks import run_check
	from src.eval_core import run_suite
	from src.common import dict_get_or

	func run_bench(check_func, params, iterations) {
		total_ms := 0
		ri := 0
		while ri < iterations {
			start := time()
			result := check_func(params)
			elapsed := time() - start
			total_ms = total_ms + elapsed
			ri := ri + 1
		}
		return total_ms
	}

	func write_file_replace(path, content) {
		tmp_path := path + ".tmp"
		bak_path := path + ".bak"

		try { remove_file(tmp_path) } except err {}
		write_file(tmp_path, content)

		if path_exists(path) {
			try { rename_file(path, bak_path) } except err {}
		}

		rename_file(tmp_path, path)
		try { remove_file(bak_path) } except err {}
	}

	func record_benchmark(metric_name, duration_ms, iterations, threshold_ms) {
		artifact_path := env("KUJO_EVAL_BENCHMARK_ARTIFACT_PATH")
		if type(artifact_path) != "string" || trim(artifact_path) == "" {
			artifact_dir := "./eval_results"
			try { create_dir(artifact_dir) } except err {}
			artifact_path = artifact_dir + "/benchmarks.json"
		}

		payload := {
			"benchmarks": [],
			"updated_at_ms": time()
		}

		if path_exists(artifact_path) {
			try {
				existing_raw := read_file(artifact_path)
				existing_payload := parse_json(existing_raw)
				if type(existing_payload) == "dict" {
					payload = existing_payload
				}
			} except err {}
		}

		entries := dict_get_or(payload, "benchmarks", [])
		if type(entries) != "array" {
			entries = []
		}

		entries = push(entries, {
			"name": metric_name,
			"duration_ms": duration_ms,
			"iterations": iterations,
			"threshold_ms": threshold_ms,
			"recorded_at_ms": time()
		})

		payload["benchmarks"] = entries
		payload["updated_at_ms"] = time()
		payload["count"] = len(entries)

		write_file_replace(artifact_path, to_json(payload))
	}

	func cleanup_output_dir(path) {
		try { remove_file(path + "/eval-report.md") } except err {}
		try { remove_file(path + "/last_run.json") } except err {}
		try { remove_file(path + "/history.json") } except err {}
		try { remove_file(path + "/badge.json") } except err {}
		try { remove_file(path + "/last_failures.json") } except err {}
		try { remove_file(path + "/summary.json") } except err {}
		try { remove_file(path + "/cli-summary.json") } except err {}
		try { remove_file(path + "/artifact-manifest.json") } except err {}
		try { remove_file(path) } except err {}
	}

	func run_suite_bench(config_path, output_dir) {
		start := time()
		result := run_suite(config_path, {"quiet": true, "output_dir_override": output_dir})
		duration := time() - start
		data := dict_get_or(result, "data", {})
		failed := dict_get_or(data, "failed", 0)
		return {
			"ok": result["ok"],
			"failed": failed,
			"duration_ms": duration
		}
	}
}

# ===========================================================================
# File existence check benchmarks
# ===========================================================================

test "bench: file_exists on existing file under 100ms for 10 iterations" {
	total := run_bench(check_file_exists, {"path": "kennel.toml"}, 10)
	print("file_exists x10: " + to_string(total) + "ms")
	record_benchmark("file_exists_existing_x10", total, 10, 400)
	assert_true(total < 400)
}

test "bench: file_exists on missing file under 100ms for 10 iterations" {
	total := run_bench(check_file_exists, {"path": "./nonexistent_bench_xyz.txt"}, 10)
	print("file_exists(missing) x10: " + to_string(total) + "ms")
	record_benchmark("file_exists_missing_x10", total, 10, 400)
	assert_true(total < 400)
}

# ===========================================================================
# Command check benchmarks
# ===========================================================================

test "bench: command_succeeds with echo under 500ms for 10 iterations" {
	total := run_bench(check_command_succeeds, {"command": "echo hello"}, 10)
	print("command_succeeds x10: " + to_string(total) + "ms")
	record_benchmark("command_succeeds_x10", total, 10, 2500)
	assert_true(total < 2500)
}

test "bench: output_contains under 500ms for 10 iterations" {
	total := run_bench(check_output_contains, {"command": "echo hello world", "expected": "hello"}, 10)
	print("output_contains x10: " + to_string(total) + "ms")
	record_benchmark("output_contains_x10", total, 10, 2500)
	assert_true(total < 2500)
}

# ===========================================================================
# File content check benchmarks
# ===========================================================================

test "bench: file_contains on small file under 100ms for 10 iterations" {
	try { write_file(".eval_bench_small.txt", "hello world test content") } except err {}
	total := run_bench(check_file_contains, {"path": ".eval_bench_small.txt", "expected": "test"}, 10)
	print("file_contains x10: " + to_string(total) + "ms")
	record_benchmark("file_contains_small_x10", total, 10, 400)
	assert_true(total < 400)
	try { remove_file(".eval_bench_small.txt") } except err {}
}

# ===========================================================================
# JSON check benchmarks
# ===========================================================================

test "bench: json_matches_shape under 100ms for 10 iterations" {
	try { write_file(".eval_bench_json.json", "{\"key1\":\"val1\",\"key2\":42}") } except err {}
	total := run_bench(check_json_matches_shape, {"path": ".eval_bench_json.json", "required_keys": ["key1", "key2"]}, 10)
	print("json_matches_shape x10: " + to_string(total) + "ms")
	record_benchmark("json_matches_shape_x10", total, 10, 400)
	assert_true(total < 400)
	try { remove_file(".eval_bench_json.json") } except err {}
}

# ===========================================================================
# run_check dispatch benchmark
# ===========================================================================

test "bench: run_check dispatch under 100ms for 10 iterations" {
	start := time()
	ri := 0
	while ri < 10 {
		result := run_check("file_exists", {"path": "kennel.toml"})
		ri := ri + 1
	}
	total := time() - start
	print("run_check dispatch x10: " + to_string(total) + "ms")
	record_benchmark("run_check_dispatch_x10", total, 10, 600)
	assert_true(total < 600)
}

test "bench: run_check full flow under 500ms for 10 iterations" {
	start := time()
	ri := 0
	while ri < 10 {
		result := run_check("command_succeeds", {"command": "echo bench"})
		ri := ri + 1
	}
	total := time() - start
	print("run_check full x10: " + to_string(total) + "ms")
	record_benchmark("run_check_full_x10", total, 10, 2500)
	assert_true(total < 2500)
}

test "bench: benchmark artifact is written" {
	artifact_path := "./eval_results/benchmarks.json"
	assert_true(path_exists(artifact_path))
	raw := read_file(artifact_path)
	data := parse_json(raw)
	assert_true(type(data) == "dict")
	entries := dict_get_or(data, "benchmarks", [])
	assert_true(type(entries) == "array")
	assert_true(len(entries) >= 1)
}

test "bench: medium fixture suite runtime under budget" {
	output_dir := ".eval_bench_medium_suite_out"
	cleanup_output_dir(output_dir)

	b := run_suite_bench("examples/release_gate_suite.json", output_dir)
	assert_true(dict_get_or(b, "ok", false))

	duration := dict_get_or(b, "duration_ms", 0)
	record_benchmark("medium_fixture_suite_x1", duration, 1, 3000)
	assert_true(duration < 3000)

	cleanup_output_dir(output_dir)
}

test "bench: large fixture suite runtime under budget" {
	output_dir := ".eval_bench_large_suite_out"
	cleanup_output_dir(output_dir)

	b := run_suite_bench("examples/enterprise_api_contract_gate.json", output_dir)
	assert_true(dict_get_or(b, "ok", false))

	duration := dict_get_or(b, "duration_ms", 0)
	record_benchmark("large_fixture_suite_x1", duration, 1, 8000)
	assert_true(duration < 8000)

	cleanup_output_dir(output_dir)
}

test "bench: io-heavy fixture suite runtime under budget" {
	output_dir := ".eval_bench_io_heavy_suite_out"
	cleanup_output_dir(output_dir)

	b := run_suite_bench("examples/io_heavy_regression_suite.json", output_dir)
	assert_true(dict_get_or(b, "ok", false))

	duration := dict_get_or(b, "duration_ms", 0)
	record_benchmark("io_heavy_fixture_suite_x1", duration, 1, 12000)
	assert_true(duration < 12000)

	cleanup_output_dir(output_dir)
}

test "bench: mixed fixture parallel heuristic runtime under budget" {
	start := time()
	results := run_suite("examples/large_suite_fixture.json", {"quiet": true, "parallel_workers": 8})
	duration := time() - start

	assert_true(results["ok"])
	data := dict_get_or(results, "data", {})
	assert_true(dict_get_or(data, "parallel_requested", false))
	assert_true(dict_get_or(data, "parallel_used", false))

	parallel_mode := dict_get_or(data, "parallel_mode", "")
	assert_true(parallel_mode == "mixed-heuristic" || parallel_mode == "mixed-priority-heuristic")

	record_benchmark("mixed_fixture_parallel_suite_x1", duration, 1, 6000)
	assert_true(duration < 6000)
}

test "bench: cache metrics are emitted and monotonic for repeated paths" {
	try {
		write_file(".eval_cache_metric_payload.txt", "alpha\nbeta\ngamma\nneedle-marker\n")
		write_file(".eval_cache_metric_suite.json", "{\"name\":\"cache-metric-suite\",\"tests\":[{\"name\":\"contains-1\",\"check\":\"file_contains\",\"params\":{\"path\":\".eval_cache_metric_payload.txt\",\"expected\":\"needle\"}},{\"name\":\"contains-2\",\"check\":\"file_contains\",\"params\":{\"path\":\".eval_cache_metric_payload.txt\",\"expected\":\"needle\"}},{\"name\":\"regex-1\",\"check\":\"file_matches_regex\",\"params\":{\"path\":\".eval_cache_metric_payload.txt\",\"pattern\":\"needle-marker\"}},{\"name\":\"line-count\",\"check\":\"file_line_count\",\"params\":{\"path\":\".eval_cache_metric_payload.txt\",\"expected\":2,\"comparison\":\"gt\"}}]}")
	} except err {}

	result := run_suite(".eval_cache_metric_suite.json", {"quiet": true, "parallel_workers": 8})
	assert_true(result["ok"])

	data := dict_get_or(result, "data", {})
	candidates := dict_get_or(data, "cache_metric_candidates", 0)
	unique_files := dict_get_or(data, "cache_metric_unique_files", 0)
	hits := dict_get_or(data, "cache_metric_hits", 0)
	misses := dict_get_or(data, "cache_metric_misses", 0)
	bytes_reused := dict_get_or(data, "cache_metric_bytes_reused", 0)

	assert_true(candidates >= 4)
	assert_true(unique_files >= 1)
	assert_true(hits >= 1)
	assert_true(candidates >= hits)
	assert_true(candidates >= misses)
	assert_true(hits + misses <= candidates)
	assert_true(bytes_reused > 0)

	try { remove_file(".eval_cache_metric_suite.json") } except err {}
	try { remove_file(".eval_cache_metric_payload.txt") } except err {}
}