	workflow := create_workflow({"id": "input-paid-model", "name": "Input Paid Model", "description": "cost", "input_schema": {"type": "dict"}, "agents": {"analyst": agent}, "tools": [], "steps": [create_step("analyze", "Analyze", "agent", {"agent_id": "analyst", "input_from": ["input"], "output_key": "result"})], "memory_config": {}, "default_retry_policy": {"max_attempts": 1, "base_delay_ms": 0, "max_delay_ms": 0, "strategy": "none", "retry_on_codes": []}, "routing": {"enabled": true, "model_catalog": model_catalog}, "budgets": {"max_cost_usd": 0.05}, "approval_config": {"auto_approve": true}, "output_schema": {"type": "dict"}})
