}

test "route evaluation pauses for native human review and resumes stored output" {
	agent := base_agent("reviewer", "review-handler", "review", [{"provider": "fixture", "model": "fixture-model"}])
	agent["uses_model"] := false
	agent["instructions"] := "Review."
	workflow := create_workflow({"id": "human-route-review", "name": "Human Route Review", "description": "review", "input_schema": {"type": "dict"}, "agents": {"reviewer": agent, "__agent_handlers": {"review-handler": func(agent_obj, step_input, run_state, tools, context) { return {"ok": true, "data": {"draft": "candidate"}} }}}, "tools": [], "steps": [create_step("review", "Review", "agent", {"agent_id": "reviewer", "input_from": ["input"], "output_key": "result", "evaluation": {"required_fields": ["approved"], "on_failure": "request_human_review"}})], "memory_config": {}, "default_retry_policy": {"max_attempts": 1, "base_delay_ms": 0, "max_delay_ms": 0, "strategy": "none", "retry_on_codes": []}, "routing": {"enabled": true, "model_catalog": catalog([{"provider": "fixture", "model": "fixture-model", "quality_tier": "fixture", "enabled": true}])}, "approval_config": {"auto_approve": false}, "output_schema": {"type": "dict"}})
	state := create_run_state(workflow, {"topic": "review"}, "tests/tmp/human-route-review", {"auto_approve": false, "interactive": false})
	paused := run_workflow(workflow, state, {}, {"auto_approve": false, "interactive": false})
	assert_true(paused["paused"])
	assert_equal(paused["run_state"]["steps"][0]["output"]["kind"], "route_human_review")
	approval_id := paused["run_state"]["steps"][0]["output"]["approval"]["id"]
	assert_equal(paused["run_state"]["approvals"][0]["id"], approval_id)
	assert_equal(paused["run_state"]["human_intervention"]["security"]["decision_id"], approval_id)
	assert_equal(paused["run_state"]["human_intervention"]["metadata"]["source_approval_id"], approval_id)
	resumed := run_workflow(workflow, paused["run_state"], {}, {"auto_approve": false, "interactive": false, "simulated_decision": "approve", "simulated_note": "approved"})
	assert_true(resumed["ok"])
	assert_equal(resumed["run_state"]["status"], "completed")
	assert_equal(resumed["run_state"]["data"]["result"]["draft"], "candidate")
}
