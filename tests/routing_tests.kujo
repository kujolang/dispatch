	env_set("DISPATCH_OFFLINE_FIXTURE", "")
}

test "generic model handler executes only model-requested tools with bounded idempotent replay" {
	model_invoker := func(agent_obj, prompt, options) {
		if len(options["messages"]) <= 4 {
			return {"ok": true, "provider": "fixture", "model": "tool-model", "output_text": "", "tool_calls": [{"id": "call-stable", "type": "function", "function": {"name": "safe_tool", "arguments": "{\"value\":\"approved\"}"}}], "usage": {"total_tokens": 2}}
		}
		return {"ok": true, "provider": "fixture", "model": "tool-model", "output_text": "complete", "tool_calls": [], "usage": {"total_tokens": 1}}
	}
	tool_handler := func(payload, context) {
		return {"ok": true, "data": {"echo": payload["value"]}}
	}
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool("safe_tool", "Safe test tool", {"type": "dict", "required": ["value"]}, {"type": "dict"}, tool_handler, null))
	agent := base_agent("analyst", "model", "analyze", [])
	agent["output_schema"] := {}
	agent["__model_invoker"] := model_invoker
	agent["model_options"] := {"max_tool_rounds": 3, "max_tool_calls": 2}
	result := model_agent_output(agent, {"input": {"topic": "tools"}}, {"run_id": "run-tool", "workflow_id": "workflow-tool", "status": "running"}, registry, {"step_id": "analyze"})
	assert_true(result["ok"])
	assert_equal(result["tool_call_count"], 1)
	assert_equal(len(result["model_calls"]), 3)
	assert_equal(result["data"]["tool_results"]["call-stable"]["data"]["echo"], "approved")
}

test "generic model handler fails closed when tool authorization denies a request" {
	agent := base_agent("analyst", "model", "analyze", [])
	agent["output_schema"] := {}
	agent["__model_invoker"] := func(agent_obj, prompt, options) { return {"ok": true, "provider": "fixture", "model": "tool-model", "output_text": "", "tool_calls": [{"id": "call-denied", "type": "function", "function": {"name": "safe_tool", "arguments": "{}"}}], "usage": {}} }
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool("safe_tool", "Safe test tool", {"type": "dict"}, {"type": "dict"}, func(payload, context) { return {"ok": true, "data": {}} }, null))
	result := model_agent_output(agent, {}, {"run_id": "run-denied", "workflow_id": "workflow-tool", "status": "running"}, registry, {"step_id": "analyze", "tool_authorization_policy": func(input) { return false }})
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "tool_execution_denied")
}

test "built-in deterministic agent handlers enforce tool authorization" {
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool("mock_web_search", "Search", {"type": "dict"}, {"type": "dict"}, func(payload, context) { return {"ok": true, "data": {"results": []}} }, null))
	agent := base_agent("research", "research", "gather_sources", [])
	result := run_agent_with_agent(agent, "research", {"research": agent}, {"input": {"topic": "denied"}}, {"run_id": "run-built-in-denied", "workflow_id": "workflow-tool", "status": "running", "input": {}}, registry, {"step_id": "research", "tool_authorization_policy": func(input) { return false }})
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "tool_execution_denied")
}

test "generic model handler decrements the total token envelope across rounds" {
	model_invoker := func(agent_obj, prompt, options) {
		if len(options["messages"]) == 2 { return {"ok": true, "provider": "fixture", "model": "bounded", "output_text": "", "tool_calls": [{"id": "budget-call", "function": {"name": "safe_tool", "arguments": "{}"}}], "usage": {"total_tokens": 30}} }
		if options["max_tokens"] >= 100 { return {"ok": false, "error": {"code": "token_envelope_not_decremented", "message": "Second model round reused the initial cap.", "retryable": false}} }
		return {"ok": true, "provider": "fixture", "model": "bounded", "output_text": "done", "tool_calls": [], "usage": {"total_tokens": 10}}
	}
	registry := create_tool_registry()
	registry := register_tool(registry, create_tool("safe_tool", "Safe", {"type": "dict"}, {"type": "dict"}, func(payload, context) { return {"ok": true, "data": {}} }, null))
	agent := base_agent("analyst", "model", "analyze", [])
	agent["output_schema"] := {}
	agent["__model_invoker"] := model_invoker
	result := model_agent_output(agent, {"input": {"topic": "bounded"}}, {"run_id": "run-bounded", "workflow_id": "workflow-bounded", "status": "running"}, registry, {"step_id": "analyze", "model_total_token_budget": 200, "model_max_tokens_cap": 100})
	assert_true(result["ok"])
	assert_equal(len(result["model_calls"]), 2)
}

