test_setup {
    from src.core.intervention import validate_intervention_decision, prepare_intervention_continuation
    from src.core.state import persist_run_state
    from src.core.control_journal import append_control_event
    from src.core.state import create_run_state
    from src.core.runner import run_workflow
    from tests.control_boundary_fixtures import control_workflow, failed_action_registry, control_run_options, passing_gate_registry
}

test "execution failure enters review without running descendants or retrying effects" {
    workflow := control_workflow("failed_action", [{"when": {"result": "execution", "status": "failure"}, "decide": {"disposition": "require_intervention", "reason": "Review partial effects", "allowed_actions": ["abort", "approve_override"]}}])
    workflow["default_retry_policy"] := {"max_attempts": 3, "retry_on_codes": ["fixture_action_failed"]}
    steps := workflow["steps"]
    config := steps[0]["config"]
    config["control_role"] := "action"
    item := steps[0]
    item["config"] := config
    steps[0] := item
    workflow["steps"] := steps
    options := control_run_options("tests/tmp/failure-action-review")
    state := create_run_state(workflow, {"topic": "failure"}, options["output_root"], options)
    result := run_workflow(workflow, state, failed_action_registry(), options)
    assert_true(result["paused"])
    assert_equal(result["run_state"]["steps"][0]["status"], "failed")
    assert_equal(result["run_state"]["steps"][0]["attempts"], 1)
    assert_equal(result["run_state"]["steps"][1]["status"], "pending")
    assert_equal(result["run_state"]["current_control_boundary"]["evaluation_result"]["schema"], "kujo.execution-result/v1")
    request_found := false
    for line in split(read_file(result["run_state"]["run_dir"] + "/control-events.jsonl"), "\n") {
        event := parse_json(line)
        if event["kind"] == "intervention_requested" {
            request_found = true
            assert_equal(event["details"]["request"]["request_id"], result["run_state"]["human_intervention"]["request_id"])
            assert_equal(event["details"]["request"]["allowed_actions"], ["abort", "approve_override"])
            assert_equal(event["details"]["request"]["callback"]["target"], "redacted-transport")
        }
    }
    assert_true(request_found)

}

test "execution failure with no matching policy stops by default" {
    workflow := control_workflow("failed_action", [])
    steps := workflow["steps"]
    config := steps[0]["config"]
    config["control_role"] := "action"
    item := steps[0]
    item["config"] := config
    steps[0] := item
    workflow["steps"] := steps
    options := control_run_options("tests/tmp/failure-action-stop")
    state := create_run_state(workflow, {"topic": "stop"}, options["output_root"], options)
    result := run_workflow(workflow, state, failed_action_registry(), options)
    assert_false(result["ok"])
    assert_equal(result["run_state"]["status"], "failed")
    assert_equal(result["run_state"]["steps"][1]["status"], "pending")
}

test "evaluator crash maps to error review without declaring a quality failure" {
    workflow := control_workflow("failed_action", [{"when": {"result": "evaluation", "evaluation_status": "error"}, "decide": {"disposition": "require_intervention", "reason": "Evaluator unavailable", "allowed_actions": ["retry_evaluation", "abort"]}}])
    steps := workflow["steps"]
    item := steps[0]
    config := item["config"]
    config["control_role"] := "evaluator"
    item["config"] := config
    steps[0] := item
    workflow["steps"] := steps
    options := control_run_options("tests/tmp/evaluator-crash-review")
    state := create_run_state(workflow, {"topic": "crash"}, options["output_root"], options)
    result := run_workflow(workflow, state, failed_action_registry(), options)
    assert_true(result["paused"])
    evaluation := result["run_state"]["current_control_boundary"]["evaluation_result"]
    assert_equal(evaluation["evaluation_status"], "error")
    assert_equal(evaluation["verdict"], "indeterminate")
    assert_equal(evaluation["checks"]["failed"], 0)
}

test "a passed evaluation continues through the same neutral policy path" {
    workflow := control_workflow("gate_pass", [{"when": {"result": "evaluation", "verdict": "pass"}, "decide": {"disposition": "continue", "reason": "Required gate passed"}}])
    options := control_run_options("tests/tmp/failure-gate-pass")
    state := create_run_state(workflow, {"topic": "pass"}, options["output_root"], options)
    result := run_workflow(workflow, state, passing_gate_registry(), options)
    assert_true(result["ok"])
    assert_false(result["paused"])
    assert_equal(result["run_state"]["status"], "completed")
    assert_equal(result["run_state"]["steps"][1]["status"], "completed")
}

test "accepting a failed action continues without replaying its effect" {
    root := "tests/tmp/accepted-failure-" + uuid_v4()
    create_dir(root)
    write_file(root + "/attempts", "0")
    workflow := control_workflow("failed_action", [{"when": {"result": "execution", "status": "failure"}, "decide": {"disposition": "require_intervention", "reason": "Review uncertain effect", "allowed_actions": ["approve_override", "abort"]}}])
    steps := workflow["steps"]
    item := steps[0]
    config := item["config"]
    config["control_role"] := "action"
    item["config"] := config
    steps[0] := item
    workflow["steps"] := steps
    options := control_run_options(root + "/runs")
    first := run_workflow(workflow, create_run_state(workflow, {"attempt_counter": root + "/attempts"}, options["output_root"], options), failed_action_registry(), options)
    assert_true(first["paused"])
    state := first["run_state"]
    request := state["human_intervention"]
    decision := {"schema": "kujo.intervention-decision/v2", "decision_id": "accepted-failure", "request_id": request["request_id"], "boundary_id": request["boundary_id"], "expected_state_revision": state["revision"], "action": "approve_override", "actor": {"id": "fixture", "type": "system", "authenticated_by": "local-test", "authorization": "test:review"}, "reason": "Accept the recorded effect without repeating it", "decided_at": format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")}
    assert_true(validate_intervention_decision(decision, state)["ok"])
    prepared := prepare_intervention_continuation(state, decision)
    assert_true(prepared["ok"])
    state = prepared["run_state"]
    boundary := state["current_control_boundary"]
    boundary["status"] := "closed"
    state["current_control_boundary"] := boundary
    state["control_barrier"] := {"status": "released"}
    state["human_intervention"] := null
    logged := append_control_event(state, "intervention_decided", "gate", [decision["decision_id"]], {"decision": decision})
    resumed := run_workflow(workflow, persist_run_state(logged["run_state"]), failed_action_registry(), options)
    assert_true(resumed["ok"])
    assert_equal(resumed["run_state"]["status"], "completed")
    assert_equal(resumed["run_state"]["steps"][0]["status"], "skipped")
    assert_equal(resumed["run_state"]["steps"][1]["status"], "completed")
    assert_equal(read_file(root + "/attempts"), "1")
}
