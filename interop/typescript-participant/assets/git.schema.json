{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workcell.git-correlation/v1alpha1",
  "type": "object",
  "required": [
    "schema",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "workcell.git-correlation/v1alpha1"
    },
    "values": {
      "type": "object",
      "required": [
        "workcell_effect_id",
        "transaction_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "workcell_effect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "transaction_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  }
}
