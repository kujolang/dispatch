from src.core.utils import dict_get_or
from sdk_adapter import call_agent_model
from src.tools.tool import call_tool
from src.core.errors import missing_agent_error, agent_execution_error

func create_agent(agent_id, name, purpose, instructions, model_config, tools, handoff_targets, output_schema, guardrails) {
	return {
		"id": agent_id,
		"name": name,
		"purpose": purpose,
		"instructions": instructions,
		"model": model_config,
		"model_candidates": [],
		"handler_id": agent_id,
		"execution_contract": {"id": agent_id, "version": "1"},
		"capabilities": {},
		"routing": {},
		"tools": tools,
		"handoff_targets": handoff_targets,
		"output_schema": output_schema,
		"guardrails": guardrails
	}
}

func planner_output(agent, step_input, run_state) {
	topic := dict_get_or(dict_get_or(step_input, "input", {}), "topic", "Unknown topic")
	prompt := "Create a concise research plan for topic: " + topic
	model_result := call_agent_model(agent, prompt, {
		"max_tokens": 180,
		"temperature": 0.1
	})
	if dict_get_or(model_result, "ok", false) == false && dict_get_or(agent, "__routing_enabled", false) {
		return model_result
	}

	plan := {
		"topic": topic,
		"questions": [
			"What problem does the topic solve?",
			"What are the core workflow stages and responsibilities?",
			"What reliability and governance mechanisms are required?",
			"What evidence supports the final recommendations?"
		],
		"source_types": ["technical documentation", "architecture notes", "implementation guides"],
		"expected_sections": ["Summary", "Findings", "Claims", "Evidence", "Limitations"],
		"created_at": format_date(now(), "YYYY-MM-DD HH:mm:ss")
	}

	if dict_get_or(model_result, "ok", false) {
		plan["model_brief"] := dict_get_or(model_result, "output_text", "")
	} else {
		plan["model_brief"] := "Model call unavailable; using deterministic planner output."
	}

	return {
		"ok": true,
		"data": plan,
		"model_calls": [{
			"ok": dict_get_or(model_result, "ok", false),
			"provider": dict_get_or(model_result, "provider", dict_get_or(dict_get_or(agent, "model", {}), "provider", "")),
			"model": dict_get_or(model_result, "model", dict_get_or(dict_get_or(agent, "model", {}), "model", "")),
			"usage": dict_get_or(model_result, "usage", {})
		}]
	}
}

func research_output(agent, step_input, run_state, tool_registry, context) {
	topic := dict_get_or(dict_get_or(step_input, "input", {}), "topic", "")
	search_result := call_tool(tool_registry, "mock_web_search", {"query": topic}, context)
	if dict_get_or(search_result, "ok", false) == false {
		return search_result
	}

	results := dict_get_or(dict_get_or(search_result, "data", {}), "results", [])
	evidence := []
	source_docs := []
	index := 0
	while index < len(results) {
		item := results[index]
		source_id := dict_get_or(item, "source_id", "")
		if source_id != "" {
			lookup_result := call_tool(tool_registry, "local_source_lookup", {"source_id": source_id}, context)
			if dict_get_or(lookup_result, "ok", false) {
				source_docs := push(source_docs, dict_get_or(lookup_result, "data", {}))
			}
		}
		evidence := push(evidence, {
			"source_id": dict_get_or(item, "source_id", "source"),
			"path": dict_get_or(item, "path", ""),
			"snippet": dict_get_or(item, "snippet", ""),
			"score": dict_get_or(item, "score", 0)
		})
		index := index + 1
	}

	return {
		"ok": true,
		"data": {
			"topic": topic,
			"query": topic,
			"results": results,
			"evidence": evidence,
			"source_documents": source_docs,
			"research_note": "Research agent gathered fixture-backed evidence for verification."
		}
	}
}

func verification_output(agent, step_input, run_state, tool_registry, context) {
	sources := dict_get_or(step_input, "sources", {})
	evidence := dict_get_or(sources, "evidence", [])
	claim_bundle := dict_get_or(step_input, "claims", {})
	claims := dict_get_or(claim_bundle, "claims", [])

	verified_claims := []
	key_findings := []
	confidence_notes := []
	index := 0
	for claim in claims {
		status := "supported"
		if index % 4 == 1 {
			status := "weakly_supported"
		}
		if index % 4 == 2 {
			status := "conflicting"
		}
		if index % 4 == 3 {
			status := "unsupported"
		}
		confidence := 0.9
		if status == "weakly_supported" {
			confidence := 0.65
		}
		if status == "conflicting" {
			confidence := 0.45
		}
		if status == "unsupported" {
			confidence := 0.2
		}
		verified := claim
		verified["status"] := status
		verified["confidence"] := confidence
		verified_claims := push(verified_claims, verified)
		key_findings := push(key_findings, dict_get_or(claim, "claim", ""))
		confidence_notes := push(confidence_notes, "Claim " + dict_get_or(claim, "id", to_string(index + 1)) + " marked " + status + " with confidence " + to_string(confidence) + ".")
		index := index + 1
	}

	citations_result := call_tool(tool_registry, "citation_formatter", {"claims": verified_claims}, context)
	citations := []
	if dict_get_or(citations_result, "ok", false) {
		citations := dict_get_or(dict_get_or(citations_result, "data", {}), "citations", [])
	}

	return {
		"ok": true,
		"data": {
			"claims": verified_claims,
			"key_findings": key_findings,
			"confidence_notes": confidence_notes,
			"citations": citations,
			"evidence_count": len(evidence)
		}
	}
}

func writer_output(agent, step_input, run_state, tool_registry, context) {
	topic := dict_get_or(dict_get_or(step_input, "input", {}), "topic", "")
	verification := dict_get_or(step_input, "verification", {})
	claim_bundle := dict_get_or(step_input, "claims", {})
	claims := dict_get_or(claim_bundle, "claims", [])

	writer_tool_result := call_tool(tool_registry, "markdown_report_writer", {
		"topic": topic,
		"verification": verification,
		"claims": claims
	}, context)
	if dict_get_or(writer_tool_result, "ok", false) == false {
		return writer_tool_result
	}

	tool_payload := dict_get_or(writer_tool_result, "data", {})
	model_prompt := "Draft a concise executive summary for this topic: " + topic
	model_result := call_agent_model(agent, model_prompt, {
		"max_tokens": 220,
		"temperature": 0.2
	})
	if dict_get_or(model_result, "ok", false) == false && dict_get_or(agent, "__routing_enabled", false) {
		return model_result
	}
	if dict_get_or(model_result, "ok", false) {
		tool_payload["summary"] := dict_get_or(model_result, "output_text", tool_payload["summary"])
	}
	return {
		"ok": true,
		"data": tool_payload,
		"model_calls": [{
			"ok": dict_get_or(model_result, "ok", false),
			"provider": dict_get_or(model_result, "provider", dict_get_or(dict_get_or(agent, "model", {}), "provider", "")),
			"model": dict_get_or(model_result, "model", dict_get_or(dict_get_or(agent, "model", {}), "model", "")),
			"usage": dict_get_or(model_result, "usage", {})
		}]
	}
}

func model_agent_output(agent, step_input, run_state, tool_registry, context) {
	tool_results := {}
	for tool_name in dict_get_or(agent, "tools", []) {
		policy := dict_get_or(context, "tool_authorization_policy", null)
		if type(policy) != "null" {
			policy_decision := null
			try {
				policy_decision = policy({"run_id": dict_get_or(run_state, "run_id", ""), "workflow_id": dict_get_or(run_state, "workflow_id", ""), "step_id": dict_get_or(context, "step_id", ""), "tool_name": tool_name, "step_input": step_input, "status": dict_get_or(run_state, "status", "unknown")})
			} except err {
				return {"ok": false, "error": {"code": "tool_authorization_error", "message": "Tool authorization policy failed: " + tool_name, "retryable": false}}
			}
			if type(policy_decision) == "bool" && policy_decision == false {
				return {"ok": false, "error": {"code": "tool_execution_denied", "message": "Tool execution denied by authorization policy: " + tool_name, "retryable": false}}
			}
			if type(policy_decision) == "dict" && dict_get_or(policy_decision, "allow", dict_get_or(policy_decision, "ok", false)) == false {
				return {"ok": false, "error": {"code": "tool_execution_denied", "message": "Tool execution denied by authorization policy: " + tool_name, "retryable": false}}
			}
		}
		tool_result := call_tool(tool_registry, tool_name, step_input, context)
		if dict_get_or(tool_result, "ok", false) == false {
			return tool_result
		}
		tool_results[tool_name] := dict_get_or(tool_result, "data", {})
	}

	prompt_payload := {"input": step_input}
	if len(keys(tool_results)) > 0 {
		prompt_payload["tool_results"] := tool_results
	}
	model_options := {
		"max_tokens": dict_get_or(dict_get_or(agent, "model_options", {}), "max_tokens", 700),
		"temperature": dict_get_or(dict_get_or(agent, "model_options", {}), "temperature", 0.2)
	}
	output_schema := dict_get_or(agent, "output_schema", null)
	if type(output_schema) == "dict" && len(keys(output_schema)) > 0 {
		model_options["response_format"] := {"type": "json_object"}
		model_options["structured_output_schema"] := output_schema
		model_options["structured_output_retryable"] := false
	}
	model_result := call_agent_model(agent, to_json(prompt_payload), model_options)
	if dict_get_or(model_result, "ok", false) == false {
		return model_result
	}

	output_text := to_string(dict_get_or(model_result, "output_text", ""))
	data := {
		"text": output_text,
		"provider": dict_get_or(model_result, "provider", dict_get_or(dict_get_or(agent, "model", {}), "provider", "")),
		"model": dict_get_or(model_result, "model", dict_get_or(dict_get_or(agent, "model", {}), "model", "")),
		"tool_results": tool_results
	}
	if type(output_schema) == "dict" && len(keys(output_schema)) > 0 {
		try {
			parsed_output := parse_json(output_text)
			if type(parsed_output) == "dict" {
				data = parsed_output
				data["__model"] := {
					"provider": dict_get_or(model_result, "provider", ""),
					"model": dict_get_or(model_result, "model", "")
				}
			}
		} except err {
			# AI SDK returns structured_output_invalid for live invalid JSON. The
			# fixture path remains text-first so offline examples stay deterministic.
		}
	}
	return {
		"ok": true,
		"data": data,
		"model_calls": [{
			"ok": true,
			"provider": dict_get_or(model_result, "provider", ""),
			"model": dict_get_or(model_result, "model", ""),
			"usage": dict_get_or(model_result, "usage", {})
		}]
	}
}

func create_agent_handler_registry() {
	return {}
}

func register_agent_handler(handler_registry, agent_id, handler) {
	handler_registry[agent_id] := handler
	return handler_registry
}

func register_default_agent_handlers() {
	handler_registry := create_agent_handler_registry()
	handler_registry := register_agent_handler(handler_registry, "planner", func(agent, step_input, run_state, tool_registry, context) {
		return planner_output(agent, step_input, run_state)
	})
	handler_registry := register_agent_handler(handler_registry, "research", func(agent, step_input, run_state, tool_registry, context) {
		return research_output(agent, step_input, run_state, tool_registry, context)
	})
	handler_registry := register_agent_handler(handler_registry, "verification", func(agent, step_input, run_state, tool_registry, context) {
		return verification_output(agent, step_input, run_state, tool_registry, context)
	})
	handler_registry := register_agent_handler(handler_registry, "writer", func(agent, step_input, run_state, tool_registry, context) {
		return writer_output(agent, step_input, run_state, tool_registry, context)
	})
	handler_registry := register_agent_handler(handler_registry, "model", func(agent, step_input, run_state, tool_registry, context) {
		return model_agent_output(agent, step_input, run_state, tool_registry, context)
	})
	return handler_registry
}

func run_agent_with_agent(agent, handler_id, workflow_agents, step_input, run_state, tool_registry, options) {
	agent_id := dict_get_or(agent, "id", "")
	context := {
		"run_id": run_state["run_id"],
		"input": run_state["input"],
		"sources_dir": dict_get_or(tool_registry, "__sources_dir", "examples/research-report/sources"),
		"step_id": dict_get_or(options, "step_id", ""),
		"tool_authorization_policy": dict_get_or(options, "tool_authorization_policy", null)
	}
	handler_registry := register_default_agent_handlers()
	if has_key(workflow_agents, "__agent_handlers") {
		custom_handlers := workflow_agents["__agent_handlers"]
		if type(custom_handlers) == "dict" {
			for custom_agent_id in keys(custom_handlers) {
				handler_registry[custom_agent_id] := custom_handlers[custom_agent_id]
			}
		}
	}

	if has_key(handler_registry, handler_id) == 0 {
		if type(dict_get_or(agent, "__route_decision", null)) == "dict" {
			return {
				"ok": false,
				"error": {
					"code": "persisted_route_unavailable",
					"message": "Routed handler is unavailable: " + handler_id,
					"retryable": false
				}
			}
		}
		return agent_execution_error(agent_id, "No implementation exists for handler id " + handler_id + ".", false)
	}
	handler := handler_registry[handler_id]
	return handler(agent, step_input, run_state, tool_registry, context)
}

func run_agent(agent_id, workflow_agents, step_input, run_state, tool_registry) {
	if has_key(workflow_agents, agent_id) == 0 {
		return missing_agent_error(agent_id)
	}
	agent := workflow_agents[agent_id]
	handler_id := dict_get_or(agent, "handler_id", agent_id)
	return run_agent_with_agent(agent, handler_id, workflow_agents, step_input, run_state, tool_registry, {})
}

export create_agent := create_agent
export create_agent_handler_registry := create_agent_handler_registry
export register_agent_handler := register_agent_handler
export register_default_agent_handlers := register_default_agent_handlers
export run_agent := run_agent
export run_agent_with_agent := run_agent_with_agent
