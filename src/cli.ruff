# CLI argument parsing and help text for Kujo Eval.
#
# Extracted from main.ruff to keep the entry point focused on
# command dispatch, following the kujo-rag src/cli_args.ruff pattern.

from src.common import dict_get_or, normalize_string

export func print_help() {
	print("Kujo Eval — AI-native evaluation framework")
	print("")
	print("Usage:")
	print("  kujo run main.ruff init [--name <name>]")
	print("  kujo run main.ruff run [<config-path>] [--update-snapshots] [--output-dir <dir>]")
	print("  kujo run main.ruff report [<config-path>] [--output-dir <dir>]")
	print("  kujo run main.ruff compare <results-a.json> <results-b.json>")
	print("  kujo run main.ruff list-checks")
	print("  kujo run main.ruff snapshots [--snapshot-dir <dir>]")
	print("  kujo run main.ruff version")
	print("  kujo run main.ruff watch [--config <path>]")
	print("  kujo run main.ruff lint [<config-path>]")
	print("  kujo run main.ruff policy-explain [<config-path>] [--policy-stage <local|ci|release>]")
	print("  kujo run main.ruff diff <file-a> <file-b>")
	print("  kujo run main.ruff export [<config-path>]")
	print("  kujo run main.ruff verify-manifest [--manifest <path>] [--output-dir <dir>]")
	print("  kujo run main.ruff completion [--shell bash|zsh|fish]")
	print("")
	print("Commands:")
	print("  init          Create an eval.json suite file in the current directory")
	print("  run           Execute all tests in an eval suite")
	print("  report        Generate a report from the last run (md/html/junit/tap/ndjson)")
	print("  compare       Compare two eval run result files")
	print("  list-checks   List all available check types")
	print("  snapshots     List stored snapshots")
	print("  version       Print eval contract version")
	print("  watch         Watch config file and re-run on changes")
	print("  lint          Validate eval.json without running tests")
	print("  policy-explain  Print effective command/path/env policy for a stage")
	print("  diff          Compare two files line-by-line")
	print("  export        Export eval suite to shell script")
	print("  verify-manifest  Verify artifact-manifest checksum entries")
	print("  completion    Generate shell completion script (--shell bash|zsh|fish)")
	print("")
	print("Options:")
	print("  --name <name>            Suite name (for init)")
	print("  --template <name>         Template for init: basic, cli, web, agent (default: basic)")
	print("  --from <path>             Import test definitions from a JSON array file")
	print("  --from-scout <path>       Alias for --from when importing Scout-generated test definitions")
	print("  --config <path>          Path to eval.json (default: ./eval.json)")
	print("  --update-snapshots       Update snapshots instead of comparing")
	print("  --output-dir <dir>       Directory for reports (default: ./eval_results)")
	print("  --summary-channel-path <path>  Machine-readable run/report summary file path (default: <output-dir>/cli-summary.json)")
	print("  --artifact-checksums     Include SHA-256 checksum entries in artifact-manifest.json")
	print("  --manifest <path>        Path to artifact manifest for verify-manifest (default: <output-dir>/artifact-manifest.json)")
	print("  --snapshot-dir <dir>     Directory for snapshots (default: ./snapshots)")
	print("  --poll-ms <ms>           Watch polling interval in milliseconds (default: 2000)")
	print("  --max-loops <N>          Maximum watch loop iterations before exit (default: 500)")
	print("  --json                   Output results as JSON instead of markdown")
	print("  --rerun                  Force re-execution (for report command)")
	print("  --incremental            Enable incremental report section reuse (report command)")
	print("  --history                Show run history instead of generating report")
	print("  --filter <pattern>       Run only tests whose name contains pattern")
	print("  --exclude <pattern>      Skip tests whose name contains pattern")
	print("  --policy-stage <local|ci|release>  Apply stage-specific policy overlays from config")
	print("  --tags <tag1,tag2>       Run only tests with these tags")
	print("  --skip-tags <tag1,tag2>  Skip tests with these tags")
	print("  --only-failed            Re-run only tests that failed last run")
	print("  --format <md|html|junit|tap|ndjson>  Report output format (default: md)")
	print("  --quiet                   Suppress per-test output, show only summary")
	print("  --summary-only            Print a compact one-line run summary")
	print("  --verbose                 Show full check details as tests run")
	print("  --repeat <N>              Run suite N times for flake detection (default: 1)")
	print("  --parallel-workers <N>    Opt-in parallel mode for independent file checks (default: 1)")
	print("  --seed <N>                Seed for deterministic test ordering")
	print("  --dry-run                 Parse config and list tests without executing")
	print("  --no-color                Use plain text instead of emoji in output")
	print("  --help                   Show this help message")
	print("")
	print("Exit codes:")
	print("  0   Success (all commands)")
	print("  1   Assertion failure (run) or usage/config/runtime error")
}

func value_from_index(text, start_index) {
	value := ""
	idx := start_index
	while idx < len(text) {
		value = value + text[idx]
		idx := idx + 1
	}
	return value
}

export func parse_cli_flags(args) {

	flags := {}
	positionals := []

	i := 0
	while i < len(args) {
		arg := args[i]
		if starts_with(arg, "--") {
			if arg == "--help" {
				flags["help"] := true
			} else if arg == "--update-snapshots" {
				flags["update_snapshots"] := true
			} else if arg == "--json" {
				flags["json_output"] := true
			} else if arg == "--rerun" {
				flags["rerun"] := true
			} else if arg == "--only-failed" {
				flags["only_failed"] := true
			} else if arg == "--quiet" {
				flags["quiet"] := true
			} else if arg == "--verbose" {
				flags["verbose"] := true
			} else if arg == "--dry-run" {
				flags["dry_run"] := true
			} else if arg == "--no-color" {
				flags["no_color"] := true
			} else if starts_with(arg, "--repeat=") {
				flags["repeat"] := value_from_index(arg, 9)
			} else if starts_with(arg, "--seed=") {
				flags["seed"] := value_from_index(arg, 7)
			} else if starts_with(arg, "--format=") {
				flags["format"] := value_from_index(arg, 9)
			} else {
				key := ""
				k := 2
				while k < len(arg) {
					key = key + arg[k]
					k := k + 1
				}
				if i + 1 < len(args) {
					next_arg := args[i + 1]
					if starts_with(next_arg, "--") == false {
						flags[key] := next_arg
						i := i + 1
					} else {
						flags[key] := true
					}
				} else {
					flags[key] := true
				}
			}
		} else {
			positionals := push(positionals, arg)
		}
		i := i + 1
	}

	return {
		"flags": flags,
		"positionals": positionals
	}
}

export func describe_cli_module() {
	return {
		"module": "cli",
		"description": "CLI argument parsing and help text",
		"exports": ["parse_cli_flags", "print_help"],
		"contract_version": "2.0.0"
	}
}
