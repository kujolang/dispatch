from src.core.utils import dict_get_or, clone_dict

func routing_policy_version() {
	return "1.0.0"
}

func array_contains(values, expected) {
	if type(values) != "array" {
		return false
	}
	for value in values {
		if value == expected {
			return true
		}
	}
	return false
}

func normalize_array(value) {
	if type(value) == "array" {
		return value
	}
	return []
}

func normalize_dict(value) {
	if type(value) == "dict" {
		return value
	}
	return {}
}

func normalize_string(value, fallback) {
	if type(value) == "string" {
		resolved := trim(value)
		if resolved != "" {
			return resolved
		}
	}
	return fallback
}

func normalize_number(value, fallback) {
	if type(value) == "int" || type(value) == "float" {
		return value
	}
	return fallback
}

func merge_dicts(base, overrides) {
	result := clone_dict(normalize_dict(base))
	for key in keys(normalize_dict(overrides)) {
		result[key] := overrides[key]
	}
	return result
}

func quality_rank(tier) {
	normalized := to_lower(normalize_string(tier, "unknown"))
	if normalized == "frontier" {
		return 5
	}
	if normalized == "premium" {
		return 4
	}
	if normalized == "standard" {
		return 3
	}
	if normalized == "economy" {
		return 2
	}
	if normalized == "fixture" {
		return 1
	}
	return 0
}

func risk_rank(risk) {
	normalized := to_lower(normalize_string(risk, "unknown"))
	if normalized == "low" {
		return 1
	}
	if normalized == "medium" {
		return 2
	}
	if normalized == "high" {
		return 3
	}
	if normalized == "critical" {
		return 4
	}
	return 0
}

func routing_is_enabled(workflow, step) {
	workflow_routing := normalize_dict(dict_get_or(workflow, "routing", {}))
	step_routing := normalize_dict(dict_get_or(step, "routing", dict_get_or(dict_get_or(step, "config", {}), "routing", {})))
	if has_key(step_routing, "enabled") {
		return dict_get_or(step_routing, "enabled", false)
	}
	return dict_get_or(workflow_routing, "enabled", false)
}

func resolve_constraints(workflow, step, requested_agent) {
	workflow_routing := normalize_dict(dict_get_or(workflow, "routing", {}))
	agent_routing := normalize_dict(dict_get_or(requested_agent, "routing", {}))
	step_routing := normalize_dict(dict_get_or(step, "routing", dict_get_or(dict_get_or(step, "config", {}), "routing", {})))
	constraints := merge_dicts({}, dict_get_or(workflow_routing, "constraints", {}))
	constraints = merge_dicts(constraints, dict_get_or(agent_routing, "constraints", {}))
	constraints = merge_dicts(constraints, dict_get_or(step_routing, "constraints", dict_get_or(step, "routing_constraints", {})))
	step_output_schema := dict_get_or(step, "output_schema", null)
	if type(step_output_schema) == "dict" && len(keys(step_output_schema)) > 0 && has_key(constraints, "required_output_schema") == 0 {
		constraints["required_output_schema"] := step_output_schema
	}
	return constraints
}

func execution_compatibility(requested_agent, candidate_agent) {
	requested_id := normalize_string(dict_get_or(requested_agent, "id", ""), "")
	candidate_id := normalize_string(dict_get_or(candidate_agent, "id", ""), "")
	requested_handler := normalize_string(dict_get_or(requested_agent, "handler_id", requested_id), requested_id)
	candidate_handler := normalize_string(dict_get_or(candidate_agent, "handler_id", candidate_id), candidate_id)
	if requested_handler == candidate_handler && requested_handler != "" {
		return {"compatible": true, "reason_code": "same_handler"}
	}
	requested_contract := normalize_dict(dict_get_or(requested_agent, "execution_contract", {}))
	candidate_contract := normalize_dict(dict_get_or(candidate_agent, "execution_contract", {}))
	requested_contract_id := normalize_string(dict_get_or(requested_contract, "id", ""), "")
	candidate_contract_id := normalize_string(dict_get_or(candidate_contract, "id", ""), "")
	requested_version := normalize_string(dict_get_or(requested_contract, "version", ""), "")
	candidate_version := normalize_string(dict_get_or(candidate_contract, "version", ""), "")
	if requested_contract_id != "" && requested_version != "" && requested_contract_id == candidate_contract_id && requested_version == candidate_version {
		return {"compatible": true, "reason_code": "execution_contract_match"}
	}
	return {"compatible": false, "reason_code": "execution_contract_mismatch"}
}

func capability_enabled(agent, capability) {
	capabilities := dict_get_or(agent, "capabilities", {})
	if type(capabilities) == "array" {
		return array_contains(capabilities, capability)
	}
	if type(capabilities) == "dict" {
		return dict_get_or(capabilities, capability, false) == true
	}
	return false
}

func all_capabilities_available(agent, required_capabilities) {
	for capability in normalize_array(required_capabilities) {
		if capability_enabled(agent, capability) == false {
			return false
		}
	}
	return true
}

func all_tools_available(agent, required_tools) {
	agent_tools := normalize_array(dict_get_or(agent, "tools", []))
	for required_tool in normalize_array(required_tools) {
		if array_contains(agent_tools, required_tool) == false {
			return false
		}
	}
	return true
}

func schema_type_matches(expected_type, actual_type) {
	if expected_type == actual_type {
		return true
	}
	return array_contains(["dict", "object"], expected_type) && array_contains(["dict", "object"], actual_type)
}

func output_schema_compatible(agent_schema, required_schema) {
	if type(required_schema) != "dict" || len(keys(required_schema)) == 0 {
		return true
	}
	if type(agent_schema) != "dict" || len(keys(agent_schema)) == 0 {
		return false
	}
	expected_type := dict_get_or(required_schema, "type", "")
	actual_type := dict_get_or(agent_schema, "type", "")
	if expected_type != "" && actual_type != "" && schema_type_matches(expected_type, actual_type) == false {
		return false
	}
	agent_required := normalize_array(dict_get_or(agent_schema, "required", []))
	agent_properties := normalize_dict(dict_get_or(agent_schema, "properties", {}))
	required_properties := normalize_dict(dict_get_or(required_schema, "properties", {}))
	for field in normalize_array(dict_get_or(required_schema, "required", [])) {
		if array_contains(agent_required, field) == false {
			return false
		}
		if has_key(required_properties, field) && has_key(agent_properties, field) {
			expected_field_type := dict_get_or(required_properties[field], "type", "")
			actual_field_type := dict_get_or(agent_properties[field], "type", "")
			if expected_field_type != "" && actual_field_type != "" && schema_type_matches(expected_field_type, actual_field_type) == false {
				return false
			}
		}
	}
	return true
}

func find_catalog_entry(catalog, provider_id, model_id) {
	for entry in normalize_array(dict_get_or(catalog, "models", [])) {
		if type(entry) == "dict" {
			if dict_get_or(entry, "provider", "") == provider_id && dict_get_or(entry, "model", "") == model_id {
				return entry
			}
		}
	}
	return {}
}

func sort_catalog_models(models) {
	sorted_models := []
	for model_entry in normalize_array(models) {
		inserted := false
		next_models := []
		entry_key := to_string(dict_get_or(model_entry, "provider", "")) + "::" + to_string(dict_get_or(model_entry, "model", ""))
		for existing_entry in sorted_models {
			existing_key := to_string(dict_get_or(existing_entry, "provider", "")) + "::" + to_string(dict_get_or(existing_entry, "model", ""))
			ordered_keys := sort([entry_key, existing_key])
			if inserted == false && entry_key != existing_key && ordered_keys[0] == entry_key {
				next_models := push(next_models, model_entry)
				inserted = true
			}
			next_models := push(next_models, existing_entry)
		}
		if inserted == false {
			next_models := push(next_models, model_entry)
		}
		sorted_models = next_models
	}
	return sorted_models
}

func canonical_catalog_hash(catalog) {
	payload := {
		"schema_name": dict_get_or(catalog, "schema_name", "ai-sdk-model-catalog"),
		"schema_version": dict_get_or(catalog, "schema_version", "1.0.0"),
		"id": dict_get_or(catalog, "id", ""),
		"version": dict_get_or(catalog, "version", ""),
		"models": sort_catalog_models(dict_get_or(catalog, "models", [])),
		"metadata": dict_get_or(catalog, "metadata", {})
	}
	return sha256(to_json(payload))
}

func catalog_models_valid(catalog) {
	seen := {}
	for entry in normalize_array(dict_get_or(catalog, "models", [])) {
		if type(entry) != "dict" {
			return false
		}
		provider_id := normalize_string(dict_get_or(entry, "provider", ""), "")
		model_id := normalize_string(dict_get_or(entry, "model", ""), "")
		if provider_id == "" || model_id == "" {
			return false
		}
		key := provider_id + "::" + model_id
		if has_key(seen, key) {
			return false
		}
		seen[key] := true
		if quality_rank(dict_get_or(entry, "quality_tier", "unknown")) == 0 && dict_get_or(entry, "quality_tier", "unknown") != "unknown" {
			return false
		}
		for bounded_field in ["relative_quality", "reliability_score"] {
			bounded_value := dict_get_or(entry, bounded_field, null)
			if type(bounded_value) != "null" && ((type(bounded_value) != "int" && type(bounded_value) != "float") || bounded_value < 0 || bounded_value > 1) {
				return false
			}
		}
		context_window := dict_get_or(entry, "context_window", null)
		if type(context_window) != "null" && (type(context_window) != "int" || context_window <= 0) {
			return false
		}
		for non_negative_field in ["input_cost_per_million", "output_cost_per_million", "typical_latency_ms"] {
			value := dict_get_or(entry, non_negative_field, null)
			if type(value) != "null" && ((type(value) != "int" && type(value) != "float") || value < 0) {
				return false
			}
		}
	}
	return true
}

func normalize_model_candidate(agent, raw_candidate, catalog) {
	candidate := normalize_dict(raw_candidate)
	legacy_model := normalize_dict(dict_get_or(agent, "model", {}))
	provider_id := normalize_string(dict_get_or(candidate, "provider", dict_get_or(legacy_model, "provider", "openai")), "openai")
	model_id := normalize_string(dict_get_or(candidate, "model", dict_get_or(legacy_model, "model", "")), "")
	catalog_entry := find_catalog_entry(catalog, provider_id, model_id)
	resolved := merge_dicts({}, candidate)
	if len(keys(catalog_entry)) > 0 {
		# The SDK catalog is authoritative for operational model metadata. Agent
		# candidates identify routes; they cannot spoof quality, price, or capacity.
		resolved = merge_dicts({}, catalog_entry)
	}
	resolved["provider"] := provider_id
	resolved["model"] := model_id
	resolved["catalog_member"] := len(keys(catalog_entry)) > 0
	if has_key(resolved, "enabled") == 0 {
		resolved["enabled"] := true
	}
	if has_key(resolved, "quality_tier") == 0 {
		resolved["quality_tier"] := "unknown"
	}
	return resolved
}

func agent_model_candidates(agent, catalog) {
	raw_candidates := dict_get_or(agent, "model_candidates", [])
	if type(raw_candidates) != "array" || len(raw_candidates) == 0 {
		raw_candidates = [dict_get_or(agent, "model", {})]
	}
	models_out := []
	for raw_candidate in raw_candidates {
		resolved := normalize_model_candidate(agent, raw_candidate, catalog)
		if dict_get_or(resolved, "model", "") != "" {
			models_out = push(models_out, resolved)
		}
	}
	return models_out
}

func candidate_key(candidate) {
	model_metadata := normalize_dict(dict_get_or(candidate, "model_metadata", {}))
	provider_id := dict_get_or(candidate, "provider", dict_get_or(model_metadata, "provider", ""))
	model_id := dict_get_or(candidate, "model", dict_get_or(model_metadata, "model", ""))
	return to_string(dict_get_or(candidate, "selected_agent_id", "")) + "::" + to_string(provider_id) + "::" + to_string(model_id)
}

func unknown_rejects(constraints) {
	return dict_get_or(constraints, "unknown_metadata", "reject_constrained") == "reject_constrained"
}

func candidate_rejection_reasons(candidate, requested_agent, constraints) {
	reasons := []
	agent := dict_get_or(candidate, "agent", {})
	model := dict_get_or(candidate, "model_metadata", {})
	compatibility := execution_compatibility(requested_agent, agent)
	if compatibility["compatible"] == false {
		reasons := push(reasons, compatibility["reason_code"])
	}
	if dict_get_or(model, "enabled", true) == false {
		reasons := push(reasons, "model_disabled")
	}
	if dict_get_or(constraints, "require_catalog_membership", true) && dict_get_or(model, "catalog_member", false) == false {
		reasons := push(reasons, "model_not_in_catalog")
	}
	if all_capabilities_available(agent, dict_get_or(constraints, "required_capabilities", [])) == false {
		reasons := push(reasons, "capability_mismatch")
	}
	if all_tools_available(agent, dict_get_or(constraints, "required_tools", [])) == false {
		reasons := push(reasons, "tool_mismatch")
	}
	if len(normalize_array(dict_get_or(constraints, "required_tools", []))) > 0 && dict_get_or(model, "supports_tools", false) == false {
		reasons := push(reasons, "model_tools_unsupported")
	}
	allowed_agents := normalize_array(dict_get_or(constraints, "allowed_agents", []))
	denied_agents := normalize_array(dict_get_or(constraints, "denied_agents", []))
	selected_agent_id := dict_get_or(candidate, "selected_agent_id", "")
	if len(allowed_agents) > 0 && array_contains(allowed_agents, selected_agent_id) == false {
		reasons := push(reasons, "agent_not_allowed")
	}
	if array_contains(denied_agents, selected_agent_id) {
		reasons := push(reasons, "agent_denied")
	}
	provider_id := dict_get_or(model, "provider", "")
	allowed_providers := normalize_array(dict_get_or(constraints, "allowed_providers", []))
	denied_providers := normalize_array(dict_get_or(constraints, "denied_providers", []))
	if len(allowed_providers) > 0 && array_contains(allowed_providers, provider_id) == false {
		reasons := push(reasons, "provider_not_allowed")
	}
	if array_contains(denied_providers, provider_id) {
		reasons := push(reasons, "provider_denied")
	}
	model_id := dict_get_or(model, "model", "")
	allowed_models := normalize_array(dict_get_or(constraints, "allowed_models", []))
	denied_models := normalize_array(dict_get_or(constraints, "denied_models", []))
	if len(allowed_models) > 0 && array_contains(allowed_models, model_id) == false {
		reasons := push(reasons, "model_not_allowed")
	}
	if array_contains(denied_models, model_id) {
		reasons := push(reasons, "model_denied")
	}
	quality_floor := normalize_string(dict_get_or(constraints, "quality_floor", "unknown"), "unknown")
	if quality_rank(dict_get_or(model, "quality_tier", "unknown")) < quality_rank(quality_floor) {
		reasons := push(reasons, "quality_below_floor")
	}
	upgrade_tier := normalize_string(dict_get_or(constraints, "upgrade_from_quality_tier", ""), "")
	if upgrade_tier != "" {
		model_rank := quality_rank(dict_get_or(model, "quality_tier", "unknown"))
		upgrade_rank := quality_rank(upgrade_tier)
		model_relative := dict_get_or(model, "relative_quality", null)
		upgrade_relative := dict_get_or(constraints, "upgrade_from_relative_quality", null)
		if model_rank < upgrade_rank {
			reasons := push(reasons, "model_not_an_upgrade")
		} else if model_rank == upgrade_rank {
			if type(model_relative) == "null" || type(upgrade_relative) == "null" || model_relative <= upgrade_relative {
				reasons := push(reasons, "model_not_an_upgrade")
			}
		}
	}
	if dict_get_or(constraints, "requires_tools", false) && dict_get_or(model, "supports_tools", false) == false {
		reasons := push(reasons, "model_tools_unsupported")
	}
	if dict_get_or(constraints, "requires_structured_output", false) && dict_get_or(model, "supports_structured_output", false) == false {
		reasons := push(reasons, "structured_output_unsupported")
	}
	if dict_get_or(constraints, "output_schema_required", false) && type(dict_get_or(agent, "output_schema", null)) != "dict" {
		reasons := push(reasons, "output_schema_missing")
	}
	if output_schema_compatible(dict_get_or(agent, "output_schema", null), dict_get_or(constraints, "required_output_schema", null)) == false {
		reasons := push(reasons, "output_schema_incompatible")
	}
	required_context := normalize_number(dict_get_or(constraints, "required_context_tokens", 0), 0)
	context_window := dict_get_or(model, "context_window", null)
	if required_context > 0 {
		if type(context_window) == "null" && unknown_rejects(constraints) {
			reasons := push(reasons, "context_capacity_unknown")
		} else if type(context_window) != "null" && context_window < required_context {
			reasons := push(reasons, "context_capacity_insufficient")
		}
	}
	max_input_cost := dict_get_or(constraints, "max_input_cost_per_million", null)
	input_cost := dict_get_or(model, "input_cost_per_million", null)
	if type(max_input_cost) != "null" {
		if type(input_cost) == "null" && unknown_rejects(constraints) {
			reasons := push(reasons, "input_cost_unknown")
		} else if type(input_cost) != "null" && input_cost > max_input_cost {
			reasons := push(reasons, "input_cost_exceeded")
		}
	}
	max_output_cost := dict_get_or(constraints, "max_output_cost_per_million", null)
	output_cost := dict_get_or(model, "output_cost_per_million", null)
	if type(max_output_cost) != "null" {
		if type(output_cost) == "null" && unknown_rejects(constraints) {
			reasons := push(reasons, "output_cost_unknown")
		} else if type(output_cost) != "null" && output_cost > max_output_cost {
			reasons := push(reasons, "output_cost_exceeded")
		}
	}
	max_latency := dict_get_or(constraints, "max_latency_ms", null)
	latency := dict_get_or(model, "typical_latency_ms", null)
	if type(max_latency) != "null" {
		if type(latency) == "null" && unknown_rejects(constraints) {
			reasons := push(reasons, "latency_unknown")
		} else if type(latency) != "null" && latency > max_latency {
			reasons := push(reasons, "latency_exceeded")
		}
	}
	minimum_reliability := dict_get_or(constraints, "minimum_reliability", null)
	reliability := dict_get_or(model, "reliability_score", null)
	if type(minimum_reliability) != "null" {
		if type(reliability) == "null" && unknown_rejects(constraints) {
			reasons := push(reasons, "reliability_unknown")
		} else if type(reliability) != "null" && reliability < minimum_reliability {
			reasons := push(reasons, "reliability_below_floor")
		}
	}
	maximum_risk := normalize_string(dict_get_or(constraints, "maximum_risk", "critical"), "critical")
	candidate_risk := dict_get_or(model, "risk", dict_get_or(dict_get_or(agent, "routing", {}), "risk", "unknown"))
	if risk_rank(candidate_risk) == 0 && has_key(constraints, "maximum_risk") && unknown_rejects(constraints) {
		reasons := push(reasons, "risk_unknown")
	} else if risk_rank(candidate_risk) > risk_rank(maximum_risk) {
		reasons := push(reasons, "risk_exceeded")
	}
	excluded_routes := normalize_array(dict_get_or(constraints, "excluded_routes", []))
	if array_contains(excluded_routes, candidate_key(candidate)) {
		reasons := push(reasons, "route_excluded")
	}
	return reasons
}

func optional_score(value, unknown_value) {
	if type(value) == "int" || type(value) == "float" {
		return value
	}
	return unknown_value
}

func candidate_better(left, right) {
	left_model := left["model_metadata"]
	right_model := right["model_metadata"]
	left_quality := quality_rank(dict_get_or(left_model, "quality_tier", "unknown"))
	right_quality := quality_rank(dict_get_or(right_model, "quality_tier", "unknown"))
	if left_quality != right_quality {
		return left_quality > right_quality
	}
	left_relative := optional_score(dict_get_or(left_model, "relative_quality", null), -1)
	right_relative := optional_score(dict_get_or(right_model, "relative_quality", null), -1)
	if left_relative != right_relative {
		return left_relative > right_relative
	}
	left_reliability := optional_score(dict_get_or(left_model, "reliability_score", null), -1)
	right_reliability := optional_score(dict_get_or(right_model, "reliability_score", null), -1)
	if left_reliability != right_reliability {
		return left_reliability > right_reliability
	}
	left_cost := optional_score(dict_get_or(left_model, "input_cost_per_million", null), 1000000000) + optional_score(dict_get_or(left_model, "output_cost_per_million", null), 1000000000)
	right_cost := optional_score(dict_get_or(right_model, "input_cost_per_million", null), 1000000000) + optional_score(dict_get_or(right_model, "output_cost_per_million", null), 1000000000)
	if left_cost != right_cost {
		return left_cost < right_cost
	}
	left_latency := optional_score(dict_get_or(left_model, "typical_latency_ms", null), 1000000000)
	right_latency := optional_score(dict_get_or(right_model, "typical_latency_ms", null), 1000000000)
	if left_latency != right_latency {
		return left_latency < right_latency
	}
	left_efficiency := optional_score(dict_get_or(left_model, "token_efficiency", null), -1)
	right_efficiency := optional_score(dict_get_or(right_model, "token_efficiency", null), -1)
	if left_efficiency != right_efficiency {
		return left_efficiency > right_efficiency
	}
	left_key := candidate_key(left)
	right_key := candidate_key(right)
	if left_key == right_key {
		return false
	}
	ordered_keys := sort([left_key, right_key])
	return ordered_keys[0] == left_key
}

func sort_candidates(candidates) {
	ranked_out := []
	for candidate in candidates {
		inserted := false
		next_ranked := []
		for existing in ranked_out {
			if inserted == false && candidate_better(candidate, existing) {
				next_ranked := push(next_ranked, candidate)
				inserted := true
			}
			next_ranked := push(next_ranked, existing)
		}
		if inserted == false {
			next_ranked := push(next_ranked, candidate)
		}
		ranked_out = next_ranked
	}
	return ranked_out
}

func sort_candidates_by_key(candidates) {
	result := []
	for candidate in candidates {
		inserted := false
		updated := []
		for existing in result {
			if inserted == false && candidate_key(candidate) < candidate_key(existing) {
				updated := push(updated, candidate)
				inserted = true
			}
			updated := push(updated, existing)
		}
		if inserted == false {
			updated := push(updated, candidate)
		}
		result = updated
	}
	return result
}

func candidate_agents(requested_agent_id, agents, allow_substitution) {
	result := []
	if has_key(agents, requested_agent_id) {
		result := push(result, agents[requested_agent_id])
	}
	if allow_substitution {
		ids := keys(agents)
		ids = sort(ids)
		for agent_id in ids {
			if agent_id != requested_agent_id && agent_id != "__agent_handlers" {
				if type(agents[agent_id]) == "dict" {
					result := push(result, agents[agent_id])
				}
			}
		}
	}
	return result
}

func decision_id_payload(decision) {
	return {
		"policy_version": dict_get_or(decision, "policy_version", ""),
		"catalog_id": dict_get_or(decision, "catalog_id", ""),
		"catalog_version": dict_get_or(decision, "catalog_version", ""),
		"catalog_hash": dict_get_or(decision, "catalog_hash", ""),
		"step_id": dict_get_or(decision, "step_id", ""),
		"requested_agent_id": dict_get_or(decision, "requested_agent_id", ""),
		"selected_agent_id": dict_get_or(decision, "selected_agent_id", ""),
		"provider_id": dict_get_or(decision, "provider_id", ""),
		"model": dict_get_or(decision, "model", ""),
		"constraints": dict_get_or(decision, "constraints", {}),
		"fallback_index": dict_get_or(decision, "fallback_index", 0)
	}
}

func build_decision(request, candidate, constraints, candidate_count, reason_codes) {
	model := candidate["model_metadata"]
	agent := candidate["agent"]
	catalog := normalize_dict(dict_get_or(request, "model_catalog", {}))
	decision := {
		"decision_id": "",
		"policy_version": normalize_string(dict_get_or(request, "policy_version", routing_policy_version()), routing_policy_version()),
		"catalog_id": dict_get_or(catalog, "id", ""),
		"catalog_version": dict_get_or(catalog, "version", ""),
		"catalog_hash": dict_get_or(catalog, "catalog_hash", ""),
		"step_id": dict_get_or(request, "step_id", ""),
		"requested_agent_id": dict_get_or(request, "requested_agent_id", ""),
		"selected_agent_id": dict_get_or(candidate, "selected_agent_id", ""),
		"selected_agent_role": dict_get_or(agent, "role", dict_get_or(agent, "purpose", "")),
		"handler_id": dict_get_or(agent, "handler_id", dict_get_or(candidate, "selected_agent_id", "")),
		"execution_contract": dict_get_or(agent, "execution_contract", {}),
		"provider_id": dict_get_or(model, "provider", ""),
		"model": dict_get_or(model, "model", ""),
		"quality_tier": dict_get_or(model, "quality_tier", "unknown"),
		"relative_quality": dict_get_or(model, "relative_quality", null),
		"reason_codes": reason_codes,
		"constraints": constraints,
		"candidate_count": candidate_count,
		"estimated_cost": {
			"input_per_million": dict_get_or(model, "input_cost_per_million", null),
			"output_per_million": dict_get_or(model, "output_cost_per_million", null),
			"currency": dict_get_or(model, "currency", "USD")
		},
		"estimated_latency_ms": dict_get_or(model, "typical_latency_ms", null),
		"selected_at": dict_get_or(request, "selected_at", format_date(now(), "YYYY-MM-DD HH:mm:ss")),
		"fallback_index": dict_get_or(request, "fallback_index", 0)
	}
	decision["decision_id"] := "route-" + sha256(to_json(decision_id_payload(decision)))
	return decision
}

func resolve_route(request) {
	workflow := normalize_dict(dict_get_or(request, "workflow", {}))
	step := normalize_dict(dict_get_or(request, "step", {}))
	agents := normalize_dict(dict_get_or(workflow, "agents", {}))
	requested_agent_id := normalize_string(dict_get_or(request, "requested_agent_id", dict_get_or(step, "agent_id", "")), "")
	if has_key(agents, requested_agent_id) == 0 {
		return {"ok": false, "error": {"code": "no_route_available", "message": "Requested agent is not registered: " + requested_agent_id, "retryable": false, "details": {"reason_codes": ["requested_agent_missing"]}}}
	}
	requested_agent := agents[requested_agent_id]
	constraints := resolve_constraints(workflow, step, requested_agent)
	constraints = merge_dicts(constraints, dict_get_or(request, "constraint_overrides", {}))
	routing_enabled := routing_is_enabled(workflow, step)
	if routing_enabled == false {
		legacy_candidates := agent_model_candidates(requested_agent, {})
		if len(legacy_candidates) == 0 {
			legacy_candidates = [{"provider": "openai", "model": "gpt-4.1-mini", "quality_tier": "unknown", "enabled": true}]
		}
		legacy_candidate := {"selected_agent_id": requested_agent_id, "agent": requested_agent, "model_metadata": legacy_candidates[0]}
		return {"ok": true, "decision": build_decision(request, legacy_candidate, {}, 1, ["legacy_static"]), "candidate_evaluations": []}
	}

	workflow_routing := normalize_dict(dict_get_or(workflow, "routing", {}))
	step_routing := normalize_dict(dict_get_or(step, "routing", dict_get_or(dict_get_or(step, "config", {}), "routing", {})))
	policy_version := normalize_string(dict_get_or(workflow_routing, "policy_version", routing_policy_version()), routing_policy_version())
	if policy_version != routing_policy_version() {
		return {"ok": false, "error": {"code": "unsupported_routing_policy_version", "message": "Unsupported routing policy version: " + policy_version, "retryable": false}}
	}
	objective := normalize_string(dict_get_or(step_routing, "objective", dict_get_or(workflow_routing, "objective", "quality_first")), "quality_first")
	if objective != "quality_first" {
		return {"ok": false, "error": {"code": "unsupported_routing_objective", "message": "Unsupported deterministic routing objective: " + objective, "retryable": false}}
	}
	allow_substitution := dict_get_or(step_routing, "allow_agent_substitution", dict_get_or(workflow_routing, "allow_agent_substitution", false))
	catalog := normalize_dict(dict_get_or(request, "model_catalog", dict_get_or(workflow_routing, "model_catalog", {})))
	if dict_get_or(catalog, "schema_name", "") != "ai-sdk-model-catalog" || dict_get_or(catalog, "schema_version", "") != "1.0.0" || normalize_string(dict_get_or(catalog, "id", ""), "") == "" || normalize_string(dict_get_or(catalog, "version", ""), "") == "" || normalize_string(dict_get_or(catalog, "catalog_hash", ""), "") == "" || type(dict_get_or(catalog, "models", null)) != "array" {
		return {"ok": false, "error": {"code": "invalid_model_catalog", "message": "Enabled routing requires an AI SDK model catalog at schema version 1.0.0 with id, version, catalog_hash, and models.", "retryable": false}}
	}
	if dict_get_or(catalog, "catalog_hash", "") != canonical_catalog_hash(catalog) {
		return {"ok": false, "error": {"code": "invalid_model_catalog", "message": "Model catalog hash does not match canonical catalog content.", "retryable": false}}
	}
	if catalog_models_valid(catalog) == false || dict_get_or(dict_get_or(catalog, "validation", {"ok": true}), "ok", true) == false {
		return {"ok": false, "error": {"code": "invalid_model_catalog", "message": "Model catalog entries do not satisfy the AI SDK metadata contract.", "retryable": false}}
	}
	if dict_get_or(workflow_routing, "allow_uncataloged_models", false) {
		constraints["require_catalog_membership"] := false
	} else {
		constraints["require_catalog_membership"] := true
	}
	candidates := []
	seen_candidates := {}
	for agent in candidate_agents(requested_agent_id, agents, allow_substitution) {
		for model in agent_model_candidates(agent, catalog) {
			candidate := {
				"selected_agent_id": dict_get_or(agent, "id", ""),
				"agent": agent,
				"model_metadata": model
			}
			key := candidate_key(candidate)
			if has_key(seen_candidates, key) == 0 {
				candidates := push(candidates, candidate)
				seen_candidates[key] := true
			}
		}
	}
	candidates = sort_candidates_by_key(candidates)
	evaluations := []
	eligible := []
	for candidate in candidates {
		rejections := candidate_rejection_reasons(candidate, requested_agent, constraints)
		evaluations := push(evaluations, {"candidate_key": candidate_key(candidate), "eligible": len(rejections) == 0, "reason_codes": rejections})
		if len(rejections) == 0 {
			eligible := push(eligible, candidate)
		}
	}
	if len(eligible) == 0 {
		return {
			"ok": false,
			"error": {
				"code": "no_route_available",
				"message": "No routing candidate satisfied hard constraints for step " + dict_get_or(step, "id", "") + ".",
				"retryable": false,
				"details": {"candidate_count": len(candidates), "candidate_evaluations": evaluations, "constraints": constraints}
			},
			"candidate_evaluations": evaluations
		}
	}
	ranked := sort_candidates(eligible)
	selected := ranked[0]
	reason_codes := ["hard_constraints_satisfied", "quality_first", "deterministic_tiebreak"]
	if dict_get_or(selected, "selected_agent_id", "") != requested_agent_id {
		reason_codes := push(reason_codes, "compatible_agent_substitution")
	} else {
		reason_codes := push(reason_codes, "requested_agent_preserved")
	}
	decision := build_decision(request, selected, constraints, len(candidates), reason_codes)
	return {"ok": true, "decision": decision, "candidate_evaluations": evaluations}
}

func build_effective_agent(workflow_agents, decision, routing_enabled) {
	selected_agent_id := dict_get_or(decision, "selected_agent_id", "")
	if has_key(workflow_agents, selected_agent_id) == 0 {
		return {"ok": false, "error": {"code": "persisted_route_unavailable", "message": "Selected agent is unavailable: " + selected_agent_id, "retryable": false}}
	}
	agent := clone_dict(workflow_agents[selected_agent_id])
	agent["model"] := merge_dicts(dict_get_or(agent, "model", {}), {
		"provider": dict_get_or(decision, "provider_id", ""),
		"model": dict_get_or(decision, "model", "")
	})
	agent["__route_decision"] := decision
	agent["__routing_enabled"] := routing_enabled
	return {"ok": true, "agent": agent}
}

func evaluate_route_output(output, evaluation_config) {
	config := normalize_dict(evaluation_config)
	if len(keys(config)) == 0 {
		return {"accepted": true, "outcome": "accepted", "reason_codes": ["evaluation_not_configured"]}
	}
	data := normalize_dict(output)
	reasons := []
	for field in normalize_array(dict_get_or(config, "required_fields", [])) {
		if has_key(data, field) == 0 {
			reasons := push(reasons, "required_field_missing:" + to_string(field))
		}
	}
	minimum_confidence := dict_get_or(config, "minimum_confidence", null)
	if type(minimum_confidence) != "null" {
		confidence := dict_get_or(data, "confidence", null)
		if type(confidence) == "null" || confidence < minimum_confidence {
			reasons := push(reasons, "confidence_below_minimum")
		}
	}
	max_unsupported := dict_get_or(config, "max_unsupported_claims", null)
	if type(max_unsupported) != "null" {
		unsupported := dict_get_or(data, "unsupported_claims", 0)
		if type(unsupported) == "array" {
			unsupported = len(unsupported)
		}
		if type(unsupported) != "int" || unsupported > max_unsupported {
			reasons := push(reasons, "unsupported_claim_limit_exceeded")
		}
	}
	if len(reasons) == 0 {
		return {"accepted": true, "outcome": "accepted", "reason_codes": ["evaluation_passed"]}
	}
	outcome := normalize_string(dict_get_or(config, "on_failure", "failed"), "failed")
	allowed_outcomes := ["retry_same_route", "upgrade_model", "reroute_agent", "request_human_review", "failed"]
	if array_contains(allowed_outcomes, outcome) == false {
		outcome = "failed"
		reasons := push(reasons, "invalid_evaluation_failure_outcome")
	}
	return {"accepted": false, "outcome": outcome, "reason_codes": reasons}
}

func route_failure_action(error, fallback_config) {
	error_map := normalize_dict(error)
	code := normalize_string(dict_get_or(error_map, "code", ""), "")
	if dict_get_or(error_map, "retryable", false) || array_contains(["timeout", "rate_limit", "network_error", "sdk_bridge_exec_error", "http_429", "http_5xx"], code) {
		return {"action": "retry_same_route", "reason": code}
	}
	if array_contains(["provider_unavailable", "context_incompatible", "structured_output_invalid", "quality_evaluation_failed", "unsupported_feature"], code) {
		return {"action": "fallback", "reason": code}
	}
	if array_contains(normalize_array(dict_get_or(fallback_config, "fallback_on_codes", [])), code) {
		return {"action": "fallback", "reason": code}
	}
	return {"action": "fail", "reason": code}
}

export routing_policy_version := routing_policy_version
export routing_is_enabled := routing_is_enabled
export execution_compatibility := execution_compatibility
export resolve_constraints := resolve_constraints
export resolve_route := resolve_route
export build_effective_agent := build_effective_agent
export evaluate_route_output := evaluate_route_output
export route_failure_action := route_failure_action
