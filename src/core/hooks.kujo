from src.core.utils import dict_get_or, ensure_dir

func create_lifecycle_event(run_state, event_type, step_id, message, details) {
	return {
		"run_id": dict_get_or(run_state, "run_id", ""),
		"workflow_id": dict_get_or(run_state, "workflow_id", ""),
		"status": dict_get_or(run_state, "status", ""),
		"event_type": event_type,
		"step_id": step_id,
		"message": message,
		"details": details,
		"timestamp": format_date(now(), "YYYY-MM-DD HH:mm:ss")
	}
}

func create_human_intervention_event(run_state, step, approval, options) {
	run_id := to_string(dict_get_or(run_state, "run_id", ""))
	step_id := to_string(dict_get_or(step, "id", ""))
	workflow_id := to_string(dict_get_or(run_state, "workflow_id", ""))
	approval_id := to_string(dict_get_or(approval, "id", ""))
	attempt := dict_get_or(step, "attempts", 1)
	if attempt <= 0 {
		attempt := 1
	}
	event_id := "evt_" + replace(replace(run_id + "_" + step_id, "-", "_"), " ", "_")
	return {
		"schema_version": "1.0",
		"event_id": event_id,
		"event_type": "human_intervention_required",
		"created_at": format_date(now(), "YYYY-MM-DDTHH:mm:ssZ"),
		"expires_at": null,
		"run": {
			"run_id": run_id,
			"workflow_id": workflow_id,
			"step_id": step_id,
			"attempt": attempt
		},
		"source": {
			"tool": "dispatch",
			"agent_id": dict_get_or(step, "agent_id", null),
			"project_id": dict_get_or(dict_get_or(run_state, "input", {}), "project_id", null)
		},
		"classification": {
			"reason": dict_get_or(approval, "reason", "approval_required"),
			"severity": dict_get_or(step, "risk", "high"),
			"urgency": "normal",
			"risk_level": dict_get_or(step, "risk", "medium")
		},
		"content": {
			"title": "Human intervention required",
			"summary": dict_get_or(approval, "summary", "The workflow reached a protected approval gate."),
			"question": dict_get_or(approval, "summary", "Review this workflow step and choose an action."),
			"details": ["Approval evidence is persisted in the Dispatch run state and trace."],
			"suggested_action": "Review the evidence before choosing an action."
		},
		"allowed_actions": ["approve", "reject", "request_changes", "reply"],
		"evidence_refs": [dict_get_or(run_state, "run_dir", "") + "/state.json", dict_get_or(run_state, "run_dir", "") + "/trace.json"],
		"routing": {
			"channels": dict_get_or(options, "leash_channels", ["slack", "discord"]),
			"audience": dict_get_or(options, "leash_audience", ["project-operators"])
		},
		"security": {
			"decision_id": approval_id,
			"single_use_nonce_reference": "dispatch:" + run_id + ":" + step_id,
			"contains_sensitive_data": false
		},
		"metadata": {
			"dispatch_callback_url": dict_get_or(options, "leash_callback_url", ""),
			"source_approval_id": approval_id
		}
	}
}

func emit_hook_event(options, event_payload) {
	callback := dict_get_or(options, "event_hook", null)
	if type(callback) != "null" {
		callback(event_payload)
	}
	callbacks := dict_get_or(options, "event_hooks", [])
	if type(callbacks) == "array" {
		for hook_callback in callbacks {
			if type(hook_callback) != "null" {
				hook_callback(event_payload)
			}
		}
	}
	webhook_sink := dict_get_or(options, "webhook_sink", "")
	if webhook_sink != "" {
		dir_path := dirname(webhook_sink)
		if dir_path != "" && dir_path != "." {
			ensure_dir(dir_path)
		}
		existing := ""
		if file_exists(webhook_sink) {
			existing = read_file(webhook_sink)
		}
		line := to_json(event_payload)
		if existing != "" {
			line = existing + "\n" + line
		}
		write_file(webhook_sink, line, true)
	}
	webhook_url := to_string(dict_get_or(options, "webhook_url", ""))
	if trim(webhook_url) != "" {
		# Best-effort outbound delivery: observability must never fail a run,
		# so any transport error is swallowed.
		try {
			http_post(webhook_url, to_json(event_payload))
		} except err {
			# Swallow delivery errors; the local sink/trace remain the source of truth.
		}
	}
	leash_url := trim(to_string(dict_get_or(options, "leash_url", "")))
	if event_payload["event_type"] == "human_intervention_required" && leash_url != "" {
		try {
			http_post(leash_url, to_json(event_payload))
		} except err {
			# The paused checkpoint is authoritative; delivery failures remain observable.
		}
	}
	return {
		"ok": true
	}
}

export create_lifecycle_event := create_lifecycle_event
export create_human_intervention_event := create_human_intervention_event
export emit_hook_event := emit_hook_event
