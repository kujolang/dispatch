# Local trusted-host, one explicitly chosen SQLite effect. No parent execution.
from src.core.assurance_state import assurance_protected, assurance_feature
from src.core.assurance_configuration import resolve_run_configuration
from src.core.state import load_run_state, acquire_run_lock, release_run_lock, persist_run_state
from src.core.control_journal import reconcile_control_journal, append_control_event
from src.core.effect_set import assess_effect_set
from src.core.portable_commitments import portable_json
from src.core.utils import dict_get_or, ensure_dir
from src.adapters.sqlite_effect import sqlite_effect_apply_checked, sqlite_effect_observe

func denied() {return {"ok": false, "code": "effect_continuation_denied", "parent_replay": "prohibited"}}
func reference(value) {return "sha256:" + sha256(portable_json(value))}
func check(value) {if value != true {throw("effect_continuation_denied")}}
func notify(options, point) {hook := dict_get_or(options, "effect_boundary", null); if type(hook) == "function" {hook(point)}}

# Re-resolve installed authority on every call. A serialized candidate or participant
# cannot supply this host callback. Source inventory includes its adapter/verifier.
func current(state, options, effect_id, require_candidate) {
    check(assurance_protected(state)); check(reconcile_control_journal(state)["ok"])
    policy := state["assurance_negotiation"]
    check(policy["mode"] == "required"&&policy["fallback"] == "deny")
    check(policy["profile"] == "dispatch.sqlite-unique"&&policy["profile_version"] == "1beta1")
    boundary := state["current_control_boundary"]; request := state["human_intervention"]
    check(state["status"] == "paused"&&boundary["status"] == "open")
    check(request["schema"] == "kujo.intervention-request/v2"&&request["boundary_id"] == boundary["boundary_id"]&&request["state_revision"] == state["revision"])
    check(contains(request["allowed_actions"], "retry_step") != 0)
    expires := dict_get_or(request, "expires_at", null)
    if expires != null {check(expires > format_date(now(), "YYYY-MM-DDTHH:mm:ssZ"))}
    preserve := boundary["preservation"]
    check(preserve["status"] == "satisfied"&&preserve["actual_mode"] == "filesystem"&&preserve["reconstructability"] == "same_filesystem")
    check(preserve["retain_until"] > format_date(now(), "YYYY-MM-DDTHH:mm:ssZ"))
    resolved := resolve_run_configuration(state, options); check(resolved["ok"])
    installed := resolved["installed"]; host := installed["effect_set"]
    check(host["environment_valid"] == true)
    plan := host["plan"]; raw := host["result_raw"]; set_raw := host["set_raw"]
    check(plan["config_ref"] == "sha256:" + policy["config_revision"])
    check(plan["registration_ref"] == reference(host["registration"]))
    check(plan["subject"]["run_id"] == state["run_id"]&&plan["subject"]["step_id"] == boundary["step_id"])
    matched := false
    for step in state["steps"] {
        check(step["status"] != "running")
        if step["id"] == boundary["step_id"] {matched = to_json(step["execution_result"]) == to_json(parse_json(raw))&&to_string(dict_get_or(step,"control_attempt",1)) == plan["subject"]["attempt_id"]}
    }
    check(matched)
    index := -1
    for i in range(0,len(plan["effects"])) {
        entry := plan["effects"][i]; intent := host["intents"][i]
        check(entry["profile"] == policy["profile"]&&entry["profile_revision"] == policy["profile_version"]&&entry["authority"] == installed["descriptor"]["issuer"])
        check(entry["operation"] == intent["operation"])
        for field in ["target", "scope", "request", "key"] {check(entry[field + "_ref"] == "sha256:" + intent[field + "_sha256"])}
        check(intent["target_sha256"] == sha256(host["sink_path"]))
        if entry["effect_id"] == effect_id {index = i}
    }
    check(index >= 0)
    verify := func(entry, previous) {
        for i in range(0,len(plan["effects"])) {
            if to_json(entry) == to_json(plan["effects"][i]) {
                live := sqlite_effect_observe(host["sink_path"],host["intents"][i]); check(live["ok"])
                item := previous; item["state"] := live["observation"]["observed_state"]; item["evidence_ref"] := live["observation"]["evidence_ref"]
                return item
            }
        }
        return null
    }
    assessment := assess_effect_set(raw,set_raw,plan,host["read_artifact"],verify,parse_int(to_string(floor(now_utc_seconds()))))
    check(assessment["ok"])
    if require_candidate {check(assessment["effects"][index]["next_action"] == "candidate_for_locked_admission")}
    binding := {"subject": plan["subject"], "result_ref": "sha256:" + sha256(raw), "set_ref": "sha256:" + sha256(set_raw), "plan_ref": reference(plan), "effect_id": effect_id, "position": index, "config_revision": policy["config_revision"], "registration_ref": plan["registration_ref"], "environment_ref": host["environment_ref"], "preservation_ref": reference(preserve), "boundary_id": boundary["boundary_id"]}
    check(regex_match(host["environment_ref"], "^sha256:[0-9a-f]{64}$"))
    return {"binding": binding, "host": host, "assessment": assessment}
}
func save(state, continuation, kind) {
    state["effect_continuation"] := continuation
    state["required_features"] := [assurance_feature(state["assurance_negotiation"]), "effect-continuation/v1alpha1"]
    logged := append_control_event(state,kind,continuation["selection"]["binding"]["subject"]["step_id"],[],{"continuation":continuation})
    state = logged["run_state"]
    request := state["human_intervention"]; request["state_revision"] := state["revision"] + 1; state["human_intervention"] := request
    state = persist_run_state(state)
    check(sync_directory_beneath(state["run_dir"],"."))
    return state
}
func fresh(output_root, run_id) {loaded := load_run_state(output_root,run_id); check(loaded["ok"]); return loaded["run_state"]}
func retain(root, raw) {
    path := "effect-artifacts/" + sha256(raw) + ".json"
    if file_exists(root + "/" + path) {check(read_file_beneath(root,path,1048576) == raw)}
    else {check(write_file_atomic_beneath(root,path,raw,false))}
}
func immutable_selection(state, selection) {
    raw := portable_json(selection)
    check(read_file_beneath(state["run_dir"],"effect-attempts/" + selection["attempt_id"] + ".json",8192) == raw)
    set_ref := selection["binding"]["set_ref"]
    sidecar := parse_json(read_file_beneath(state["run_dir"],"effect-artifacts/" + substring(set_ref,7,71) + ".json",8192))
    for ref in sidecar["observations"] {if ref != null {check("sha256:" + sha256(read_file_beneath(state["run_dir"],"effect-artifacts/" + substring(ref,7,71) + ".json",8192)) == ref)}}
    for field in ["plan_ref","result_ref","set_ref"] {
        ref := selection["binding"][field]
        check("sha256:" + sha256(read_file_beneath(state["run_dir"],"effect-artifacts/" + substring(ref,7,71) + ".json",1048576)) == ref)
    }
}

# The operator chooses an ID, never a position/remainder. A surviving selected
# attempt can be resumed only through admit_effect; selection is never replaced.
export func select_effect(output_root, run_id, effect_id, options) {
    loaded := load_run_state(output_root,run_id); if loaded["ok"] == false {return loaded}
    lock := acquire_run_lock(loaded["run_state"]); if lock["ok"] == false {return lock}
    answer := denied()
    try {
        state := fresh(output_root,run_id)
        check(dict_get_or(state,"effect_continuation",null) == null)
        facts := current(state,options,effect_id,true)
        notify(options,"before_selection")
        # Instrumentation/observation may take time. Recheck after it, under lock.
        reloaded := fresh(output_root,run_id);check(reloaded["revision"] == state["revision"]&&to_json(reloaded["control_journal"]) == to_json(state["control_journal"]))
        latest := current(reloaded,options,effect_id,true); check(to_json(latest["binding"]) == to_json(facts["binding"]))
        selection := {"schema":"dispatch.effect-selection/v1alpha1", "binding":facts["binding"], "prior_revision":state["revision"], "prior_journal":{"sequence":state["control_journal"]["sequence"],"last_sha256":state["control_journal"]["last_sha256"]}}
        selection["attempt_id"] := sha256(portable_json(selection))
        ensure_dir(state["run_dir"] + "/effect-artifacts")
        retained := latest["host"]
        retain(state["run_dir"],retained["result_raw"]);retain(state["run_dir"],retained["set_raw"]);retain(state["run_dir"],portable_json(retained["plan"]))
        for ref in parse_json(retained["set_raw"])["observations"] {if ref != null {retain(state["run_dir"],retained["read_artifact"](ref))}}
        check(sync_directory_beneath(state["run_dir"],"effect-artifacts"))
        ensure_dir(state["run_dir"] + "/effect-attempts");check(sync_directory_beneath(state["run_dir"],"."))
        check(write_file_atomic_beneath(state["run_dir"],"effect-attempts/" + selection["attempt_id"] + ".json",portable_json(selection),false))
        check(sync_directory_beneath(state["run_dir"],"effect-attempts"))
        state = save(state,{"selection":selection,"status":"selected","observation":null},"effect_selected")
        notify(options,"after_selection")
        answer = {"ok":true,"attempt_id":selection["attempt_id"],"parent_replay":"prohibited"}
    } except err {answer = denied()}
    release_run_lock(lock);return answer
}

export func admit_effect(output_root, run_id, attempt_id, options) {
    loaded := load_run_state(output_root,run_id);if loaded["ok"] == false {return loaded}
    lock := acquire_run_lock(loaded["run_state"]);if lock["ok"] == false {return lock}
    answer := denied()
    try {
        state := fresh(output_root,run_id); continuation := state["effect_continuation"];selection := continuation["selection"]
        check(selection["attempt_id"] == attempt_id&&continuation["status"] == "selected")
        immutable_selection(state,selection)
        check(state["revision"] == selection["prior_revision"] + 1)
        check(state["control_journal"]["sequence"] == selection["prior_journal"]["sequence"] + 1)
        facts := current(state,options,selection["binding"]["effect_id"],true)
        check(to_json(facts["binding"]) == to_json(selection["binding"]))
        # Same durable exclusive-create claim used by installed participant hosts:
        # no replace, fsync contents+directory, never reclaim on process death.
        check(write_file_atomic_beneath(state["run_dir"],"effect-attempts/" + attempt_id + ".claim",portable_json(selection),false))
        check(sync_directory_beneath(state["run_dir"],"effect-attempts"))
        continuation["status"] := "admitted"
        state = save(state,continuation,"effect_admitted")
        notify(options,"after_admission")
        admitted_revision := state["revision"]
        revalidate := func() {
            reloaded := fresh(output_root,run_id)
            check(reloaded["revision"] == admitted_revision&&to_json(reloaded["effect_continuation"]) == to_json(continuation))
            check(read_file_beneath(state["run_dir"],"effect-attempts/" + attempt_id + ".claim",8192) == portable_json(selection))
            latest := current(reloaded,options,selection["binding"]["effect_id"],true)
            check(to_json(latest["binding"]) == to_json(selection["binding"]))
            return true
        }
        # The final check also executes after SQLite obtains BEGIN IMMEDIATE,
        # before any INSERT. Waiting for the sink cannot carry stale eligibility.
        host := facts["host"]
        applied := sqlite_effect_apply_checked(host["sink_path"],host["intents"][selection["binding"]["position"]],revalidate)
        check(applied["ok"])
        notify(options,"after_mutation")
        observed := sqlite_effect_observe(host["sink_path"],host["intents"][selection["binding"]["position"]]);check(observed["ok"])
        continuation["status"] := "observed";continuation["observation"] := observed["observation"]
        state = save(state,continuation,"effect_observed")
        notify(options,"after_observation")
        answer = {"ok":true,"attempt_id":attempt_id,"observation":observed["observation"],"parent_replay":"prohibited"}
    } except err {answer = denied()}
    release_run_lock(lock);return answer
}

# Lost acknowledgement is inspection only. Even a proved absent effect never
# clears the consumed claim or manufactures another attempt.
export func inspect_effect(output_root, run_id, options) {
    loaded := load_run_state(output_root,run_id);if loaded["ok"] == false {return loaded}
    lock := acquire_run_lock(loaded["run_state"]);if lock["ok"] == false {return lock}
    answer := denied()
    try {
        state := fresh(output_root,run_id);continuation := state["effect_continuation"];selection := continuation["selection"]
        immutable_selection(state,selection)
        facts := current(state,options,selection["binding"]["effect_id"],false)
        check(to_json(facts["binding"]) == to_json(selection["binding"]))
        host := facts["host"];observed := sqlite_effect_observe(host["sink_path"],host["intents"][selection["binding"]["position"]]);check(observed["ok"])
        if continuation["status"] == "admitted" {continuation["status"] := "observed";continuation["observation"] := observed["observation"];state = save(state,continuation,"effect_observed")}
        answer = {"ok":true,"continuation":continuation,"current_observation":observed["observation"],"assessment":facts["assessment"],"parent_replay":"prohibited"}
    } except err {answer = denied()}
    release_run_lock(lock);return answer
}
