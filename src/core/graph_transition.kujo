# Pure graph-local projections. No participant callback, execution or scheduler.
from src.core.utils import dict_get_or
from src.core.portable_commitments import portable_json
func demand(ok, reason) {if ok != true {throw(reason)}}
export func heterogeneous_graph(state) {return dict_get_or(dict_get_or(dict_get_or(state, "workflow_definition", {}), "metadata", {}), "graph_outcome", "") == "dispatch.graph-outcome/v1alpha1"}
export func graph_contract(step) {return dict_get_or(step["config"], "terminal_contract", "parent-finalization/v1alpha1")}
export func graph_event(kind) {return contains(["graph_node_bound", "graph_review_requested", "graph_finalized"], kind)}
export func graph_refs(state, refs) {
    for ref in refs {
        demand(type(ref) == "string"&&regex_match(ref, "^sha256:[0-9a-f]{64}$"), "graph_reference_invalid")
        raw := read_file_beneath(state["run_dir"], "node-input/" + substring(ref, 7, 71) + ".raw", 1048576)
        demand("sha256:" + sha256(raw) == ref, "graph_artifact_corrupt")
    }
    return true
}
export func apply_graph_transition(state, kind, data) {
    demand(heterogeneous_graph(state)&&has_key(state, "graph_finalization") == 0, "graph_terminal_or_unsupported")
    id := dict_get_or(data, "node_id", "")
    if kind == "graph_node_bound" {
        bindings := dict_get_or(state, "graph_node_bindings", {})
        demand(has_key(bindings, id) == 0&&data["graph"]["run_id"] == state["run_id"]&&data["graph"]["workflow_ref"] == "sha256:" + sha256(to_json(state["workflow_definition"])), "graph_binding_conflict")
        matched := false
        for step in state["steps"] {if step["id"] == id {demand(graph_contract(step) != "parent-finalization/v1alpha1"&&step["status"] == "pending", "graph_binding_invalid");matched = true}}
        demand(matched, "node_missing");graph_refs(state, data["artifacts"])
        bindings[id] := data;state["graph_node_bindings"] := bindings;state["status"] := "paused"
    } else if kind == "graph_review_requested" {
        demand(has_key(state["graph_node_bindings"], id)&&has_key(dict_get_or(state, "node_completions", {}), id) == 0, "graph_review_invalid")
        demand(data["binding_ref"] == "sha256:" + sha256(portable_json(state["graph_node_bindings"][id]))&&data["request"]["state_revision"] == state["revision"] + 1, "graph_review_binding_mismatch")
        reviews := dict_get_or(state, "graph_reviews", {});reviews[id] := data;state["graph_reviews"] := reviews;state["status"] := "paused"
    } else if kind == "graph_finalized" {
        candidate := data["candidate"];unsigned := {};for key in keys(candidate) {if key != "candidate_id" {unsigned[key] := candidate[key]}}
        demand(candidate["candidate_id"] == sha256(portable_json(unsigned))&&candidate["graph"]["run_id"] == state["run_id"]&&candidate["graph"]["workflow_ref"] == "sha256:" + sha256(to_json(state["workflow_definition"])), "graph_candidate_invalid")
        demand(candidate["revision"] == state["revision"]&&data["resulting_revision"] == state["revision"] + 1&&contains(["completed", "failed", "cancelled"], candidate["outcome"]), "graph_candidate_stale")
        graph_refs(state, data["artifacts"]);state["graph_finalization"] := data;state["status"] := candidate["outcome"];state["finished_at"] := data["decided_at"]
    } else {throw("graph_transition_unsupported")}
    return state
}
export func graph_history_projection(state, events) {
    bindings := {};reviews := {};finalized := null
    for event in events {
        kind := event["kind"]
        if graph_event(kind) {
            demand(finalized == null, "graph_event_after_terminal")
            data := event["details"]["data"]
            if kind == "graph_node_bound" {demand(has_key(bindings, data["node_id"]) == 0, "duplicate_graph_binding");bindings[data["node_id"]] := data;graph_refs(state, data["artifacts"])}
            if kind == "graph_review_requested" {reviews[data["node_id"]] := data}
            if kind == "graph_finalized" {finalized = data;graph_refs(state, data["artifacts"])}
        }
        if finalized != null&&contains(["node_terminal_observed", "node_start_requested"], kind) {throw("node_event_after_graph_terminal")}
    }
    demand(to_json(bindings) == to_json(dict_get_or(state, "graph_node_bindings", {}))&&to_json(reviews) == to_json(dict_get_or(state, "graph_reviews", {}))&&to_json(finalized) == to_json(dict_get_or(state, "graph_finalization", null)), "graph_journal_state_mismatch")
    if finalized != null {demand(state["status"] == finalized["candidate"]["outcome"], "graph_terminal_state_mismatch")}
    else if heterogeneous_graph(state) {demand(contains(["running", "paused", "interrupted", "needs_changes"], state["status"]), "graph_terminal_authority_missing")}
    return true
}
