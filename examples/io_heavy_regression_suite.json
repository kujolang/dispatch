{
  "name": "io-heavy-regression-suite",
  "description": "Fixture-heavy suite to detect I/O and artifact-generation runtime drift.",
  "version": "1.0.0",
  "history_retention_runs": 50,
  "artifact_checksums": true,
  "tests": [
    {
      "name": "repo manifest exists",
      "check": "file_exists",
      "params": {
        "path": "kennel.toml"
      }
    },
    {
      "name": "cli entrypoint exists",
      "check": "file_exists",
      "params": {
        "path": "main.kujo"
      }
    },
    {
      "name": "core checks module exists",
      "check": "file_exists",
      "params": {
        "path": "src/checks.kujo"
      }
    },
    {
      "name": "eval core module exists",
      "check": "file_exists",
      "params": {
        "path": "src/eval_core.kujo"
      }
    },
    {
      "name": "report module exists",
      "check": "file_exists",
      "params": {
        "path": "src/report.kujo"
      }
    },
    {
      "name": "architecture doc exists",
      "check": "file_exists",
      "params": {
        "path": "docs/ARCHITECTURE.md"
      }
    },
    {
      "name": "readme exists",
      "check": "file_exists",
      "params": {
        "path": "README.md"
      }
    },
    {
      "name": "schema exists",
      "check": "file_exists",
      "params": {
        "path": "schema/eval-suite.schema.json"
      }
    },
    {
      "name": "readme contains watchdog section",
      "check": "file_contains",
      "params": {
        "path": "README.md",
        "expected": "Operational Watchdog Controls"
      }
    },
    {
      "name": "architecture contains run lifecycle",
      "check": "file_contains",
      "params": {
        "path": "docs/ARCHITECTURE.md",
        "expected": "Run Lifecycle"
      }
    },
    {
      "name": "checks include dispatcher",
      "check": "file_contains",
      "params": {
        "path": "src/checks.kujo",
        "expected": "Check dispatcher"
      }
    },
    {
      "name": "eval core includes run suite export",
      "check": "file_contains",
      "params": {
        "path": "src/eval_core.kujo",
        "expected": "export func run_suite"
      }
    },
    {
      "name": "report module includes markdown generation",
      "check": "file_contains",
      "params": {
        "path": "src/report.kujo",
        "expected": "save_report"
      }
    },
    {
      "name": "src directory has Kujo modules",
      "check": "directory_contains",
      "params": {
        "dir": "src",
        "pattern": ".kujo",
        "min_files": 6
      }
    },
    {
      "name": "examples directory has json fixtures",
      "check": "directory_contains",
      "params": {
        "dir": "examples",
        "pattern": ".json",
        "min_files": 8
      }
    },
    {
      "name": "docs directory has markdown docs",
      "check": "directory_contains",
      "params": {
        "dir": "docs",
        "pattern": ".md",
        "min_files": 5
      }
    },
    {
      "name": "release gate suite has required keys",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/release_gate_suite.json",
        "required_keys": ["name", "tests"]
      }
    },
    {
      "name": "enterprise api gate has required keys",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/enterprise_api_contract_gate.json",
        "required_keys": ["name", "tests"]
      }
    },
    {
      "name": "io heavy fixture has required keys",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/io_heavy_regression_suite.json",
        "required_keys": ["name", "tests"]
      }
    },
    {
      "name": "readme has substantial size",
      "check": "file_size_greater_than",
      "params": {
        "path": "README.md",
        "bytes": 8000
      }
    },
    {
      "name": "checks module is non-trivial size",
      "check": "file_size_greater_than",
      "params": {
        "path": "src/checks.kujo",
        "bytes": 2000
      }
    },
    {
      "name": "architecture mentions artifacts",
      "check": "file_matches_regex",
      "params": {
        "path": "docs/ARCHITECTURE.md",
        "pattern": "Artifact"
      }
    },
    {
      "name": "schema references draft-07",
      "check": "file_matches_glob",
      "params": {
        "path": "schema/eval-suite.schema.json",
        "pattern": "draft-07"
      }
    },
    {
      "name": "command output includes marker",
      "check": "output_contains",
      "params": {
        "command": "echo io-heavy-suite-ok",
        "expected": "io-heavy-suite-ok"
      }
    },
    {
      "name": "command stdout json field equals expected",
      "check": "command_stdout_json_path_equals",
      "params": {
        "command": "echo '{\"status\":\"ok\",\"kind\":\"io-heavy\"}'",
        "json_path": "kind",
        "expected": "io-heavy"
      }
    }
  ]
}
