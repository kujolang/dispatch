{
  "name": "enterprise-agent-output-gate",
  "description": "Policy-first agent output gate quickstart bundle for deterministic local validation.",
  "version": "1.0.0",
  "policy_profile": "release-gate",
  "parallel_workers": 8,
  "output_dir": "./eval_results",
  "snapshot_dir": "./snapshots",
  "stop_on_failure": false,
  "tests": [
    {
      "name": "Agent output fixture exists",
      "check": "file_exists",
      "params": {
        "path": "examples/fixtures/agent_output_result.json"
      }
    },
    {
      "name": "Agent output shape is valid",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "required_keys": ["answer", "confidence", "sources", "metadata"]
      }
    },
    {
      "name": "Agent confidence is high",
      "check": "json_value_equals",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "json_path": "confidence",
        "expected": "high"
      }
    },
    {
      "name": "Agent output references Kujo Eval",
      "check": "file_contains",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "expected": "Kujo Eval"
      }
    },
    {
      "name": "Agent output does not include error flag",
      "check": "file_does_not_contain",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "expected": "\"error\":true"
      }
    },
    {
      "name": "Agent validation command stays under budget",
      "check": "command_timing_less_than",
      "params": {
        "command": "echo done",
        "max_ms": 2000
      }
    }
  ]
}
