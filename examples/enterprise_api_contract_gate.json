{
  "name": "enterprise-api-contract-gate",
  "description": "Policy-first API contract gate quickstart bundle backed by deterministic local fixtures.",
  "version": "1.0.0",
  "policy_profile": "release-gate",
  "parallel_workers": 8,
  "output_dir": "./eval_results",
  "snapshot_dir": "./snapshots",
  "stop_on_failure": false,
  "tests": [
    {
      "name": "API fixture exists",
      "check": "file_exists",
      "params": {
        "path": "examples/fixtures/api_contract_response.json"
      }
    },
    {
      "name": "API fixture contains expected top-level keys",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/fixtures/api_contract_response.json",
        "required_keys": ["status", "version", "data"]
      }
    },
    {
      "name": "API status is ok",
      "check": "json_value_equals",
      "params": {
        "path": "examples/fixtures/api_contract_response.json",
        "json_path": "status",
        "expected": "ok"
      }
    },
    {
      "name": "API build stamp matches expected value",
      "check": "json_value_equals",
      "params": {
        "path": "examples/fixtures/api_contract_response.json",
        "json_path": "data.build",
        "expected": "2026.05"
      }
    },
    {
      "name": "API fixture does not include fatal error marker",
      "check": "file_does_not_contain",
      "params": {
        "path": "examples/fixtures/api_contract_response.json",
        "expected": "\"error\":true"
      }
    }
  ]
}
