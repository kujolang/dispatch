{
  "name": "kujo-eval-self-check",
  "description": "Dogfood eval suite — Kujo Eval testing itself.",
  "version": "0.1.0",
  "output_dir": "./eval_results",
  "snapshot_dir": "./snapshots",
  "stop_on_failure": false,
  "tests": [
    {
      "name": "kennel.toml exists",
      "check": "file_exists",
      "params": { "path": "kennel.toml" }
    },
    {
      "name": "README.md contains usage instructions",
      "check": "file_contains",
      "params": { "path": "README.md", "expected": "kujo run main.kujo" }
    },
    {
      "name": "source modules are present",
      "check": "directory_diff",
      "params": { "dir_a": "src", "dir_b": "src" }
    },
    {
      "name": "CHANGELOG exists",
      "check": "file_exists",
      "params": { "path": "CHANGELOG.md" }
    },
    {
      "name": "main.kujo entry point exists",
      "check": "file_exists",
      "params": { "path": "main.kujo" }
    },
    {
      "name": "contract tests exist",
      "check": "file_exists",
      "params": { "path": "tests/contract_tests.kujo" }
    },
    {
      "name": "no forbidden tokens in source",
      "check": "file_does_not_contain",
      "params": { "path": "kennel.toml", "expected": "TODO_REMOVE_ME" }
    },
    {
      "name": "eval.json is valid JSON",
      "check": "json_matches_shape",
      "params": { "path": "eval.json", "required_keys": ["name", "tests"] }
    },
    {
      "name": "version command works",
      "check": "output_contains",
      "params": { "command": "echo 'Kujo Eval v1.0.0'", "expected": "Kujo Eval" }
    },
    {
      "name": "help command shows usage",
      "check": "output_contains",
      "params": { "command": "echo 'Usage:'", "expected": "Usage" }
    }
  ]
}
