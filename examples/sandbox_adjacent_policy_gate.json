{
  "name": "sandbox-adjacent-policy-gate",
  "description": "Constrained local profile that mirrors sandbox-adjacent command/path boundaries.",
  "version": "1.0.0",
  "policy_profile": "local-dev",
  "command_pattern_match_mode": "token",
  "allowed_commands": ["echo", "cat"],
  "allowed_command_patterns": ["echo", "cat"],
  "blocked_arg_patterns": ["--privileged", "rm -rf", "curl |", "wget |", "sudo", "mkfs", "dd if="],
  "allowed_paths": ["./examples/fixtures", "./examples/sandbox_adjacent_policy_gate.json"],
  "allowed_env_vars": ["CI"],
  "redact_output_patterns": ["(?i)token", "(?i)api[_-]?key", "(?i)password", "(?i)secret"],
  "redaction_audit_mode": true,
  "tests": [
    {
      "name": "sandbox echo command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "echo sandbox-adjacent-ok"
      }
    },
    {
      "name": "sandbox fixture cat output contains status",
      "check": "output_contains",
      "params": {
        "command": "cat examples/fixtures/api_contract_response.json",
        "expected": "\"status\""
      }
    },
    {
      "name": "api fixture exists",
      "check": "file_exists",
      "params": {
        "path": "examples/fixtures/api_contract_response.json"
      }
    },
    {
      "name": "agent fixture contains confidence",
      "check": "file_contains",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "expected": "\"confidence\""
      }
    },
    {
      "name": "agent fixture has required keys",
      "check": "json_matches_shape",
      "params": {
        "path": "examples/fixtures/agent_output_result.json",
        "required_keys": ["answer", "confidence", "sources"]
      }
    },
    {
      "name": "sandbox missing fixture command fails",
      "check": "command_fails",
      "params": {
        "command": "cat examples/fixtures/does-not-exist.json"
      }
    }
  ]
}
