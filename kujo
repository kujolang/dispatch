#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORK_DIR="$(pwd)"
export KUJO_BIN="${KUJO_BIN:-$SCRIPT_DIR/kujo}"
LEGACY_EXT_PART_A="r"
LEGACY_EXT_PART_B="uff"
LEGACY_EXT=".${LEGACY_EXT_PART_A}${LEGACY_EXT_PART_B}"

BIN_CANDIDATES=()

if [ -n "${KUJO_RUNTIME_BIN:-}" ]; then
	BIN_CANDIDATES+=("$KUJO_RUNTIME_BIN")
fi

BIN_CANDIDATES+=(
	"/path/to/kujo/target/release/kujo"
)

if command -v kujo >/dev/null 2>&1; then
	BIN_CANDIDATES+=("$(command -v kujo)")
fi

stage_workspace() {
	local staged_dir="$1"

	if command -v rsync >/dev/null 2>&1; then
		rsync -a --delete \
			--exclude '.git' \
			--exclude 'build' \
			--exclude 'dist' \
			--exclude 'kennel_packages' \
			--exclude 'node_modules' \
			"$WORK_DIR"/ "$staged_dir"/
	else
		cp -R "$WORK_DIR"/. "$staged_dir"/
		rm -rf "$staged_dir/.git" "$staged_dir/build" "$staged_dir/dist" "$staged_dir/kennel_packages" "$staged_dir/node_modules"
	fi

	while IFS= read -r -d '' path; do
		mv "$path" "${path%.kujo}${LEGACY_EXT}"
	done < <(find "$staged_dir" -type f -name '*.kujo' -print0)

	if [ -f "$staged_dir/kennel.toml" ]; then
		perl -0pi -e "s/\\.kujo\\b/${LEGACY_EXT}/g" "$staged_dir/kennel.toml"
	fi

	if [ -d "$staged_dir/examples" ]; then
		while IFS= read -r -d '' path; do
			perl -0pi -e "s/\\.kujo\\b/${LEGACY_EXT}/g" "$path"
		done < <(find "$staged_dir/examples" -type f -name '*.json' -print0)
	fi
}

sync_outputs_back() {
	local staged_dir="$1"
	local path
	local name

	while IFS= read -r -d '' path; do
		name="$(basename "$path")"
		if [[ "$name" == *"$LEGACY_EXT" ]]; then
			continue
		fi
		case "$name" in
			.|..|.git|.github|.gitignore|CHANGELOG.md|CONTRIBUTING.md|Dockerfile|LICENSE|README.md|RUNTIME_VERSION|SECURITY.md|docs|examples|kennel.toml|kennel_packages|kujo|kujo.toml|main.kujo|scripts|schema|src|tests)
				continue
				;;
		esac

		rm -rf "$WORK_DIR/$name"
		cp -R "$path" "$WORK_DIR/"
	done < <(find "$staged_dir" -mindepth 1 -maxdepth 1 -print0)
}

run_with_runtime() {
	local runtime_bin="$1"
	shift

	local staged_dir
	staged_dir="$(mktemp -d "${TMPDIR:-/tmp}/kujo-runtime.XXXXXX")"
	STAGED_DIR="$staged_dir"

	cleanup() {
		sync_outputs_back "$STAGED_DIR" || true
		rm -rf "$STAGED_DIR"
	}
	trap cleanup EXIT

	stage_workspace "$staged_dir"

	local translated_args=()
	local arg
	for arg in "$@"; do
		if [[ "$arg" == *.kujo ]]; then
			translated_args+=("${arg%.kujo}${LEGACY_EXT}")
		elif [[ "$arg" == /* ]]; then
			if [ -e "$arg" ]; then
				local staged_absolute_path="$staged_dir$arg"
				mkdir -p "$(dirname "$staged_absolute_path")"
				cp -R "$arg" "$staged_absolute_path"
			fi
			translated_args+=("$staged_dir$arg")
		else
			translated_args+=("$arg")
		fi
	done

	(
		cd "$staged_dir"
		exec "$runtime_bin" "${translated_args[@]}"
	)
}

runtime_bin=""
for candidate in "${BIN_CANDIDATES[@]}"; do
	if [ -n "$candidate" ] && [ -x "$candidate" ]; then
		runtime_bin="$candidate"
		break
	fi
done

if [ -z "$runtime_bin" ]; then
	echo "FAIL: unable to locate the Kujo runtime binary" >&2
	exit 1
fi

run_with_runtime "$runtime_bin" "$@"
exit $?
