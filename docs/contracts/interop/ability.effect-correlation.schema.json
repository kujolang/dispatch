{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ability.effect-correlation/v1alpha1",
  "type": "object",
  "required": [
    "schema",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ability.effect-correlation/v1alpha1"
    },
    "values": {
      "type": "object",
      "required": [
        "ability_id",
        "ability_version",
        "ability_invocation_id",
        "definition_digest",
        "receipt_id",
        "receipt_ref",
        "transaction_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "ability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "ability_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "ability_invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  }
}
